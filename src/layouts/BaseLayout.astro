---
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import LoginModal from '../components/common/LoginModal.astro';
import { getCurrentUser } from '../lib/auth';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Nodo — Eventos y cartelera comunitaria',
  description = 'Descubre y publica eventos locales en Nodo, la cartelera comunitaria minimalista.',
  image,
  type = 'website',
} = Astro.props;

// Solo hace falta saber si hay sesion, no quien es: getCurrentUser verifica
// la cookie y ya esta, sin leer el perfil de Firestore como getDisplayUser.
// El dato viaja en el body porque la cookie es httpOnly y el navegador no
// puede consultarla por su cuenta.
const haySesion = (await getCurrentUser(Astro.cookies)) !== null;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(image || '/logo-icon.png', siteOrigin).toString();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!--
      Va aqui, en linea y antes de cualquier estilo, a proposito: si el tema se
      aplicara despues de pintar, quien tenga el modo oscuro veria un destello
      blanco en cada carga. Por eso es un script sincrono y no un modulo.
    -->
    <script is:inline>
      (function () {
        try {
          // Sin eleccion guardada el tema es CLARO, no el del sistema: el
          // fondo blanco es el predeterminado del producto. Seguir al
          // dispositivo solo ocurre si se elige "sistema" a proposito.
          var guardado = localStorage.getItem('nodo-tema');
          var tema = 'claro';
          if (guardado === 'oscuro') tema = 'oscuro';
          else if (guardado === 'sistema') {
            tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro';
          }
          document.documentElement.dataset.theme = tema;
        } catch (e) {
          document.documentElement.dataset.theme = 'claro';
        }
      })();
    </script>
    <!--
      Meetup usa NeuSans, que es propietaria y no se puede incrustar aqui. Su
      propia hoja de estilos declara Inter como respaldo (NeuSans, Inter,
      system-ui), asi que es la mas fiel de las libres: misma familia grotesca,
      mismo comportamiento a pesos altos con tracking negativo.

      preconnect va aparte y con crossorigin porque los ficheros salen de
      gstatic, un origen distinto al de la hoja: sin las dos lineas el
      navegador descubre el segundo dominio cuando ya ha parseado el CSS.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body
    class="flex min-h-screen flex-col bg-fondo text-texto antialiased"
    data-sesion={haySesion ? 'activa' : 'inactiva'}
  >
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <LoginModal />

    {!haySesion && (
      <script>
        import { loginWithGoogleCredential } from '../lib/firebase/client';

        const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;

        // Sin Client ID configurado (entornos de prueba, PR previews) el
        // anuncio simplemente no aparece, igual que Instagram u otras
        // integraciones opcionales del sitio.
        if (clientId) {
          const script = document.createElement('script');
          script.src = 'https://accounts.google.com/gsi/client';
          script.async = true;
          script.defer = true;
          script.onload = () => {
            window.google?.accounts.id.initialize({
              client_id: clientId,
              callback: (response) => {
                loginWithGoogleCredential(response.credential).catch((error) => {
                  console.error('No se pudo iniciar sesión con Google One Tap:', error);
                });
              },
              // Chrome exige FedCM para el One Tap desde 2024; sin esto el
              // aviso deja de mostrarse silenciosamente en vez de fallar.
              use_fedcm_for_prompt: true,
            });
            window.google?.accounts.id.prompt();
          };
          document.head.appendChild(script);
        }
      </script>
    )}
  </body>
</html>
