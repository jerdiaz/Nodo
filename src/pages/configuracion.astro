---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getCurrentUser } from '../lib/auth';
import ImageCropper from '../components/ui/ImageCropper.astro';
import { getUserProfile } from '../lib/firebase/users';
import { SOCIAL_FIELDS } from '../types/profile';
import { Rss, TriangleAlert } from '@lucide/astro';
import { getEvents } from '../lib/firebase/events';
import type { UserProfile } from '../types/profile';

const user = await getCurrentUser(Astro.cookies);

if (!user) {
  return Astro.redirect('/?login=required');
}

let profile: UserProfile | null = null;

try {
  profile = await getUserProfile(user.uid);
} catch (error) {
  console.warn('No se pudo obtener el perfil desde Firebase:', error);
}

// Quien nunca ha guardado el formulario no tiene documento en `users`: se
// parte del nombre que trae el token de Firebase Auth para que los campos no
// aparezcan vacios la primera vez.
const [authFirst = '', ...authRest] = user.name.split(' ');
const firstName = profile?.firstName || authFirst;
const lastName = profile?.lastName ?? authRest.join(' ');
const avatarUrl = profile?.avatarUrl ?? user.avatarUrl ?? '';

// Cuantos eventos propios seguirian vivos si borrara la cuenta: es el dato
// que decide si la transferencia tiene sentido o no.
let upcomingOwn: { id: string }[] = [];

try {
  const allEvents = await getEvents();
  const now = Date.now();
  upcomingOwn = allEvents.filter(
    (event) => event.organizer.uid === user.uid && event.endDate.getTime() >= now,
  );
} catch (error) {
  console.warn('No se pudieron contar los eventos propios:', error);
}

const calendarUrl = profile?.calendarToken
  ? new URL(`/api/calendario/${profile.calendarToken}.ics`, Astro.url.origin).toString()
  : '';

const inputClass =
  'mt-1.5 w-full rounded-xl bg-superficie px-3.5 py-2.5 text-sm text-texto placeholder:text-tenue ring-1 ring-inset ring-linea focus-visible:outline-none focus:ring-2 focus:ring-acento';
---

<BaseLayout title="Configuración — Nodo" description="Ajusta tu perfil en Nodo.">
  <div class="mx-auto max-w-3xl px-6 pb-24 pt-16">
    <h1 class="text-3xl font-bold tracking-tight text-texto">Configuración</h1>

    <div class="mt-6 border-b border-linea">
      <div class="flex gap-6" role="tablist">
        <button
          type="button"
          role="tab"
          data-tab="cuenta"
          aria-selected="true"
          class="tab border-b-2 pb-3 text-sm font-medium transition"
        >
          Cuenta
        </button>
        <button
          type="button"
          role="tab"
          data-tab="preferencias"
          aria-selected="false"
          class="tab border-b-2 pb-3 text-sm font-medium transition"
        >
          Preferencias
        </button>
      </div>
    </div>

    <section id="panel-preferencias" class="mt-10 hidden">
      <h2 class="text-lg font-semibold text-texto">Apariencia</h2>
      <p class="mt-2 text-sm text-suave">Cómo se ve Nodo en este dispositivo.</p>

      <fieldset class="mt-5 space-y-2">
        <legend class="sr-only">Tema</legend>
        {[
          { valor: 'claro', titulo: 'Claro', detalle: 'Fondo blanco. Es lo predeterminado.' },
          { valor: 'oscuro', titulo: 'Oscuro', detalle: 'Fondo oscuro, para leer de noche.' },
          { valor: 'sistema', titulo: 'Según el sistema', detalle: 'Sigue la preferencia de tu dispositivo.' },
        ].map((opcion) => (
          <label class="flex cursor-pointer gap-3 rounded-2xl border border-linea p-4 transition hover:border-acento">
            <input type="radio" name="tema" value={opcion.valor} class="mt-1 accent-acento" />
            <span>
              <span class="block text-sm font-medium text-texto">{opcion.titulo}</span>
              <span class="mt-0.5 block text-sm text-suave">{opcion.detalle}</span>
            </span>
          </label>
        ))}
      </fieldset>

      <p class="mt-4 text-xs text-tenue">
        La preferencia se guarda en este navegador. Todavía no viaja contigo a otros dispositivos.
      </p>
    </section>

    <div id="panel-cuenta">
    <form id="profile-form" novalidate class="mt-10">
      <h2 class="text-lg font-semibold text-texto">Tu perfil</h2>

      <div class="mt-6 grid gap-8 sm:grid-cols-[1fr_auto]">
        <div class="space-y-5">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="firstName" class="block text-sm font-medium text-texto">Nombre</label>
              <input
                id="firstName"
                name="firstName"
                type="text"
                required
                maxlength="60"
                class={inputClass}
                value={firstName}
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-texto">Apellido</label>
              <input
                id="lastName"
                name="lastName"
                type="text"
                maxlength="60"
                class={inputClass}
                value={lastName}
              />
            </div>
          </div>

          <div>
            <label for="username" class="block text-sm font-medium text-texto">Nombre de usuario</label>
            <div class="mt-1.5 flex overflow-hidden rounded-xl ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento">
              <span class="flex items-center bg-fondo-alt px-3.5 text-sm text-suave">@</span>
              <input
                id="username"
                name="username"
                type="text"
                maxlength="30"
                autocomplete="off"
                placeholder="tunombre"
                class="w-full bg-superficie px-3.5 py-2.5 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
                value={profile?.username ?? ''}
              />
            </div>
          </div>

          <div>
            <label for="bio" class="block text-sm font-medium text-texto">Biografía</label>
            <textarea
              id="bio"
              name="bio"
              rows="3"
              maxlength="280"
              class={inputClass}
              placeholder="Comparte un poco sobre tu experiencia e intereses."
            >{profile?.bio ?? ''}</textarea>
            <p class="mt-1 text-xs text-tenue"><span id="bio-count">0</span>/280</p>
          </div>
        </div>

        <div class="sm:w-40">
          <ImageCropper
            id="avatarUrl"
            name="avatarUrl"
            kind="avatar"
            label="Foto de perfil"
            value={avatarUrl}
            fallback={firstName.charAt(0).toUpperCase()}
            hint="Arrastra una imagen aquí o haz clic. JPG, PNG o WEBP."
          />
        </div>
      </div>

      <div class="mt-8">
        <span class="block text-sm font-medium text-texto">Enlaces sociales</span>
        <div class="mt-2 grid gap-3 sm:grid-cols-2">
          {SOCIAL_FIELDS.map((field) => (
            <div class="flex overflow-hidden rounded-xl ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento">
              <span class="flex shrink-0 items-center bg-fondo-alt px-3 text-xs text-suave">
                {field.prefix}
              </span>
              <input
                type="text"
                name={`social-${field.key}`}
                maxlength="60"
                autocomplete="off"
                aria-label={field.label}
                placeholder="nombre de usuario"
                class="w-full min-w-0 bg-superficie px-3 py-2.5 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
                value={profile?.socials?.[field.key] ?? ''}
              />
            </div>
          ))}

          <div class="flex overflow-hidden rounded-xl ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento">
            <span class="flex shrink-0 items-center bg-fondo-alt px-3 text-xs text-suave">Web</span>
            <input
              type="text"
              name="social-website"
              maxlength="200"
              autocomplete="off"
              aria-label="Sitio web"
              placeholder="tu sitio web"
              class="w-full min-w-0 bg-superficie px-3 py-2.5 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
              value={profile?.socials?.website ?? ''}
            />
          </div>
        </div>
      </div>

      <p id="form-error" class="mt-6 hidden text-sm text-acento-texto"></p>
      <p id="form-success" class="mt-6 hidden text-sm text-acento-texto"></p>

      <div class="mt-8 border-t border-linea pt-6">
        <Button variant="primary" type="submit" id="submit-button">Guardar cambios</Button>
      </div>
    </form>

    <section class="mt-14 border-t border-linea pt-10">
      <h2 class="text-lg font-semibold text-texto">Sincronización de cuenta</h2>

      <div class="mt-4 rounded-2xl border border-linea bg-superficie p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex min-w-0 gap-3">
            <Rss class="mt-0.5 size-4 shrink-0 text-suave" stroke-width={1.75} />
            <div class="min-w-0">
              <p class="font-medium text-texto">Sincronización de calendario</p>
              <p class="mt-1 text-sm text-suave">
                Suscribe tus eventos de Nodo a Google Calendar, Outlook o Apple. Se actualiza solo.
              </p>
            </div>
          </div>

          <button
            id="ical-button"
            type="button"
            class="shrink-0 rounded-full border border-linea bg-superficie px-4 py-2 text-sm font-medium text-texto transition active:scale-[0.97] hover:border-acento disabled:cursor-not-allowed disabled:opacity-60"
          >
            {calendarUrl ? 'Regenerar enlace' : 'Agregar suscripción a iCal'}
          </button>
        </div>

        <div id="ical-result" class:list={['mt-4', !calendarUrl && 'hidden']}>
          <label for="ical-url" class="text-xs font-medium uppercase tracking-wide text-suave">
            Tu enlace de suscripción
          </label>
          <div class="mt-1.5 flex gap-2">
            <input
              id="ical-url"
              type="text"
              readonly
              value={calendarUrl}
              class="w-full min-w-0 rounded-xl bg-fondo-alt px-3 py-2 font-mono text-xs text-texto ring-1 ring-inset ring-linea focus-visible:outline-none"
            />
            <button
              id="ical-copy"
              type="button"
              class="shrink-0 rounded-xl border border-linea bg-superficie px-3 py-2 text-xs font-medium text-texto transition active:scale-[0.97] hover:border-acento"
            >
              Copiar
            </button>
          </div>
          <p class="mt-2 text-xs text-tenue">
            Quien tenga este enlace puede ver tu agenda. Si se te escapa, regenéralo: el anterior deja de
            funcionar.
          </p>
        </div>

        <p id="ical-error" class="mt-3 hidden text-sm text-acento-texto"></p>
      </div>
    </section>

    <section class="mt-14 border-t border-linea pt-10">
      <h2 class="text-lg font-semibold text-texto">Eliminar cuenta</h2>
      <p class="mt-2 text-sm text-suave">
        Si ya no quieres usar Nodo, puedes eliminar tu cuenta de forma permanente. No se puede deshacer.
      </p>

      <button
        id="delete-open"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-full border-2 border-acento px-4 py-2 text-sm font-medium text-acento-texto transition active:scale-[0.97] hover:bg-acento-suave"
      >
        <TriangleAlert class="size-4" stroke-width={2} />
        Eliminar mi cuenta
      </button>

      <div
        id="delete-panel"
        class="mt-4 hidden rounded-2xl border border-acento/30 bg-acento-suave p-5"
        data-upcoming={upcomingOwn.length}
      >
        <p class="text-sm text-texto">
          {upcomingOwn.length === 0
            ? 'No tienes eventos próximos publicados.'
            : `Organizas ${upcomingOwn.length} ${upcomingOwn.length === 1 ? 'evento próximo' : 'eventos próximos'}. Decide qué hacer con ${upcomingOwn.length === 1 ? 'él' : 'ellos'}.`}
        </p>

        <fieldset class="mt-4 space-y-3">
          <legend class="sr-only">Qué hacer con tus eventos</legend>

          <label class="flex cursor-pointer gap-3 text-sm text-texto">
            <input type="radio" name="delete-mode" value="transfer" class="mt-1 accent-acento" checked />
            <span>
              <span class="font-medium text-texto">Transferir mis eventos próximos</span>
              <span class="mt-1 block text-suave">
                Pasan a la cuenta que indiques. Los pasados conservan tu nombre como organizador.
              </span>
              <span class="mt-2 flex overflow-hidden rounded-xl ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento">
                <span class="flex items-center bg-fondo-alt px-3 text-sm text-suave">@</span>
                <input
                  id="transfer-to"
                  type="text"
                  autocomplete="off"
                  placeholder="usuario que los recibe"
                  class="w-full bg-superficie px-3 py-2 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
                />
              </span>
            </span>
          </label>

          <label class="flex cursor-pointer gap-3 text-sm text-texto">
            <input type="radio" name="delete-mode" value="cascade" class="mt-1 accent-acento" />
            <span>
              <span class="font-medium text-texto">Borrar todos mis eventos</span>
              <span class="mt-1 block text-suave">
                Se eliminan todos, pasados y futuros, junto con sus asistencias. Quienes dijeron que asistían
                los perderán.
              </span>
            </span>
          </label>
        </fieldset>

        <div class="mt-5 border-t border-acento/30 pt-5">
          <button
            id="delete-code-button"
            type="button"
            class="rounded-full border border-linea bg-superficie px-4 py-2 text-sm font-medium text-texto transition active:scale-[0.97] hover:border-acento disabled:cursor-not-allowed disabled:opacity-60"
          >
            Generar código de confirmación
          </button>

          <div id="delete-code-box" class="mt-4 hidden">
            <p class="text-sm text-suave">
              Escribe este código para confirmar:
              <strong id="delete-code-value" class="ml-1 font-mono text-base tracking-[0.3em] text-texto"></strong>
            </p>
            <p class="mt-1 text-xs text-tenue">
              Caduca en 10 minutos. Más adelante se enviará a tu correo en vez de mostrarse aquí.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <input
                id="delete-code-input"
                type="text"
                maxlength="6"
                autocomplete="off"
                placeholder="Código"
                class="w-32 rounded-xl bg-fondo-alt px-3 py-2 font-mono text-sm uppercase tracking-widest text-texto placeholder:tracking-normal placeholder:text-tenue ring-1 ring-inset ring-linea focus-visible:outline-none focus:ring-2 focus:ring-acento"
              />
              <button
                id="delete-confirm"
                type="button"
                class="inline-flex items-center gap-2 rounded-full border-2 border-acento px-4 py-2 text-sm font-medium text-acento-texto transition active:scale-[0.97] hover:bg-acento-suave disabled:cursor-not-allowed disabled:opacity-60"
              >
                <TriangleAlert class="size-4" stroke-width={2} />
                Eliminar definitivamente
              </button>
            </div>
          </div>

          <p id="delete-error" class="mt-3 hidden text-sm text-acento-texto"></p>
        </div>
      </div>
    </section>
    </div>
  </div>
</BaseLayout>

<script>

  const form = document.getElementById('profile-form') as HTMLFormElement;
  const avatarUrlInput = document.getElementById('avatarUrl') as HTMLInputElement;
  const bioField = document.getElementById('bio') as HTMLTextAreaElement;
  const bioCount = document.getElementById('bio-count') as HTMLElement;
  const errorBox = document.getElementById('form-error') as HTMLParagraphElement;
  const successBox = document.getElementById('form-success') as HTMLParagraphElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;

  const originalButtonText = submitButton.textContent ?? 'Guardar cambios';

  // --- Pestanas ---
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
  const paneles: Record<string, HTMLElement | null> = {
    cuenta: document.getElementById('panel-cuenta'),
    preferencias: document.getElementById('panel-preferencias'),
  };

  function abrirPestana(nombre: string): void {
    tabs.forEach((t) => {
      const activa = t.dataset.tab === nombre;
      t.setAttribute('aria-selected', String(activa));
      t.classList.toggle('border-acento', activa);
      t.classList.toggle('text-texto', activa);
      t.classList.toggle('border-transparent', !activa);
      t.classList.toggle('text-suave', !activa);
    });
    Object.entries(paneles).forEach(([clave, el]) => el?.classList.toggle('hidden', clave !== nombre));
  }

  tabs.forEach((t) => t.addEventListener('click', () => abrirPestana(t.dataset.tab ?? 'cuenta')));
  abrirPestana('cuenta');

  // --- Tema ---
  // "sistema" no se guarda como tema resuelto sino como ausencia de eleccion:
  // asi sigue a la preferencia del dispositivo si esta cambia mas adelante.
  const radiosTema = [...document.querySelectorAll<HTMLInputElement>('input[name="tema"]')];

  function temaDelSistema(): 'claro' | 'oscuro' {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro';
  }

  function aplicarTema(valor: string): void {
    const resuelto = valor === 'sistema' ? temaDelSistema() : valor;
    document.documentElement.dataset.theme = resuelto;
  }

  let guardado: string | null = null;
  try {
    guardado = localStorage.getItem('nodo-tema');
  } catch {
    guardado = null;
  }

  // Ausencia de valor significa "claro", que es el predeterminado del producto.
  const elegido = guardado === 'oscuro' || guardado === 'sistema' ? guardado : 'claro';
  radiosTema.forEach((r) => {
    r.checked = r.value === elegido;
    r.addEventListener('change', () => {
      if (!r.checked) return;
      try {
        if (r.value === 'claro') localStorage.removeItem('nodo-tema');
        else localStorage.setItem('nodo-tema', r.value);
      } catch {
        // Almacenamiento bloqueado: el cambio vale para esta pagina y ya.
      }
      aplicarTema(r.value);
    });
  });

  // Si esta en "sistema", seguir al dispositivo cuando cambie en caliente.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    let actual: string | null = null;
    try {
      actual = localStorage.getItem('nodo-tema');
    } catch {
      actual = null;
    }
    if (actual === 'sistema') aplicarTema('sistema');
  });

  // El recorte va al servidor, que lo modera antes de guardarlo.
  async function subirImagen(dataUrl: string, kind: 'avatar' | 'banner'): Promise<string> {
    const recorte = await (await fetch(dataUrl)).blob();

    // Cuerpo binario, no FormData: multipart dispara la comprobacion de origen
    // de Astro y responde 403 detras del proxy de produccion.
    const response = await fetch(`/api/imagenes?kind=${kind}`, {
      method: 'POST',
      headers: { 'Content-Type': recorte.type || 'image/jpeg' },
      body: recorte,
    });
    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(result.error ?? 'No se pudo subir la imagen.');
    }

    return result.url as string;
  }


  // --- Suscripcion iCal ---
  const icalButton = document.getElementById('ical-button') as HTMLButtonElement;
  const icalResult = document.getElementById('ical-result') as HTMLElement;
  const icalUrlField = document.getElementById('ical-url') as HTMLInputElement;
  const icalCopy = document.getElementById('ical-copy') as HTMLButtonElement;
  const icalError = document.getElementById('ical-error') as HTMLParagraphElement;

  icalButton.addEventListener('click', async () => {
    // Regenerar rompe el enlace anterior: quien ya lo tuviera suscrito deja de
    // recibir actualizaciones, asi que se avisa antes.
    if (icalUrlField.value && !window.confirm('El enlace actual dejará de funcionar. ¿Continuar?')) {
      return;
    }

    icalButton.disabled = true;
    icalError.classList.add('hidden');

    try {
      // El Content-Type no es por el cuerpo (no lo hay): exime la peticion de
      // la comprobacion CSRF de Astro, que detras del proxy de produccion
      // rechaza con 403 todo POST sin este header. Ver commit 8d5c370.
      const response = await fetch('/api/calendario-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo generar el enlace.');
      }

      icalUrlField.value = `${window.location.origin}/api/calendario/${result.token}.ics`;
      icalResult.classList.remove('hidden');
      icalButton.textContent = 'Regenerar enlace';
    } catch (error) {
      icalError.textContent = error instanceof Error ? error.message : 'No se pudo generar el enlace.';
      icalError.classList.remove('hidden');
    } finally {
      icalButton.disabled = false;
    }
  });

  // --- Eliminar cuenta ---
  const deleteOpen = document.getElementById('delete-open') as HTMLButtonElement;
  const deletePanel = document.getElementById('delete-panel') as HTMLElement;
  const deleteCodeButton = document.getElementById('delete-code-button') as HTMLButtonElement;
  const deleteCodeBox = document.getElementById('delete-code-box') as HTMLElement;
  const deleteCodeValue = document.getElementById('delete-code-value') as HTMLElement;
  const deleteCodeInput = document.getElementById('delete-code-input') as HTMLInputElement;
  const deleteConfirm = document.getElementById('delete-confirm') as HTMLButtonElement;
  const deleteError = document.getElementById('delete-error') as HTMLParagraphElement;
  const transferTo = document.getElementById('transfer-to') as HTMLInputElement;

  function selectedMode(): string {
    const checked = document.querySelector<HTMLInputElement>('input[name="delete-mode"]:checked');
    return checked?.value ?? 'transfer';
  }

  deleteOpen.addEventListener('click', () => {
    deletePanel.classList.toggle('hidden');
  });

  deleteCodeButton.addEventListener('click', async () => {
    deleteCodeButton.disabled = true;
    deleteError.classList.add('hidden');

    try {
      const response = await fetch('/api/cuenta/codigo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo generar el código.');
      }

      deleteCodeValue.textContent = result.code;
      deleteCodeBox.classList.remove('hidden');
      deleteCodeInput.focus();
    } catch (error) {
      deleteError.textContent = error instanceof Error ? error.message : 'No se pudo generar el código.';
      deleteError.classList.remove('hidden');
    } finally {
      deleteCodeButton.disabled = false;
    }
  });

  deleteConfirm.addEventListener('click', async () => {
    deleteError.classList.add('hidden');

    const mode = selectedMode();
    const upcoming = Number(deletePanel.dataset.upcoming ?? '0');

    const aviso =
      mode === 'cascade'
        ? 'Se eliminarán tu cuenta y TODOS tus eventos, con sus asistencias. Esto no se puede deshacer.'
        : `Se eliminará tu cuenta y ${upcoming === 1 ? 'tu evento próximo pasará' : `tus ${upcoming} eventos próximos pasarán`} a @${transferTo.value.trim()}. Esto no se puede deshacer.`;

    if (!window.confirm(aviso)) {
      return;
    }

    deleteConfirm.disabled = true;

    try {
      const response = await fetch('/api/cuenta', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mode,
          code: deleteCodeInput.value.trim(),
          transferTo: mode === 'transfer' ? transferTo.value.trim() : undefined,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo eliminar la cuenta.');
      }

      window.location.href = '/';
    } catch (error) {
      deleteError.textContent = error instanceof Error ? error.message : 'No se pudo eliminar la cuenta.';
      deleteError.classList.remove('hidden');
      deleteConfirm.disabled = false;
    }
  });

  icalCopy.addEventListener('click', async () => {
    const original = icalCopy.textContent;
    try {
      await navigator.clipboard.writeText(icalUrlField.value);
      icalCopy.textContent = '¡Copiado!';
    } catch {
      icalCopy.textContent = 'No se pudo';
    }
    setTimeout(() => {
      icalCopy.textContent = original;
    }, 2000);
  });

  function updateBioCount(): void {
    bioCount.textContent = String(bioField.value.length);
  }

  bioField.addEventListener('input', updateBioCount);
  updateBioCount();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');
    successBox.classList.add('hidden');

    submitButton.disabled = true;

    try {
      let avatarUrl = avatarUrlInput.value;

      // Un recorte nuevo llega como data URL; una foto ya guardada, como la
      // URL de Storage que no hay que volver a subir.
      if (avatarUrl.startsWith('data:')) {
        submitButton.textContent = 'Revisando imagen…';
        avatarUrl = await subirImagen(avatarUrl, 'avatar');
        avatarUrlInput.value = avatarUrl;
      }

      submitButton.textContent = 'Guardando…';

      const data = new FormData(form);
      const socials: Record<string, string> = {};

      for (const [key, value] of data.entries()) {
        if (key.startsWith('social-') && typeof value === 'string' && value.trim()) {
          socials[key.slice('social-'.length)] = value.trim();
        }
      }

      const response = await fetch('/api/perfil', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: data.get('firstName'),
          lastName: data.get('lastName'),
          username: data.get('username'),
          bio: data.get('bio'),
          avatarUrl: avatarUrl || undefined,
          socials,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo guardar el perfil.');
      }

      successBox.textContent = 'Perfil actualizado correctamente.';
      successBox.classList.remove('hidden');
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar el perfil.';
      errorBox.classList.remove('hidden');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = originalButtonText;
    }
  });
</script>
