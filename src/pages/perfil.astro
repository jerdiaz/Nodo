---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import { getAccountCreatedAt, getCurrentUser } from '../lib/auth';
import { getEvents } from '../lib/firebase/events';
import { getAttendedEventIds } from '../lib/firebase/rsvps';
import { getUserProfile } from '../lib/firebase/users';
import { formatEventDate, formatEventTime, formatMonthYear } from '../lib/format';
import SocialIcon from '../components/ui/SocialIcon.astro';
import VerifiedBadge from '../components/ui/VerifiedBadge.astro';
import { SOCIAL_FIELDS } from '../types/profile';
import { CalendarDays } from '@lucide/astro';
import { genColor } from '../lib/genColor';
import type { NodoEvent } from '../types/event';
import type { SocialKey, UserProfile } from '../types/profile';

const user = await getCurrentUser(Astro.cookies);

if (!user) {
  return Astro.redirect(`/?login=required&destino=${encodeURIComponent(Astro.url.pathname)}`);
}

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

// Una sola lectura de eventos y todo lo demás se deriva en memoria, igual que
// hacen el resto de páginas.
const organized = allEvents.filter((event) => event.organizer.uid === user.uid);

let attendedIds = new Set<string>();

try {
  attendedIds = await getAttendedEventIds(
    user.uid,
    allEvents.map((event) => event.id),
  );
} catch (error) {
  console.warn('No se pudo obtener la asistencia del usuario:', error);
}

const attended = allEvents.filter((event) => attendedIds.has(event.id));

// Un evento propio al que además dijiste que asistes no debe listarse dos
// veces, pero sí cuenta en ambas cifras.
const timeline = allEvents.filter(
  (event) => event.organizer.uid === user.uid || attendedIds.has(event.id),
);

const now = Date.now();
const upcoming = timeline.filter((event) => event.endDate.getTime() >= now);
const past = timeline
  .filter((event) => event.endDate.getTime() < now)
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const createdAt = await getAccountCreatedAt(user.uid);

// Los temas salen de las etiquetas de los eventos propios y de aquellos a los
// que se asiste. No es un campo que nadie haya rellenado, asi que la seccion se
// llama por lo que es -temas de tus eventos- y no "intereses", que seria
// atribuirle al perfil una eleccion que nunca hizo.
const temas = [
  ...timeline
    .flatMap((event) => event.tags)
    .reduce((mapa, etiqueta) => {
      const clave = etiqueta.normalize('NFD').replace(/[^\x00-\x7F]/g, '').toLowerCase().trim();
      if (clave && !mapa.has(clave)) mapa.set(clave, etiqueta.trim());
      return mapa;
    }, new Map<string, string>())
    .values(),
].sort((a, b) => a.localeCompare(b, 'es'));

const cifras = [
  { valor: organized.length, etiqueta: organized.length === 1 ? 'Organizado' : 'Organizados' },
  { valor: upcoming.length, etiqueta: upcoming.length === 1 ? 'Próximo' : 'Próximos' },
  { valor: attended.length, etiqueta: attended.length === 1 ? 'Asistencia' : 'Asistencias' },
];

const secciones = [
  { titulo: 'Próximos eventos', eventos: upcoming },
  { titulo: 'Eventos pasados', eventos: past },
].filter((seccion) => seccion.eventos.length > 0);

let profile: UserProfile | null = null;

try {
  profile = await getUserProfile(user.uid);
} catch (error) {
  console.warn('No se pudo obtener el perfil desde Firebase:', error);
}

// Lo guardado en /configuracion manda sobre lo que trae el token de Firebase
// Auth, que es solo el punto de partida de quien nunca ha tocado el formulario.
const displayName = profile
  ? [profile.firstName, profile.lastName].filter(Boolean).join(' ')
  : user.name;
const displayAvatar = profile?.avatarUrl ?? user.avatarUrl;

interface SocialLink {
  key: SocialKey | 'website';
  label: string;
  href: string;
  tooltip: string;
}

const socialLinks: SocialLink[] = SOCIAL_FIELDS.flatMap((field) => {
  const handle = profile?.socials?.[field.key];
  return handle
    ? [{
        key: field.key,
        label: field.label,
        href: `${field.baseUrl}${handle}`,
        tooltip: `${field.label}: @${handle}`,
      }]
    : [];
});

if (profile?.socials?.website) {
  socialLinks.push({
    key: 'website',
    label: 'Sitio web',
    href: profile.socials.website,
    tooltip: profile.socials.website.replace(/^https?:\/\//, ''),
  });
}
---

<BaseLayout title={`${displayName} — Nodo`} description="Tu perfil en Nodo.">
  {/*
    Dos columnas, como el perfil de Meetup: la tarjeta de identidad a la
    izquierda y el contenido a la derecha. En una sola columna, los datos del
    perfil empujaban los eventos fuera de la primera pantalla, que es lo que uno
    viene a mirar.
  */}
  <div class="mx-auto grid max-w-[1200px] gap-8 px-6 pb-24 pt-12 lg:grid-cols-[340px_1fr] lg:gap-12">
    {/* La tarjeta acompana el scroll en pantalla ancha: la lista de eventos es
        larga y sin esto la identidad se pierde arriba del todo. */}
    <aside class="lg:sticky lg:top-8 lg:self-start">
      <div class="rounded-3xl bg-superficie p-6 shadow-[var(--c-sombra-alta)]">
        {displayAvatar ? (
          <img src={displayAvatar} alt="" class="size-28 rounded-full object-cover" />
        ) : (
          <div class="flex size-28 items-center justify-center rounded-full bg-fondo-alt text-4xl font-semibold text-texto">
            {displayName.charAt(0).toUpperCase()}
          </div>
        )}

        <h1 class="mt-5 flex flex-wrap items-center gap-x-2 text-2xl font-bold tracking-tight text-texto">
          {displayName}
          {profile?.verification && <VerifiedBadge type={profile.verification} class="size-5" />}
        </h1>

        {profile?.username && <p class="mt-1 text-sm text-suave">@{profile.username}</p>}

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
          <a
            href="/configuracion"
            class="text-sm font-semibold text-acento-texto transition hover:opacity-80"
          >
            Editar perfil
          </a>

          {/* Esta pagina es la privada: enseña tambien a que eventos asistes.
              La publica es la que ve el resto, y conviene poder mirarla. */}
          {profile?.username && (
            <a
              href={`/u/${profile.username}`}
              class="text-sm font-semibold text-suave transition hover:text-texto"
            >
              Ver perfil público
            </a>
          )}
        </div>

        {createdAt && (
          <p class="mt-4 flex items-center gap-2 text-sm text-suave">
            <CalendarDays class="size-4 shrink-0" stroke-width={1.75} />
            Se unió en {formatMonthYear(createdAt)}
          </p>
        )}

        {profile?.bio && (
          <p class="mt-4 whitespace-pre-line text-sm leading-6 text-suave">{profile.bio}</p>
        )}

        {socialLinks.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer me"
                aria-label={link.tooltip}
                class="group relative flex size-9 items-center justify-center rounded-xl border border-linea bg-superficie text-suave transition active:scale-[0.95] hover:border-acento hover:text-texto"
              >
                <SocialIcon name={link.key} class="size-4" />

                {/* El globo aparece con hover y tambien con foco de teclado, para
                    que quien navega con tabulador vea la misma informacion. */}
                <span
                  role="tooltip"
                  class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-acento px-3 py-1.5 text-xs font-medium text-texto shadow-lg group-hover:block group-focus-visible:block"
                >
                  {link.tooltip}
                  <span class="absolute left-1/2 top-full size-2 -translate-x-1/2 -translate-y-1 rotate-45 bg-acento"></span>
                </span>
              </a>
            ))}
          </div>
        )}

        <div class="mt-6 grid grid-cols-3 gap-2 border-t border-linea pt-5 text-center">
          {cifras.map((cifra) => (
            <div>
              <p class="text-xl font-bold text-texto">{cifra.valor}</p>
              <p class="mt-0.5 text-xs text-suave">{cifra.etiqueta}</p>
            </div>
          ))}
        </div>
      </div>
    </aside>

    <div class="min-w-0 space-y-12">
      {temas.length > 0 && (
        <section>
          <h2 class="flex items-baseline gap-2 text-2xl font-bold tracking-tight text-texto">
            Temas de tus eventos
            <span class="text-base font-medium text-tenue">{temas.length}</span>
          </h2>

          <div class="mt-5 flex flex-wrap gap-2">
            {temas.map((tema) => (
              <a
                href={`/?q=${encodeURIComponent(tema)}`}
                data-gen={genColor(tema)}
                class="rounded-full border border-[var(--g)] bg-[var(--g-suave)] px-4 py-2 text-sm font-medium capitalize text-[var(--g-texto)] transition active:scale-[0.97] hover:-translate-y-0.5"
              >
                {tema}
              </a>
            ))}
          </div>
        </section>
      )}

      {secciones.length === 0 ? (
        <EmptyState
          title="Todavía no tienes eventos"
          description="Cuando publiques uno o digas que asistes, aparecerá aquí."
        />
      ) : (
        secciones.map((seccion) => (
          <section>
            <h2 class="text-2xl font-bold tracking-tight text-texto">{seccion.titulo}</h2>

            <div class="mt-5 space-y-3">
              {seccion.eventos.map((event) => (
                <a
                  href={`/eventos/${event.slug}`}
                  class="group flex items-center gap-4 rounded-2xl bg-superficie p-3 shadow-[var(--c-sombra)] transition active:scale-[0.99] hover:-translate-y-0.5"
                >
                  <div class="size-16 shrink-0 overflow-hidden rounded-xl">
                    {event.bannerUrl ? (
                      <img src={event.bannerUrl} alt="" loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-fondo-alt via-fondo-alt to-linea-suave text-sm font-semibold text-tenue">
                        {event.title.charAt(0).toUpperCase()}
                      </div>
                    )}
                  </div>

                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-suave">
                      {formatEventDate(event.startDate, event.timezone)}, {formatEventTime(event.startDate, event.timezone)}
                    </p>
                    <p class="mt-0.5 truncate font-semibold text-texto">{event.title}</p>
                    <p class="mt-1 truncate text-sm text-suave">
                      {event.organizer.uid === user.uid ? 'Lo organizas tú' : `Por ${event.organizer.name}`}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      )}
    </div>
  </div>
</BaseLayout>
