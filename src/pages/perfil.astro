---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import { getAccountCreatedAt, getCurrentUser } from '../lib/auth';
import { getEvents } from '../lib/firebase/events';
import { getAttendedEventIds } from '../lib/firebase/rsvps';
import { getUserProfile } from '../lib/firebase/users';
import { formatEventDate, formatEventTime, formatMonthYear } from '../lib/format';
import SocialIcon from '../components/ui/SocialIcon.astro';
import VerifiedBadge from '../components/ui/VerifiedBadge.astro';
import { SOCIAL_FIELDS } from '../types/profile';
import { CalendarDays } from '@lucide/astro';
import type { NodoEvent } from '../types/event';
import type { SocialKey, UserProfile } from '../types/profile';

const user = await getCurrentUser(Astro.cookies);

if (!user) {
  return Astro.redirect('/?login=required');
}

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

// Una sola lectura de eventos y todo lo demás se deriva en memoria, igual que
// hacen el resto de páginas.
const organized = allEvents.filter((event) => event.organizer.uid === user.uid);

let attendedIds = new Set<string>();

try {
  attendedIds = await getAttendedEventIds(
    user.uid,
    allEvents.map((event) => event.id),
  );
} catch (error) {
  console.warn('No se pudo obtener la asistencia del usuario:', error);
}

const attended = allEvents.filter((event) => attendedIds.has(event.id));

// Un evento propio al que además dijiste que asistes no debe listarse dos
// veces, pero sí cuenta en ambas cifras.
const timeline = allEvents.filter(
  (event) => event.organizer.uid === user.uid || attendedIds.has(event.id),
);

const now = Date.now();
const upcoming = timeline.filter((event) => event.endDate.getTime() >= now);
const past = timeline
  .filter((event) => event.endDate.getTime() < now)
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const createdAt = await getAccountCreatedAt(user.uid);

let profile: UserProfile | null = null;

try {
  profile = await getUserProfile(user.uid);
} catch (error) {
  console.warn('No se pudo obtener el perfil desde Firebase:', error);
}

// Lo guardado en /configuracion manda sobre lo que trae el token de Firebase
// Auth, que es solo el punto de partida de quien nunca ha tocado el formulario.
const displayName = profile
  ? [profile.firstName, profile.lastName].filter(Boolean).join(' ')
  : user.name;
const displayAvatar = profile?.avatarUrl ?? user.avatarUrl;

interface SocialLink {
  key: SocialKey | 'website';
  label: string;
  href: string;
  tooltip: string;
}

const socialLinks: SocialLink[] = SOCIAL_FIELDS.flatMap((field) => {
  const handle = profile?.socials?.[field.key];
  return handle
    ? [{
        key: field.key,
        label: field.label,
        href: `${field.baseUrl}${handle}`,
        tooltip: `${field.label}: @${handle}`,
      }]
    : [];
});

if (profile?.socials?.website) {
  socialLinks.push({
    key: 'website',
    label: 'Sitio web',
    href: profile.socials.website,
    tooltip: profile.socials.website.replace(/^https?:\/\//, ''),
  });
}
---

<BaseLayout title={`${displayName} — Nodo`} description="Tu perfil en Nodo.">
  <div class="mx-auto max-w-3xl px-6 pb-24 pt-16">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-center">
      {displayAvatar ? (
        <img
          src={displayAvatar}
          alt=""
          class="size-28 shrink-0 rounded-full object-cover sm:size-32"
        />
      ) : (
        <div class="flex size-28 shrink-0 items-center justify-center rounded-full bg-fondo-alt text-4xl font-semibold text-texto sm:size-32">
          {displayName.charAt(0).toUpperCase()}
        </div>
      )}

      <div class="min-w-0">
        <h1 class="flex flex-wrap items-center gap-x-2 text-3xl font-bold tracking-tight text-texto sm:text-4xl">
          {displayName}
          {profile?.verification && <VerifiedBadge type={profile.verification} class="size-6 sm:size-7" />}
        </h1>

        {profile?.username && <p class="mt-1 text-sm text-suave">@{profile.username}</p>}

        {createdAt && (
          <p class="mt-2 flex items-center gap-2 text-sm text-suave">
            <CalendarDays class="size-4 shrink-0" stroke-width={1.75} />
            Se unió en {formatMonthYear(createdAt)}
          </p>
        )}

        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm text-suave">
          <span>
            <strong class="font-semibold text-texto">{organized.length}</strong>
            {organized.length === 1 ? ' Organizado' : ' Organizados'}
          </span>
          <span>
            <strong class="font-semibold text-texto">{attended.length}</strong>
            {attended.length === 1 ? ' Asistido' : ' Asistidos'}
          </span>
        </div>
      </div>
    </header>

    {profile?.bio && (
      <p class="mt-6 max-w-2xl whitespace-pre-line text-texto">{profile.bio}</p>
    )}

    {socialLinks.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={link.tooltip}
            class="group relative flex size-9 items-center justify-center rounded-xl border border-linea bg-superficie text-suave transition active:scale-[0.95] hover:border-acento hover:text-texto"
          >
            <SocialIcon name={link.key} class="size-4" />

            {/* El globo aparece con hover y tambien con foco de teclado, para
                que quien navega con tabulador vea la misma informacion. */}
            <span
              role="tooltip"
              class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-acento px-3 py-1.5 text-xs font-medium text-texto shadow-lg group-hover:block group-focus-visible:block"
            >
              {link.tooltip}
              <span class="absolute left-1/2 top-full size-2 -translate-x-1/2 -translate-y-1 rotate-45 bg-acento"></span>
            </span>
          </a>
        ))}
      </div>
    )}

    {timeline.length === 0 ? (
      <div class="mt-12 border-t border-linea pt-12">
        <EmptyState
          title="Todavía no tienes eventos"
          description="Cuando publiques uno o digas que asistes, aparecerá aquí."
        />
      </div>
    ) : (
      <div class="mt-12 space-y-12 border-t border-linea pt-10">
        {upcoming.length > 0 && (
          <section>
            <h2 class="mb-5 text-lg font-semibold text-texto">Próximos eventos</h2>
            <div class="space-y-1">
              {upcoming.map((event) => (
                <a
                  href={`/eventos/${event.slug}`}
                  class="group -mx-2 flex items-center gap-4 rounded-2xl px-2 py-3 transition active:scale-[0.99] hover:bg-fondo-alt"
                >
                  <div class="size-16 shrink-0 overflow-hidden rounded-xl">
                    {event.bannerUrl ? (
                      <img src={event.bannerUrl} alt="" loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-fondo-alt via-fondo-alt to-linea-suave text-sm font-semibold text-tenue">
                        {event.title.charAt(0).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-suave">
                      {formatEventDate(event.startDate, event.timezone)}, {formatEventTime(event.startDate, event.timezone)}
                    </p>
                    <p class="mt-0.5 truncate font-medium text-texto transition group-hover:text-texto">
                      {event.title}
                    </p>
                    <p class="mt-1 truncate text-sm text-suave">
                      Por {event.organizer.name}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {past.length > 0 && (
          <section>
            <h2 class="mb-5 text-lg font-semibold text-texto">Eventos pasados</h2>
            <div class="space-y-1">
              {past.map((event) => (
                <a
                  href={`/eventos/${event.slug}`}
                  class="group -mx-2 flex items-center gap-4 rounded-2xl px-2 py-3 transition active:scale-[0.99] hover:bg-fondo-alt"
                >
                  <div class="size-16 shrink-0 overflow-hidden rounded-xl">
                    {event.bannerUrl ? (
                      <img src={event.bannerUrl} alt="" loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-fondo-alt via-fondo-alt to-linea-suave text-sm font-semibold text-tenue">
                        {event.title.charAt(0).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-suave">
                      {formatEventDate(event.startDate, event.timezone)}, {formatEventTime(event.startDate, event.timezone)}
                    </p>
                    <p class="mt-0.5 truncate font-medium text-texto transition group-hover:text-texto">
                      {event.title}
                    </p>
                    <p class="mt-1 truncate text-sm text-suave">
                      Por {event.organizer.name}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>
