---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getCurrentUser } from '../lib/auth';
import { getUserProfile } from '../lib/firebase/users';
import { USERNAME_RULES, suggestUsername } from '../lib/profileValidation';
import type { UserProfile } from '../types/profile';

const user = await getCurrentUser(Astro.cookies);

if (!user) {
  return Astro.redirect(`/?login=required&destino=${encodeURIComponent(Astro.url.pathname)}`);
}

let profile: UserProfile | null = null;

try {
  profile = await getUserProfile(user.uid);
} catch (error) {
  console.warn('No se pudo obtener el perfil desde Firebase:', error);
}

// Quien ya eligio nombre de usuario no tiene nada que hacer aqui.
if (profile?.username) {
  return Astro.redirect('/perfil');
}

// El proveedor devuelve el nombre completo en un solo campo; se parte para
// prellenar, pero es solo una propuesta: el objetivo de esta pantalla es
// justamente poder cambiarlo.
const [authFirst = '', ...authRest] = user.name.split(' ');

const inputClass =
  'mt-1.5 w-full rounded-xl bg-superficie px-3.5 py-2.5 text-sm text-texto placeholder:text-tenue ring-1 ring-inset ring-linea focus-visible:outline-none focus:ring-2 focus:ring-acento';
---

<BaseLayout title="Te damos la bienvenida — Nodo" description="Completa tu perfil en Nodo.">
  <div class="mx-auto max-w-lg px-6 pb-24 pt-16">
    <h1 class="text-3xl font-bold tracking-tight text-texto">Te damos la bienvenida</h1>
    <p class="mt-3 text-sm text-suave">
      Tomamos tu nombre de la cuenta con la que entraste. Cámbialo si prefieres mostrar otro, y elige cómo
      quieres que te encuentren.
    </p>

    <form id="welcome-form" novalidate class="mt-8 space-y-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="firstName" class="block text-sm font-medium text-texto">Nombre</label>
          <input id="firstName" name="firstName" type="text" required maxlength="60" class={inputClass} value={authFirst} />
        </div>
        <div>
          <label for="lastName" class="block text-sm font-medium text-texto">Apellido</label>
          <input id="lastName" name="lastName" type="text" maxlength="60" class={inputClass} value={authRest.join(' ')} />
        </div>
      </div>

      <div>
        <label for="username" class="block text-sm font-medium text-texto">Nombre de usuario</label>
        <div class="mt-1.5 flex overflow-hidden rounded-xl ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento">
          <span class="flex items-center bg-fondo-alt px-3.5 text-sm text-suave">@</span>
          <input
            id="username"
            name="username"
            type="text"
            maxlength="30"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            class="w-full bg-superficie px-3.5 py-2.5 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
            value={suggestUsername(user.name, user.email)}
          />
        </div>
        <p id="username-hint" class="mt-1.5 text-xs text-tenue">{USERNAME_RULES}</p>
      </div>

      <p id="welcome-error" class="hidden text-sm text-acento-texto"></p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <Button variant="primary" type="submit" id="welcome-submit">Continuar</Button>
        <a href="/" class="text-sm text-suave transition hover:text-texto">Ahora no</a>
      </div>
    </form>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('welcome-form') as HTMLFormElement;
  const usernameField = document.getElementById('username') as HTMLInputElement;
  const hint = document.getElementById('username-hint') as HTMLParagraphElement;
  const errorBox = document.getElementById('welcome-error') as HTMLParagraphElement;
  const submit = document.getElementById('welcome-submit') as HTMLButtonElement;

  const defaultHint = hint.textContent ?? '';
  let checkTimer: ReturnType<typeof setTimeout> | undefined;
  let lastChecked = '';

  function setHint(text: string, tone: 'neutral' | 'ok' | 'bad'): void {
    hint.textContent = text;
    hint.classList.toggle('text-tenue', tone === 'neutral');
    hint.classList.toggle('text-acento-texto', tone === 'ok');
    hint.classList.toggle('text-acento-texto', tone === 'bad');
  }

  async function checkAvailability(): Promise<void> {
    const value = usernameField.value.trim().toLowerCase();

    if (!value || value === lastChecked) {
      return;
    }

    lastChecked = value;

    try {
      const response = await fetch(`/api/usuario/${encodeURIComponent(value)}`);
      const result = await response.json();

      // Una respuesta que llega tarde no debe pisar lo que ya se escribio.
      if (usernameField.value.trim().toLowerCase() !== value) {
        return;
      }

      if (result.available) {
        setHint(`@${value} está disponible.`, 'ok');
      } else {
        setHint(result.reason ?? 'No se puede usar.', 'bad');
      }
    } catch {
      setHint(defaultHint, 'neutral');
    }
  }

  usernameField.addEventListener('input', () => {
    setHint(defaultHint, 'neutral');
    clearTimeout(checkTimer);
    checkTimer = setTimeout(checkAvailability, 400);
  });

  checkAvailability();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');
    submit.disabled = true;

    const data = new FormData(form);

    try {
      const response = await fetch('/api/perfil', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: data.get('firstName'),
          lastName: data.get('lastName'),
          username: data.get('username'),
          socials: {},
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo guardar tu perfil.');
      }

      window.location.href = '/perfil';
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar tu perfil.';
      errorBox.classList.remove('hidden');
      submit.disabled = false;
    }
  });
</script>
