---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/events/EmptyState.astro';
import EventCard from '../../components/events/EventCard.astro';
import Button from '../../components/ui/Button.astro';
import { getCurrentUser } from '../../lib/auth';
import {
  getActiveMembers,
  getCommunityBySlug,
  getMemberCount,
  getMembership,
  getPendingRequests,
  isFollowing,
} from '../../lib/firebase/communities';
import { getUserProfiles } from '../../lib/firebase/users';
import { getEvents } from '../../lib/firebase/events';
import { getAttendeeFaces } from '../../lib/firebase/rsvps';
import { formatMonthYear } from '../../lib/format';
import { CalendarDays, Check, LogOut, Pencil, ShieldCheck, ShieldOff, Users, X } from '@lucide/astro';
import type { NodoEvent } from '../../types/event';

const community = await getCommunityBySlug(Astro.params.slug ?? '');

if (!community) {
  return Astro.redirect('/comunidades');
}

const user = await getCurrentUser(Astro.cookies);
const esDueno = user?.uid === community.ownerUid;
const membresia = user && !esDueno ? await getMembership(community.id, user.uid).catch(() => null) : null;
const esActivo = esDueno || membresia?.status === 'active';
const puedeAdministrar = esDueno || (membresia?.status === 'active' && membresia.role === 'admin');
const solicitudPendiente = membresia?.status === 'pending';
const siguiendo = user ? await isFollowing(community.id, user.uid).catch(() => false) : false;

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

const eventos = allEvents.filter((event) => event.community?.id === community.id);
const ahora = Date.now();
const proximos = eventos.filter((event) => event.endDate.getTime() >= ahora);
const pasados = eventos
  .filter((event) => event.endDate.getTime() < ahora)
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

// Las caras de quienes han confirmado, para las tarjetas. Una sola llamada
// para todo lo que la pagina va a pintar: por dentro lanza las consultas a la
// vez y resuelve los perfiles en un unico getAll().
const caras = await getAttendeeFaces(eventos.map((event) => event.id), 4).catch(() => new Map());

const miembros = await getMemberCount(community.id).catch(() => 0);

// Solo se leen si hace falta pintarlas: nadie mas que quien administra ve
// solicitudes ni la lista de miembros.
const solicitudes = puedeAdministrar ? await getPendingRequests(community.id).catch(() => []) : [];
const activos = puedeAdministrar ? await getActiveMembers(community.id).catch(() => []) : [];
const perfiles = puedeAdministrar
  ? await getUserProfiles([...solicitudes.map((s) => s.uid), ...activos.map((a) => a.uid)])
  : new Map();

function nombreDe(uid: string): string {
  const perfil = perfiles.get(uid);
  return perfil ? [perfil.firstName, perfil.lastName].filter(Boolean).join(' ') || 'Alguien' : 'Alguien';
}
---

<BaseLayout title={`${community.name} — Innvita`} description={community.description ?? `Comunidad ${community.name} en Innvita.`}>
  <div class="mx-auto max-w-[1200px] px-6 pb-24 pt-12">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex min-w-0 items-start gap-5">
        {community.avatarUrl ? (
          <img src={community.avatarUrl} alt="" class="size-20 shrink-0 rounded-2xl object-cover" />
        ) : (
          <div class="flex size-20 shrink-0 items-center justify-center rounded-2xl bg-fondo-alt text-3xl font-bold text-texto">
            {community.name.charAt(0).toUpperCase()}
          </div>
        )}

        <div class="min-w-0">
          <h1 class="text-[32px] font-bold leading-tight text-texto">{community.name}</h1>

          <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-suave">
            <span class="flex items-center gap-1.5">
              <Users class="size-4" stroke-width={1.75} />
              {miembros} {miembros === 1 ? 'miembro' : 'miembros'}
            </span>
            <span class="flex items-center gap-1.5">
              <CalendarDays class="size-4" stroke-width={1.75} />
              {eventos.length} {eventos.length === 1 ? 'evento' : 'eventos'}
            </span>
            <span>Desde {formatMonthYear(community.createdAt)}</span>
          </div>

          {community.description && (
            <p class="mt-4 max-w-prose whitespace-pre-line text-suave">{community.description}</p>
          )}
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        {puedeAdministrar ? (
          <>
            <a
              href={`/comunidades/${community.slug}/editar`}
              class="flex h-10 items-center gap-2 rounded-full border border-linea px-4 text-sm font-semibold text-texto transition active:scale-[0.97] hover:border-acento"
            >
              <Pencil class="size-4" stroke-width={1.75} />
              Editar
            </a>
            <Button href="/eventos/nuevo">Publicar evento</Button>
          </>
        ) : esActivo ? (
          <>
            <span class="flex h-10 items-center gap-2 rounded-full border border-linea px-4 text-sm font-semibold text-suave">
              <Users class="size-4" stroke-width={1.75} />
              Eres miembro
            </span>
            <button
              id="community-salir"
              type="button"
              data-slug={community.slug}
              title="Salir de la comunidad"
              class="flex size-10 items-center justify-center rounded-full border border-linea text-suave transition active:scale-[0.97] hover:border-acento hover:text-texto disabled:cursor-not-allowed disabled:opacity-60"
            >
              <LogOut class="size-4" stroke-width={1.75} />
            </button>
            <Button href="/eventos/nuevo">Publicar evento</Button>
          </>
        ) : (
          <>
            <button
              id="community-join"
              type="button"
              data-slug={community.slug}
              data-following={siguiendo ? 'true' : 'false'}
              data-sesion={user ? 'activa' : 'inactiva'}
              class="h-10 rounded-full border border-linea px-4 text-sm font-semibold text-texto transition active:scale-[0.97] hover:border-acento disabled:cursor-not-allowed disabled:opacity-60"
            >
              {siguiendo ? 'Siguiendo' : 'Seguir'}
            </button>
            <button
              id="community-solicitar"
              type="button"
              data-slug={community.slug}
              data-sesion={user ? 'activa' : 'inactiva'}
              data-pendiente={solicitudPendiente ? 'true' : 'false'}
              disabled={solicitudPendiente}
              class="h-10 rounded-full bg-acento px-5 text-sm font-semibold tracking-[0.02em] text-acento-contraste transition active:scale-[0.97] hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
            >
              {solicitudPendiente ? 'Solicitud enviada' : 'Solicitar membresía'}
            </button>
          </>
        )}
      </div>
    </header>

    {puedeAdministrar && (solicitudes.length > 0 || activos.length > 0) && (
      <section data-slug={community.slug} class="mt-10 space-y-6 rounded-3xl border border-linea bg-superficie p-6">
        <h2 class="text-lg font-bold text-texto">Solicitudes y miembros</h2>

        {solicitudes.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold text-suave">Solicitudes pendientes</h3>
            <ul class="mt-3 space-y-3">
              {solicitudes.map((solicitud) => (
                <li data-miembro={solicitud.uid} class="flex items-center gap-3">
                  {perfiles.get(solicitud.uid)?.avatarUrl ? (
                    <img src={perfiles.get(solicitud.uid)!.avatarUrl} alt="" class="size-10 shrink-0 rounded-full object-cover" />
                  ) : (
                    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-fondo-alt text-sm font-medium text-suave">
                      {nombreDe(solicitud.uid).charAt(0).toUpperCase()}
                    </span>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-texto">{nombreDe(solicitud.uid)}</p>
                    {perfiles.get(solicitud.uid)?.username && (
                      <p class="text-xs text-tenue">@{perfiles.get(solicitud.uid)!.username}</p>
                    )}
                  </div>
                  <button
                    type="button"
                    data-accion="aprobar"
                    title="Aprobar"
                    class="flex size-9 shrink-0 items-center justify-center rounded-full border border-linea text-acento-texto transition active:scale-[0.97] hover:border-acento disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    <Check class="size-4" stroke-width={2} />
                  </button>
                  <button
                    type="button"
                    data-accion="declinar"
                    title="Declinar"
                    class="flex size-9 shrink-0 items-center justify-center rounded-full border border-linea text-suave transition active:scale-[0.97] hover:border-acento hover:text-texto disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    <X class="size-4" stroke-width={2} />
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        {activos.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold text-suave">Miembros</h3>
            <ul class="mt-3 space-y-3">
              {activos.map((miembro) => (
                <li data-miembro={miembro.uid} class="flex items-center gap-3">
                  {perfiles.get(miembro.uid)?.avatarUrl ? (
                    <img src={perfiles.get(miembro.uid)!.avatarUrl} alt="" class="size-10 shrink-0 rounded-full object-cover" />
                  ) : (
                    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-fondo-alt text-sm font-medium text-suave">
                      {nombreDe(miembro.uid).charAt(0).toUpperCase()}
                    </span>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-texto">{nombreDe(miembro.uid)}</p>
                    {perfiles.get(miembro.uid)?.username && (
                      <p class="text-xs text-tenue">@{perfiles.get(miembro.uid)!.username}</p>
                    )}
                  </div>
                  <span class="shrink-0 text-xs font-medium text-tenue">{miembro.role === 'admin' ? 'Admin' : 'Miembro'}</span>
                  {miembro.role === 'admin' ? (
                    <button
                      type="button"
                      data-accion="quitar-admin"
                      title="Quitar admin"
                      class="flex size-9 shrink-0 items-center justify-center rounded-full border border-linea text-suave transition active:scale-[0.97] hover:border-acento hover:text-texto disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      <ShieldOff class="size-4" stroke-width={1.75} />
                    </button>
                  ) : (
                    <button
                      type="button"
                      data-accion="hacer-admin"
                      title="Hacer admin"
                      class="flex size-9 shrink-0 items-center justify-center rounded-full border border-linea text-suave transition active:scale-[0.97] hover:border-acento hover:text-texto disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      <ShieldCheck class="size-4" stroke-width={1.75} />
                    </button>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <div class="mt-12 space-y-12">
      {proximos.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-tight text-texto">Próximos eventos</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {proximos.map((event) => <EventCard event={event} attendees={caras.get(event.id)} />)}
          </div>
        </section>
      )}

      {pasados.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-tight text-texto">Eventos pasados</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {pasados.map((event) => <EventCard event={event} attendees={caras.get(event.id)} />)}
          </div>
        </section>
      )}

      {eventos.length === 0 && (
        <EmptyState
          title="Esta comunidad todavía no ha publicado"
          description="Cuando publique su primer evento, aparecerá aquí."
        />
      )}
    </div>
  </div>
</BaseLayout>

<script>
  function abrirModalSesion(): void {
    (document.getElementById('nodo-modal-sesion') as HTMLDialogElement | null)?.showModal();
  }

  // --- Seguir / dejar de seguir ---------------------------------------------
  const botonSeguir = document.getElementById('community-join') as HTMLButtonElement | null;

  botonSeguir?.addEventListener('click', async () => {
    if (botonSeguir.dataset.sesion !== 'activa') {
      abrirModalSesion();
      return;
    }

    const siguiendo = botonSeguir.dataset.following === 'true';
    botonSeguir.disabled = true;

    try {
      // Content-Type obligatorio: sin el, Astro trata la peticion como envio de
      // formulario y detras del proxy responde 403 sin llegar a la ruta.
      const respuesta = await fetch(`/api/comunidades/${botonSeguir.dataset.slug}/unirse`, {
        method: siguiendo ? 'DELETE' : 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      if (!respuesta.ok) {
        throw new Error('No se pudo completar la acción.');
      }

      const cuerpo = await respuesta.json();
      botonSeguir.dataset.following = cuerpo.following ? 'true' : 'false';
      botonSeguir.textContent = cuerpo.following ? 'Siguiendo' : 'Seguir';
    } catch (error) {
      console.error(error);
    } finally {
      botonSeguir.disabled = false;
    }
  });

  // --- Solicitar membresía ---------------------------------------------------
  const botonSolicitar = document.getElementById('community-solicitar') as HTMLButtonElement | null;

  botonSolicitar?.addEventListener('click', async () => {
    if (botonSolicitar.dataset.sesion !== 'activa') {
      abrirModalSesion();
      return;
    }

    botonSolicitar.disabled = true;

    try {
      const respuesta = await fetch(`/api/comunidades/${botonSolicitar.dataset.slug}/miembros`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      if (!respuesta.ok) {
        throw new Error('No se pudo enviar la solicitud.');
      }

      botonSolicitar.textContent = 'Solicitud enviada';
    } catch (error) {
      console.error(error);
      botonSolicitar.disabled = false;
    }
  });

  // --- Salir de la comunidad ---------------------------------------------------
  const botonSalir = document.getElementById('community-salir') as HTMLButtonElement | null;

  botonSalir?.addEventListener('click', async () => {
    botonSalir.disabled = true;

    try {
      const respuesta = await fetch(`/api/comunidades/${botonSalir.dataset.slug}/miembros`, { method: 'DELETE' });

      if (!respuesta.ok) {
        throw new Error('No se pudo salir de la comunidad.');
      }

      window.location.reload();
    } catch (error) {
      console.error(error);
      botonSalir.disabled = false;
    }
  });

  // --- Aprobar, declinar, hacer o quitar admin --------------------------------
  // Tras aplicar se recarga: el estado de cada fila vive en el servidor, y
  // recargar es la forma mas simple de que la pagina diga lo que hay guardado.
  const seccionMiembros = document.querySelector<HTMLElement>('section[data-slug]');
  const slugComunidad = seccionMiembros?.dataset.slug;

  document.querySelectorAll<HTMLButtonElement>('[data-accion]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const fila = boton.closest<HTMLElement>('[data-miembro]');
      const uid = fila?.dataset.miembro;

      if (!uid || !slugComunidad) return;

      boton.disabled = true;

      try {
        const respuesta = await fetch(`/api/comunidades/${slugComunidad}/miembros/${uid}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: boton.dataset.accion }),
        });

        if (!respuesta.ok) {
          throw new Error('No se pudo aplicar la acción.');
        }

        window.location.reload();
      } catch (error) {
        console.error(error);
        boton.disabled = false;
      }
    });
  });
</script>
