---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentUser } from '../../lib/auth';
import { getEventBySlug } from '../../lib/firebase/events';
import { getGoogleCalendarUrl, getIcsDataUrl } from '../../lib/calendar';
import { formatEventDateLong, formatEventDay, formatEventMonthShort, formatEventTime } from '../../lib/format';
import { CalendarPlus, Download, MapPin, Video } from '@lucide/astro';
import type { EventModality } from '../../types/event';

const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug).catch(() => null) : null;

if (!event) {
  return new Response(null, { status: 404, statusText: 'Evento no encontrado' });
}

const user = await getCurrentUser(Astro.cookies);
const isOwner = user?.uid === event.organizer.uid;

const modalityLabel: Record<EventModality, string> = {
  presencial: 'Presencial',
  virtual: 'Virtual',
  hibrido: 'Híbrido',
};

const physicalLocation = [event.venue, event.address, event.city].filter(Boolean).join(', ');
const monthLabel = formatEventMonthShort(event.startDate, event.timezone);
const dayLabel = formatEventDay(event.startDate, event.timezone);

const googleCalendarUrl = getGoogleCalendarUrl(event);
const icsDataUrl = getIcsDataUrl(event);
---

<BaseLayout
  title={`${event.title} — Nodo`}
  description={event.description}
  image={event.bannerUrl}
  type="article"
>
  <article>
    <div class="relative aspect-[21/9] w-full overflow-hidden bg-gradient-to-br from-neutral-800 via-neutral-900 to-neutral-950">
      {event.bannerUrl && <img src={event.bannerUrl} alt={event.title} class="h-full w-full object-cover" />}
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/10 to-transparent" />
    </div>

    <div class="mx-auto max-w-3xl px-6 pb-24 pt-10">
      {isOwner && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3">
          <p class="text-xs text-neutral-500">Estás viendo este evento como organizador</p>
          <div class="flex items-center gap-4">
            <a href={`/eventos/${event.slug}/editar`} class="text-sm font-medium text-neutral-200 hover:text-white">
              Editar evento
            </a>
            <button
              id="delete-event-button"
              type="button"
              data-event-id={event.id}
              class="text-sm font-medium text-red-400 transition-colors hover:text-red-300 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Eliminar evento
            </button>
          </div>
        </div>
      )}

      <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-900 px-3 py-1 text-xs font-medium text-neutral-300">
        {event.modality === 'virtual' ? (
          <Video class="size-3.5" stroke-width={2} />
        ) : (
          <MapPin class="size-3.5" stroke-width={2} />
        )}
        {modalityLabel[event.modality]}
      </span>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
        {event.title}
      </h1>

      <div class="mt-6 flex items-center gap-3 text-neutral-300">
        <div class="flex size-11 shrink-0 flex-col items-center justify-center rounded-lg bg-neutral-900 leading-none">
          <span class="text-[10px] uppercase text-emerald-400">{monthLabel}</span>
          <span class="text-base font-semibold">{dayLabel}</span>
        </div>
        <div>
          <p class="font-medium capitalize">{formatEventDateLong(event.startDate, event.timezone)}</p>
          <p class="text-sm text-neutral-500">
            {formatEventTime(event.startDate, event.timezone)} – {formatEventTime(event.endDate, event.timezone)}
          </p>
        </div>
      </div>

      <div class="mt-4 flex items-start gap-3 text-neutral-300">
        <div class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-neutral-900 text-neutral-400">
          {event.modality === 'virtual' ? (
            <Video class="size-5" stroke-width={1.75} />
          ) : (
            <MapPin class="size-5" stroke-width={1.75} />
          )}
        </div>
        <div>
          {event.modality === 'virtual' ? (
            <p class="font-medium">Evento en línea</p>
          ) : (
            <p class="font-medium">{physicalLocation}</p>
          )}
          {event.modality === 'hibrido' && event.meetingUrl && (
            <p class="text-sm text-neutral-500">También disponible en línea</p>
          )}
          {event.meetingUrl && event.modality !== 'presencial' && (
            <a
              href={event.meetingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-emerald-400 hover:underline"
            >
              {event.meetingUrl}
            </a>
          )}
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={googleCalendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-950 transition-colors hover:bg-emerald-400"
        >
          <CalendarPlus class="size-4" stroke-width={2} />
          Añadir a Google Calendar
        </a>
        <a
          href={icsDataUrl}
          download={`${event.slug}.ics`}
          class="inline-flex items-center gap-2 rounded-full border border-neutral-800 px-4 py-2 text-sm font-medium text-neutral-200 transition-colors hover:border-neutral-600"
        >
          <Download class="size-4" stroke-width={2} />
          Descargar iCal
        </a>
      </div>

      <div class="mt-10 flex items-center gap-3 border-y border-neutral-900 py-5">
        {event.organizer.avatarUrl ? (
          <img
            src={event.organizer.avatarUrl}
            alt={event.organizer.name}
            class="size-10 rounded-full object-cover"
          />
        ) : (
          <div class="flex size-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-neutral-400">
            {event.organizer.name.charAt(0).toUpperCase()}
          </div>
        )}
        <div>
          <p class="text-xs text-neutral-500">Organiza</p>
          <p class="font-medium text-neutral-100">{event.organizer.name}</p>
        </div>
      </div>

      <div class="mt-8 max-w-none whitespace-pre-line leading-relaxed text-neutral-300">
        {event.description}
      </div>

      {event.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {event.tags.map((tag) => (
            <span class="rounded-full bg-neutral-900 px-3 py-1 text-xs text-neutral-400">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
</BaseLayout>

{isOwner && (
  <script>
    const deleteButton = document.getElementById('delete-event-button') as HTMLButtonElement | null;

    deleteButton?.addEventListener('click', async () => {
      const confirmed = window.confirm('¿Seguro que quieres eliminar este evento? Esta acción no se puede deshacer.');

      if (!confirmed) {
        return;
      }

      deleteButton.disabled = true;

      try {
        const response = await fetch(`/api/events/${deleteButton.dataset.eventId}`, { method: 'DELETE' });

        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.error ?? 'No se pudo eliminar el evento.');
        }

        window.location.href = '/';
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'No se pudo eliminar el evento.');
        deleteButton.disabled = false;
      }
    });
  </script>
)}
