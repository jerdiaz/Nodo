---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusToast from '../../components/common/StatusToast.astro';
import ShareButtons from '../../components/events/ShareButtons.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { getCurrentUser } from '../../lib/auth';
import { getEventBySlug } from '../../lib/firebase/events';
import { getRsvpInfo } from '../../lib/firebase/rsvps';
import { getEventJsonLd } from '../../lib/eventSchema';
import { getGoogleCalendarUrl, getIcsDataUrl } from '../../lib/calendar';
import { formatEventDateLong, formatEventTime } from '../../lib/format';
import { CalendarDays, MapPin, Video } from '@lucide/astro';
import VerifiedBadge from '../../components/ui/VerifiedBadge.astro';
import { getUserProfile } from '../../lib/firebase/users';
import type { UserProfile } from '../../types/profile';

const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug).catch(() => null) : null;

if (!event) {
  return new Response(null, { status: 404, statusText: 'Evento no encontrado' });
}

const user = await getCurrentUser(Astro.cookies);
const isOwner = user?.uid === event.organizer.uid;
const eventEnded = event.endDate.getTime() < Date.now();

// En la cabecera manda la comunidad si el evento se publico en su nombre.
const autor = event.community ?? event.organizer;

// La palomita de verificado es del perfil de quien creo el evento, no del
// evento, asi que hay que leerlo. De paso sale de ahi el nombre de usuario,
// que es la direccion de su perfil publico.
let perfilOrganizador: UserProfile | null = null;

try {
  perfilOrganizador = await getUserProfile(event.organizer.uid);
} catch (error) {
  console.warn('No se pudo obtener el perfil del organizador:', error);
}

let rsvpCount = 0;
let isAttending = false;

try {
  const rsvpInfo = await getRsvpInfo(event.id, user?.uid);
  rsvpCount = rsvpInfo.count;
  isAttending = rsvpInfo.attending;
} catch (error) {
  console.warn('No se pudo obtener la asistencia del evento:', error);
}

const physicalLocation = [event.venue, event.address, event.city].filter(Boolean).join(', ');

const tzAbbreviation = new Intl.DateTimeFormat('es', { timeZone: event.timezone, timeZoneName: 'short' })
  .formatToParts(event.startDate)
  .find((part) => part.type === 'timeZoneName')?.value;

const googleCalendarUrl = getGoogleCalendarUrl(event);
const icsDataUrl = getIcsDataUrl(event);
const pageUrl = new URL(Astro.url.pathname, Astro.site?.origin ?? Astro.url.origin).toString();
// Escapa "<" para que una descripción de evento con "</script>" no pueda cerrar
// este bloque JSON-LD e inyectar HTML/JS — el texto es contenido de usuario sin sanitizar.
const eventJsonLdString = JSON.stringify(getEventJsonLd(event, pageUrl)).replace(/</g, '\\u003c');

const eventCreated = Astro.url.searchParams.get('created') === 'true';
const eventUpdated = Astro.url.searchParams.get('updated') === 'true';
---

<BaseLayout
  title={`${event.title} — Nodo`}
  description={event.description}
  image={event.bannerUrl}
  type="article"
>
  <script type="application/ld+json" is:inline set:html={eventJsonLdString} />

  {eventCreated && <StatusToast paramKey="created" message="¡Evento publicado correctamente!" />}
  {eventUpdated && <StatusToast paramKey="updated" message="Evento actualizado correctamente." />}

  <div class="mx-auto max-w-6xl px-6 pb-24 pt-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <article class="lg:col-span-7">
        <div class="aspect-[16/9] w-full overflow-hidden rounded-3xl bg-gradient-to-br from-fondo-alt via-fondo-alt to-linea-suave">
          {event.bannerUrl && <img src={event.bannerUrl} alt="" class="h-full w-full object-cover" />}
        </div>

        <h1 class="mt-6 text-3xl font-bold tracking-tight text-texto sm:text-4xl">
          {event.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
          {/*
            La cartelera lista el evento a nombre de la comunidad; aqui dentro
            se ve ademas quien lo creo, que es la persona con la que se habla si
            algo no cuadra. Sin comunidad, solo aparece esa persona.
          */}
          <div class="flex items-center gap-3">
            {autor.avatarUrl ? (
              <img src={autor.avatarUrl} alt="" class="size-10 rounded-full object-cover" />
            ) : (
              <div class="flex size-10 items-center justify-center rounded-full bg-superficie text-sm font-medium text-suave">
                {autor.name.charAt(0).toUpperCase()}
              </div>
            )}
            <div class="min-w-0">
              <p class="text-xs text-suave">Organiza</p>

              {event.community ? (
                <a
                  href={`/comunidades/${event.community.slug}`}
                  class="font-medium text-texto transition hover:text-acento-texto"
                >
                  {event.community.name}
                </a>
              ) : (
                <p class="flex items-center gap-1.5 font-medium text-texto">
                  {/*
                    Solo se enlaza si tiene nombre de usuario: la URL del perfil
                    publico es /u/<usuario>, y sin el no hay a donde llevar.
                  */}
                  {perfilOrganizador?.username ? (
                    <a
                      href={`/u/${perfilOrganizador.username}`}
                      class="transition hover:text-acento-texto"
                    >
                      {event.organizer.name}
                    </a>
                  ) : (
                    event.organizer.name
                  )}
                  {perfilOrganizador?.verification && (
                    <VerifiedBadge type={perfilOrganizador.verification} class="size-4" />
                  )}
                </p>
              )}

              {event.community && (
                <p class="mt-0.5 flex items-center gap-1.5 text-xs text-suave">
                  Publicado por
                  {perfilOrganizador?.username ? (
                    <a
                      href={`/u/${perfilOrganizador.username}`}
                      class="font-medium text-texto transition hover:text-acento-texto"
                    >
                      {event.organizer.name}
                    </a>
                  ) : (
                    event.organizer.name
                  )}
                  {perfilOrganizador?.verification && (
                    <VerifiedBadge type={perfilOrganizador.verification} class="size-3.5" />
                  )}
                </p>
              )}
            </div>
          </div>

          {event.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {event.tags.map((tag) => <Badge variant="auto" seed={tag}>{tag}</Badge>)}
            </div>
          )}
        </div>

        <div class="mt-8 max-w-none whitespace-pre-line text-base leading-relaxed text-texto">
          {event.description}
        </div>
      </article>

      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <Card blur class="space-y-6 p-6">
            <div>
              <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-suave">
                <CalendarDays class="size-3.5" stroke-width={2} />
                Fecha y hora
              </div>
              <p class="mt-2 font-semibold capitalize text-texto">
                {formatEventDateLong(event.startDate, event.timezone)}
              </p>
              <p class="text-sm text-suave">
                {formatEventTime(event.startDate, event.timezone)} – {formatEventTime(event.endDate, event.timezone)}
                {tzAbbreviation && ` (${tzAbbreviation})`}
              </p>
              <p
                id="local-time-hint"
                class="mt-1 hidden text-xs text-tenue"
                data-event-timezone={event.timezone}
                data-start-iso={event.startDate.toISOString()}
                data-end-iso={event.endDate.toISOString()}
              />
            </div>

            <div class="border-t border-linea pt-6">
              <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-suave">
                {event.modality === 'virtual' ? (
                  <Video class="size-3.5" stroke-width={2} />
                ) : (
                  <MapPin class="size-3.5" stroke-width={2} />
                )}
                Ubicación
              </div>

              {event.modality === 'virtual' ? (
                <p class="mt-2 font-medium text-texto">Evento en línea</p>
              ) : (
                <p class="mt-2 font-medium text-texto">{physicalLocation}</p>
              )}

              {event.modality === 'hibrido' && event.meetingUrl && (
                <p class="mt-1 text-sm text-suave">También disponible en línea</p>
              )}

              {event.meetingUrl && event.modality !== 'presencial' && (
                <a
                  href={event.meetingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 block break-all text-sm text-acento-texto hover:underline"
                >
                  {event.meetingUrl}
                </a>
              )}
            </div>

            <div class="border-t border-linea pt-6">
              {eventEnded ? (
                <button
                  id="rsvp-button"
                  type="button"
                  disabled
                  class="w-full cursor-not-allowed rounded-2xl border border-linea bg-superficie px-4 py-2.5 text-sm font-medium text-suave opacity-70"
                >
                  {isAttending ? 'Asististe a este evento' : 'Este evento ya terminó'}
                </button>
              ) : user ? (
                <button
                  id="rsvp-button"
                  type="button"
                  data-event-id={event.id}
                  data-attending={isAttending ? 'true' : 'false'}
                  class={`w-full rounded-2xl border px-4 py-2.5 text-sm font-medium transition active:scale-[0.97] ${
                    isAttending
                      ? 'border-acento bg-acento-suave text-acento-texto'
                      : 'border-linea bg-superficie text-texto hover:border-acento'
                  }`}
                >
                  {isAttending ? '✓ Asistes' : 'Me interesa'}
                </button>
              ) : (
                <a
                  href="/?login=required"
                  data-login-required
                  class="block w-full rounded-2xl border border-linea bg-superficie px-4 py-2.5 text-center text-sm font-medium text-texto transition active:scale-[0.97] hover:border-acento"
                >
                  Inicia sesión para decir que asistes
                </a>
              )}
              {!eventEnded && (
                <p id="rsvp-count" class="mt-2 text-center text-sm text-suave">
                  {rsvpCount === 0
                    ? 'Sé el primero en decir que asistes'
                    : `${rsvpCount} ${rsvpCount === 1 ? 'persona interesada' : 'personas interesadas'}`}
                </p>
              )}
            </div>

            <Button
              variant="primary"
              href={googleCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full"
            >
              Añadir a Google Calendar
            </Button>

            <ShareButtons event={event} url={pageUrl} icsUrl={icsDataUrl} />

            {isOwner && (
              <div class="flex items-center justify-between border-t border-linea pt-4">
                <a href={`/eventos/${event.slug}/editar`} class="text-sm font-medium text-suave transition hover:text-texto">
                  Editar evento
                </a>
                <button
                  id="delete-event-button"
                  type="button"
                  data-event-id={event.id}
                  class="text-sm font-medium text-acento-texto transition active:scale-[0.97] hover:text-acento-texto disabled:cursor-not-allowed disabled:opacity-60"
                >
                  Eliminar evento
                </button>
              </div>
            )}
          </Card>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const hint = document.getElementById('local-time-hint');

  if (hint) {
    const eventTimezone = hint.dataset.eventTimezone;
    const browserTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    if (browserTimezone && eventTimezone && browserTimezone !== eventTimezone) {
      const startIso = hint.dataset.startIso;
      const endIso = hint.dataset.endIso;

      if (startIso && endIso) {
        const start = new Date(startIso);
        const end = new Date(endIso);
        const dateFormatter = new Intl.DateTimeFormat('es', { month: 'short', day: 'numeric' });
        const timeFormatter = new Intl.DateTimeFormat('es', { hour: 'numeric', minute: '2-digit', hour12: true });

        hint.textContent = `Tu hora local: ${dateFormatter.format(start)}, ${timeFormatter.format(start)} – ${timeFormatter.format(end)}`;
        hint.classList.remove('hidden');
      }
    }
  }
</script>

{user && (
  <script>
    const rsvpButton = document.getElementById('rsvp-button') as HTMLButtonElement | null;
    const rsvpCountLabel = document.getElementById('rsvp-count') as HTMLParagraphElement | null;

    function rsvpCountText(count: number): string {
      if (count === 0) {
        return 'Sé el primero en decir que asistes';
      }
      return `${count} ${count === 1 ? 'persona interesada' : 'personas interesadas'}`;
    }

    function setRsvpButtonState(attending: boolean): void {
      if (!rsvpButton) {
        return;
      }
      rsvpButton.dataset.attending = String(attending);
      rsvpButton.textContent = attending ? '✓ Asistes' : 'Me interesa';
      rsvpButton.classList.toggle('border-acento', attending);
      rsvpButton.classList.toggle('bg-acento-suave', attending);
      rsvpButton.classList.toggle('text-acento-texto', attending);
      rsvpButton.classList.toggle('border-linea', !attending);
      rsvpButton.classList.toggle('bg-superficie', !attending);
      rsvpButton.classList.toggle('text-texto', !attending);
    }

    rsvpButton?.addEventListener('click', async () => {
      const attending = rsvpButton.dataset.attending === 'true';
      rsvpButton.disabled = true;

      try {
        const response = await fetch(`/api/events/${rsvpButton.dataset.eventId}/rsvp`, {
          method: attending ? 'DELETE' : 'POST',
          headers: { 'Content-Type': 'application/json' },
        });

        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.error ?? 'No se pudo actualizar tu asistencia.');
        }

        const result = await response.json();
        setRsvpButtonState(result.attending);

        if (rsvpCountLabel) {
          rsvpCountLabel.textContent = rsvpCountText(result.count);
        }
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'No se pudo actualizar tu asistencia.');
      } finally {
        rsvpButton.disabled = false;
      }
    });
  </script>
)}

{isOwner && (
  <script>
    const deleteButton = document.getElementById('delete-event-button') as HTMLButtonElement | null;

    deleteButton?.addEventListener('click', async () => {
      const confirmed = window.confirm('¿Seguro que quieres eliminar este evento? Esta acción no se puede deshacer.');

      if (!confirmed) {
        return;
      }

      deleteButton.disabled = true;

      try {
        const response = await fetch(`/api/events/${deleteButton.dataset.eventId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });

        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.error ?? 'No se pudo eliminar el evento.');
        }

        // Quien borra desde "Mis eventos" vuelve ahi con el aviso; el resto
        // cae a la portada. Sin esto, borrar desde la lista siempre devolvia
        // a la home aunque no fuera de donde se venia.
        const volver =
          document.referrer && document.referrer.includes('/mis-eventos')
            ? '/mis-eventos?deleted=true'
            : '/?deleted=true';

        window.location.href = volver;
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'No se pudo eliminar el evento.');
        deleteButton.disabled = false;
      }
    });
  </script>
)}
