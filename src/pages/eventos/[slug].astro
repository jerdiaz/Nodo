---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusToast from '../../components/common/StatusToast.astro';
import ShareButtons from '../../components/events/ShareButtons.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { getCurrentUser } from '../../lib/auth';
import { getEventBySlug } from '../../lib/firebase/events';
import { getGoogleCalendarUrl, getIcsDataUrl } from '../../lib/calendar';
import { formatEventDateLong, formatEventTime } from '../../lib/format';
import { CalendarDays, MapPin, Video } from '@lucide/astro';

const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug).catch(() => null) : null;

if (!event) {
  return new Response(null, { status: 404, statusText: 'Evento no encontrado' });
}

const user = await getCurrentUser(Astro.cookies);
const isOwner = user?.uid === event.organizer.uid;

const physicalLocation = [event.venue, event.address, event.city].filter(Boolean).join(', ');

const tzAbbreviation = new Intl.DateTimeFormat('es', { timeZone: event.timezone, timeZoneName: 'short' })
  .formatToParts(event.startDate)
  .find((part) => part.type === 'timeZoneName')?.value;

const googleCalendarUrl = getGoogleCalendarUrl(event);
const icsDataUrl = getIcsDataUrl(event);
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();

const eventCreated = Astro.url.searchParams.get('created') === 'true';
const eventUpdated = Astro.url.searchParams.get('updated') === 'true';
---

<BaseLayout
  title={`${event.title} — Nodo`}
  description={event.description}
  image={event.bannerUrl}
  type="article"
>
  {eventCreated && <StatusToast paramKey="created" message="¡Evento publicado correctamente!" />}
  {eventUpdated && <StatusToast paramKey="updated" message="Evento actualizado correctamente." />}

  <div class="mx-auto max-w-6xl px-6 pb-24 pt-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <article class="lg:col-span-7">
        <div class="aspect-[16/9] w-full overflow-hidden rounded-2xl bg-gradient-to-br from-neutral-800 via-neutral-900 to-neutral-950">
          {event.bannerUrl && <img src={event.bannerUrl} alt={event.title} class="h-full w-full object-cover" />}
        </div>

        <h1 class="mt-6 text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
          {event.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            {event.organizer.avatarUrl ? (
              <img
                src={event.organizer.avatarUrl}
                alt={event.organizer.name}
                class="size-10 rounded-full object-cover"
              />
            ) : (
              <div class="flex size-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-neutral-400">
                {event.organizer.name.charAt(0).toUpperCase()}
              </div>
            )}
            <div>
              <p class="text-xs text-neutral-500">Organiza</p>
              <p class="font-medium text-neutral-100">{event.organizer.name}</p>
            </div>
          </div>

          {event.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {event.tags.map((tag) => <Badge variant="emerald">{tag}</Badge>)}
            </div>
          )}
        </div>

        <div class="mt-8 max-w-none whitespace-pre-line text-base leading-relaxed text-neutral-300">
          {event.description}
        </div>
      </article>

      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <Card blur class="space-y-6 p-6">
            <div>
              <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-neutral-500">
                <CalendarDays class="size-3.5" stroke-width={2} />
                Fecha y hora
              </div>
              <p class="mt-2 font-semibold capitalize text-neutral-100">
                {formatEventDateLong(event.startDate, event.timezone)}
              </p>
              <p class="text-sm text-neutral-400">
                {formatEventTime(event.startDate, event.timezone)} – {formatEventTime(event.endDate, event.timezone)}
                {tzAbbreviation && ` (${tzAbbreviation})`}
              </p>
              <p
                id="local-time-hint"
                class="mt-1 hidden text-xs text-neutral-600"
                data-event-timezone={event.timezone}
                data-start-iso={event.startDate.toISOString()}
                data-end-iso={event.endDate.toISOString()}
              />
            </div>

            <div class="border-t border-white/10 pt-6">
              <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-neutral-500">
                {event.modality === 'virtual' ? (
                  <Video class="size-3.5" stroke-width={2} />
                ) : (
                  <MapPin class="size-3.5" stroke-width={2} />
                )}
                Ubicación
              </div>

              {event.modality === 'virtual' ? (
                <p class="mt-2 font-medium text-neutral-100">Evento en línea</p>
              ) : (
                <p class="mt-2 font-medium text-neutral-100">{physicalLocation}</p>
              )}

              {event.modality === 'hibrido' && event.meetingUrl && (
                <p class="mt-1 text-sm text-neutral-500">También disponible en línea</p>
              )}

              {event.meetingUrl && event.modality !== 'presencial' && (
                <a
                  href={event.meetingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 block break-all text-sm text-emerald-400 hover:underline"
                >
                  {event.meetingUrl}
                </a>
              )}
            </div>

            <Button
              variant="primary"
              href={googleCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full"
            >
              Añadir a Google Calendar
            </Button>

            <ShareButtons event={event} url={pageUrl} icsUrl={icsDataUrl} />

            {isOwner && (
              <div class="flex items-center justify-between border-t border-white/10 pt-4">
                <a href={`/eventos/${event.slug}/editar`} class="text-sm font-medium text-neutral-400 hover:text-neutral-200">
                  Editar evento
                </a>
                <button
                  id="delete-event-button"
                  type="button"
                  data-event-id={event.id}
                  class="text-sm font-medium text-red-400/80 transition-colors hover:text-red-400 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  Eliminar evento
                </button>
              </div>
            )}
          </Card>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const hint = document.getElementById('local-time-hint');

  if (hint) {
    const eventTimezone = hint.dataset.eventTimezone;
    const browserTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    if (browserTimezone && eventTimezone && browserTimezone !== eventTimezone) {
      const startIso = hint.dataset.startIso;
      const endIso = hint.dataset.endIso;

      if (startIso && endIso) {
        const start = new Date(startIso);
        const end = new Date(endIso);
        const dateFormatter = new Intl.DateTimeFormat('es', { month: 'short', day: 'numeric' });
        const timeFormatter = new Intl.DateTimeFormat('es', { hour: 'numeric', minute: '2-digit', hour12: true });

        hint.textContent = `Tu hora local: ${dateFormatter.format(start)}, ${timeFormatter.format(start)} – ${timeFormatter.format(end)}`;
        hint.classList.remove('hidden');
      }
    }
  }
</script>

{isOwner && (
  <script>
    const deleteButton = document.getElementById('delete-event-button') as HTMLButtonElement | null;

    deleteButton?.addEventListener('click', async () => {
      const confirmed = window.confirm('¿Seguro que quieres eliminar este evento? Esta acción no se puede deshacer.');

      if (!confirmed) {
        return;
      }

      deleteButton.disabled = true;

      try {
        const response = await fetch(`/api/events/${deleteButton.dataset.eventId}`, { method: 'DELETE' });

        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.error ?? 'No se pudo eliminar el evento.');
        }

        window.location.href = '/?deleted=true';
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'No se pudo eliminar el evento.');
        deleteButton.disabled = false;
      }
    });
  </script>
)}
