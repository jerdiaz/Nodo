---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventForm from '../../components/events/EventForm.astro';
import { getCurrentUser } from '../../lib/auth';
import { getCommunityByOwner } from '../../lib/firebase/communities';

const user = await getCurrentUser(Astro.cookies);

if (!user) {
  return Astro.redirect(`/?login=required&destino=${encodeURIComponent(Astro.url.pathname)}`);
}

// Si no administra ninguna, el formulario no dibuja el selector y el evento
// sale a su nombre, como hasta ahora.
const community = await getCommunityByOwner(user.uid).catch(() => null);
---

<BaseLayout title="Publicar evento — Nodo" description="Publica un evento en la cartelera comunitaria de Nodo.">
  <div class="mx-auto max-w-2xl px-6 pb-24 pt-16">
    <div class="text-center">
      <h1 class="text-3xl font-bold tracking-tight text-texto">Publicar evento</h1>
      <p class="mt-2 text-sm text-suave">Completa los datos para publicarlo en la comunidad.</p>
    </div>

    <EventForm community={community} />
  </div>
</BaseLayout>
