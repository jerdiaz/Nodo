---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/events/EmptyState.astro';
import EventCard from '../../components/events/EventCard.astro';
import SocialIcon from '../../components/ui/SocialIcon.astro';
import VerifiedBadge from '../../components/ui/VerifiedBadge.astro';
import { getAccountCreatedAt, getCurrentUser } from '../../lib/auth';
import { getCommunities, isMember } from '../../lib/firebase/communities';
import { getEvents } from '../../lib/firebase/events';
import { getAttendeeFaces } from '../../lib/firebase/rsvps';
import { getUidByUsername, getUserProfile } from '../../lib/firebase/users';
import { formatMonthYear } from '../../lib/format';
import { genColor } from '../../lib/genColor';
import { SOCIAL_FIELDS } from '../../types/profile';
import { CalendarDays, Users } from '@lucide/astro';
import type { NodoEvent } from '../../types/event';
import type { SocialKey } from '../../types/profile';

// La URL lleva el nombre de usuario y no el uid: es lo que la persona eligió y
// puede decir en voz alta, y así el identificador interno de Firebase no acaba
// pegado en cada enlace que se comparte.
const usuario = (Astro.params.usuario ?? '').toLowerCase();
const uid = usuario ? await getUidByUsername(usuario).catch(() => null) : null;
const profile = uid ? await getUserProfile(uid).catch(() => null) : null;

if (!uid || !profile) {
  return new Response(null, { status: 404, statusText: 'Perfil no encontrado' });
}

const visitante = await getCurrentUser(Astro.cookies);
const esSuyo = visitante?.uid === uid;

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

// Solo lo que ha publicado. A qué eventos dice que asiste no se enseña aquí
// aunque en su propio perfil sí aparezca: eso es su agenda, y publicarla a
// quien pase por la URL es contar dónde va a estar.
const publicados = allEvents.filter((event) => event.organizer.uid === uid);
const ahora = Date.now();
const proximos = publicados.filter((event) => event.endDate.getTime() >= ahora);
const pasados = publicados
  .filter((event) => event.endDate.getTime() < ahora)
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

// La pertenencia vive en una subcolección por comunidad, así que saber a
// cuáles pertenece alguien es una lectura por comunidad. Con el puñado que hay
// sale más barato que mantener una lista duplicada en cada usuario; si algún
// día son cientos, habrá que darle la vuelta.
const todas = await getCommunities().catch(() => []);
const comunidades = (
  await Promise.all(
    todas.map(async (comunidad) => ({
      comunidad,
      dentro: comunidad.ownerUid === uid || (await isMember(comunidad.id, uid).catch(() => false)),
    })),
  )
).filter((entrada) => entrada.dentro);

const createdAt = await getAccountCreatedAt(uid).catch(() => null);

const displayName = [profile.firstName, profile.lastName].filter(Boolean).join(' ') || 'Alguien';

interface SocialLink {
  key: SocialKey | 'website';
  href: string;
  tooltip: string;
}

// Las caras de quienes han confirmado, para las tarjetas. Una sola llamada
// para todo lo que la pagina va a pintar: por dentro lanza las consultas a la
// vez y resuelve los perfiles en un unico getAll().
const caras = await getAttendeeFaces(publicados.map((event) => event.id), 4).catch(() => new Map());

const socialLinks: SocialLink[] = SOCIAL_FIELDS.flatMap((field) => {
  const handle = profile.socials?.[field.key];
  return handle
    ? [{ key: field.key, href: `${field.baseUrl}${handle}`, tooltip: `${field.label}: @${handle}` }]
    : [];
});

if (profile.socials?.website) {
  socialLinks.push({
    key: 'website',
    href: profile.socials.website,
    tooltip: profile.socials.website.replace(/^https?:\/\//, ''),
  });
}

const cifras = [
  { valor: publicados.length, etiqueta: publicados.length === 1 ? 'Evento' : 'Eventos' },
  { valor: proximos.length, etiqueta: proximos.length === 1 ? 'Próximo' : 'Próximos' },
  { valor: comunidades.length, etiqueta: comunidades.length === 1 ? 'Comunidad' : 'Comunidades' },
];

const temas = [
  ...publicados
    .flatMap((event) => event.tags)
    .reduce((mapa, etiqueta) => {
      const clave = etiqueta.normalize('NFD').replace(/[^\x00-\x7F]/g, '').toLowerCase().trim();
      if (clave && !mapa.has(clave)) mapa.set(clave, etiqueta.trim());
      return mapa;
    }, new Map<string, string>())
    .values(),
].sort((a, b) => a.localeCompare(b, 'es'));

const secciones = [
  { titulo: 'Próximos eventos', eventos: proximos },
  { titulo: 'Eventos pasados', eventos: pasados },
].filter((seccion) => seccion.eventos.length > 0);
---

<BaseLayout
  title={`${displayName} — Nodo`}
  description={profile.bio?.slice(0, 160) || `Eventos y comunidades de ${displayName} en Nodo.`}
>
  <div class="mx-auto grid max-w-[1200px] gap-8 px-6 pb-24 pt-12 lg:grid-cols-[340px_1fr] lg:gap-12">
    <aside class="lg:sticky lg:top-8 lg:self-start">
      <div class="rounded-3xl bg-superficie p-6 shadow-[var(--c-sombra-alta)]">
        {profile.avatarUrl ? (
          <img src={profile.avatarUrl} alt="" class="size-28 rounded-full object-cover" />
        ) : (
          <div class="flex size-28 items-center justify-center rounded-full bg-fondo-alt text-4xl font-semibold text-texto">
            {displayName.charAt(0).toUpperCase()}
          </div>
        )}

        <h1 class="mt-5 flex flex-wrap items-center gap-x-2 text-2xl font-bold tracking-tight text-texto">
          {displayName}
          {profile.verification && <VerifiedBadge type={profile.verification} class="size-5" />}
        </h1>

        <p class="mt-1 text-sm text-suave">@{profile.username}</p>

        {esSuyo && (
          <a
            href="/configuracion"
            class="mt-3 inline-block text-sm font-semibold text-acento-texto transition hover:opacity-80"
          >
            Editar perfil
          </a>
        )}

        {createdAt && (
          <p class="mt-4 flex items-center gap-2 text-sm text-suave">
            <CalendarDays class="size-4 shrink-0" stroke-width={1.75} />
            Se unió en {formatMonthYear(createdAt)}
          </p>
        )}

        {profile.bio && (
          <p class="mt-4 whitespace-pre-line text-sm leading-6 text-suave">{profile.bio}</p>
        )}

        {socialLinks.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.tooltip}
                class="group relative flex size-9 items-center justify-center rounded-xl border border-linea bg-superficie text-suave transition active:scale-[0.95] hover:border-acento hover:text-texto"
              >
                <SocialIcon name={link.key} class="size-4" />
                <span
                  role="tooltip"
                  class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-acento px-3 py-1.5 text-xs font-medium text-texto shadow-lg group-hover:block group-focus-visible:block"
                >
                  {link.tooltip}
                  <span class="absolute left-1/2 top-full size-2 -translate-x-1/2 -translate-y-1 rotate-45 bg-acento"></span>
                </span>
              </a>
            ))}
          </div>
        )}

        <div class="mt-6 grid grid-cols-3 gap-2 border-t border-linea pt-5 text-center">
          {cifras.map((cifra) => (
            <div>
              <p class="text-xl font-bold text-texto">{cifra.valor}</p>
              <p class="mt-0.5 text-xs text-suave">{cifra.etiqueta}</p>
            </div>
          ))}
        </div>
      </div>
    </aside>

    <div class="min-w-0 space-y-12">
      {comunidades.length > 0 && (
        <section>
          <h2 class="flex items-baseline gap-2 text-2xl font-bold tracking-tight text-texto">
            Comunidades
            <span class="text-base font-medium text-tenue">{comunidades.length}</span>
          </h2>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {comunidades.map(({ comunidad }) => (
              <a
                href={`/comunidades/${comunidad.slug}`}
                class="flex items-center gap-4 rounded-3xl border border-linea bg-superficie p-4 transition active:scale-[0.98] hover:border-acento"
              >
                {comunidad.avatarUrl ? (
                  <img src={comunidad.avatarUrl} alt="" class="size-12 shrink-0 rounded-2xl object-cover" />
                ) : (
                  <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-fondo-alt text-lg font-bold text-texto">
                    {comunidad.name.charAt(0).toUpperCase()}
                  </div>
                )}

                <div class="min-w-0">
                  <p class="truncate font-semibold text-texto">{comunidad.name}</p>
                  <p class="mt-0.5 flex items-center gap-1.5 text-xs text-suave">
                    <Users class="size-3.5 shrink-0" stroke-width={1.75} />
                    {comunidad.ownerUid === uid ? 'Administra' : 'Miembro'}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {temas.length > 0 && (
        <section>
          <h2 class="flex items-baseline gap-2 text-2xl font-bold tracking-tight text-texto">
            Temas de sus eventos
            <span class="text-base font-medium text-tenue">{temas.length}</span>
          </h2>

          <div class="mt-5 flex flex-wrap gap-2">
            {temas.map((tema) => (
              <a
                href={`/?q=${encodeURIComponent(tema)}`}
                data-gen={genColor(tema)}
                class="rounded-full border border-[var(--g)] bg-[var(--g-suave)] px-4 py-2 text-sm font-medium capitalize text-[var(--g-texto)] transition active:scale-[0.97] hover:-translate-y-0.5"
              >
                {tema}
              </a>
            ))}
          </div>
        </section>
      )}

      {secciones.length === 0 ? (
        <EmptyState
          title={esSuyo ? 'Todavía no has publicado eventos' : `${displayName} no ha publicado eventos`}
          description={
            esSuyo
              ? 'Cuando publiques uno, aparecerá aquí para quien visite tu perfil.'
              : 'Cuando publique alguno, aparecerá aquí.'
          }
        />
      ) : (
        secciones.map((seccion) => (
          <section>
            <h2 class="flex items-baseline gap-2 text-2xl font-bold tracking-tight text-texto">
              {seccion.titulo}
              <span class="text-base font-medium text-tenue">{seccion.eventos.length}</span>
            </h2>

            <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
              {seccion.eventos.map((event) => <EventCard event={event} attendees={caras.get(event.id)} />)}
            </div>
          </section>
        ))
      )}
    </div>
  </div>
</BaseLayout>
