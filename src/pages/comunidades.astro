---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import { getEvents } from '../lib/firebase/events';
import type { EventOrganizer, NodoEvent } from '../types/event';

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

interface CommunityEntry {
  organizer: EventOrganizer;
  eventCount: number;
  upcomingEvents: NodoEvent[];
}

const now = Date.now();
const communities = new Map<string, CommunityEntry>();

for (const event of allEvents) {
  const isUpcoming = event.endDate.getTime() >= now;
  const existing = communities.get(event.organizer.uid);

  if (existing) {
    existing.eventCount += 1;
    if (isUpcoming) {
      existing.upcomingEvents.push(event);
    }
  } else {
    communities.set(event.organizer.uid, {
      organizer: event.organizer,
      eventCount: 1,
      upcomingEvents: isUpcoming ? [event] : [],
    });
  }
}

const communityList = [...communities.values()].sort((a, b) => b.eventCount - a.eventCount);
---

<BaseLayout title="Comunidades — Nodo" description="Comunidades y organizadores activos en Nodo.">
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-16">
    <p class="text-sm font-medium text-emerald-400">Comunidades</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-100">Quién organiza en Nodo</h1>
    <p class="mt-3 max-w-xl text-neutral-400">Conoce a las personas y comunidades detrás de los eventos publicados.</p>

    {
      communityList.length === 0 ? (
        <div class="mt-12">
          <EmptyState
            title="Aún no hay comunidades"
            description="Cuando se publiquen eventos, sus organizadores aparecerán aquí."
          />
        </div>
      ) : (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {communityList.map((community) => (
            <div class="rounded-3xl border border-white/[0.08] bg-neutral-900/40 p-6 shadow-[0_1px_1px_rgba(0,0,0,0.3),0_12px_28px_-10px_rgba(0,0,0,0.55)]">
              <div class="flex items-center gap-3">
                {community.organizer.avatarUrl ? (
                  <img
                    src={community.organizer.avatarUrl}
                    alt={community.organizer.name}
                    class="size-14 rounded-full object-cover"
                  />
                ) : (
                  <div class="flex size-14 items-center justify-center rounded-full bg-neutral-800 text-lg font-medium text-neutral-300">
                    {community.organizer.name.charAt(0).toUpperCase()}
                  </div>
                )}
                <div>
                  <p class="font-semibold text-neutral-100">{community.organizer.name}</p>
                  <p class="text-sm text-neutral-500">
                    {community.eventCount} {community.eventCount === 1 ? 'evento publicado' : 'eventos publicados'}
                  </p>
                </div>
              </div>

              {community.upcomingEvents.length > 0 && (
                <div class="mt-5 space-y-2 border-t border-white/[0.08] pt-4">
                  <p class="text-xs font-medium uppercase tracking-wide text-neutral-600">Próximos eventos</p>
                  {community.upcomingEvents.slice(0, 3).map((event) => (
                    <a
                      href={`/eventos/${event.slug}`}
                      class="block truncate text-sm text-neutral-300 transition hover:text-emerald-400"
                    >
                      {event.title}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
