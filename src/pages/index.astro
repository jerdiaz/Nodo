---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import EventCard from '../components/events/EventCard.astro';
import EventFilter from '../components/events/EventFilter.astro';
import SecondaryFilters from '../components/events/SecondaryFilters.astro';
import StatusToast from '../components/common/StatusToast.astro';
import Franja from '../components/common/Franja.astro';
import { Search, MapPin, Video } from '@lucide/astro';
import { filterEvents, getEvents } from '../lib/firebase/events';
import { buildFilterHref } from '../lib/eventFilterHref';
import { genColor } from '../lib/genColor';
import { getInstagramPosts } from '../lib/firebase/instagram';
import type { InstagramPost } from '../lib/firebase/instagram';
import SocialIcon from '../components/ui/SocialIcon.astro';
import type { NodoEvent } from '../types/event';

const modalidad = Astro.url.searchParams.get('modalidad') ?? undefined;
const ciudad = Astro.url.searchParams.get('ciudad') ?? undefined;
const query = Astro.url.searchParams.get('q') ?? undefined;
const timeframe: 'upcoming' | 'past' = Astro.url.searchParams.get('tiempo') === 'pasados' ? 'past' : 'upcoming';

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

const timeframeEvents = filterEvents(allEvents, { timeframe });
const cities = [
  ...new Set(timeframeEvents.filter((event) => event.city).map((event) => event.city as string)),
].sort((a, b) => a.localeCompare(b, 'es'));

const events = filterEvents(allEvents, { modality: modalidad, city: ciudad, timeframe, search: query });
const hasActiveFilters = Boolean(modalidad || ciudad || query);

// La home tiene dos caras. Sin filtros es una portada: carriles por modalidad,
// categorias y explicacion, para que quien llega de cero vea contenido real sin
// tocar nada. En cuanto hay un filtro, una busqueda o se piden los pasados, pasa
// a ser una pagina de resultados: un solo listado, que es lo que se espera
// cuando uno ha preguntado algo concreto.
const vistaResultados = hasActiveFilters || timeframe === 'past';

const proximos = filterEvents(allEvents, { timeframe: 'upcoming' });

// Los hibridos van con los presenciales: tienen sitio y ciudad, y quien busca
// algo cerca los quiere ver. En el carril en linea solo entra lo puramente
// virtual, para que ningun evento salga dos veces en la misma pagina.
const presenciales = proximos.filter((event) => event.modality !== 'virtual');
const virtuales = proximos.filter((event) => event.modality === 'virtual');

// Dos filas de tres en pantalla ancha. Lo que sobra vive detras de "Ver todos",
// que lleva al mismo listado filtrado de siempre.
const LIMITE_CARRIL = 6;

const categorias = [...new Set(proximos.flatMap((event) => event.tags))]
  .sort((a, b) => a.localeCompare(b, 'es'))
  .slice(0, 12);

const pasos = [
  {
    color: 'rojo' as const,
    titulo: 'Descubre lo que pasa cerca',
    texto: 'Talleres, encuentros y convocatorias de las comunidades de la red, en un solo sitio.',
  },
  {
    color: 'azul' as const,
    titulo: 'Confirma tu asistencia',
    texto: 'Guarda el evento en tu calendario y suscríbete para no perderte lo que viene.',
  },
  {
    color: 'magenta' as const,
    titulo: 'Publica lo tuyo',
    texto: '¿Organizas algo? Publícalo y llega a quien todavía no te conoce.',
  },
];

const loginRequired = Astro.url.searchParams.get('login') === 'required';
const eventDeleted = Astro.url.searchParams.get('deleted') === 'true';

// Publicaciones de Instagram, cacheadas en Firestore por /api/instagram/sync.
// Se lee de ahi y no de Instagram: consultar en cada visita gastaria cuota y
// ataria el tiempo de respuesta de la home a un servicio ajeno.
//
// Apagado a proposito hasta que existan las credenciales de la Graph API.
// Es un interruptor explicito y no "se oculta si no hay datos": asi la seccion
// no aparece sola el dia que alguien sincronice, y encenderla es esta linea.
// Con el interruptor apagado tampoco se consulta Firestore, que es una lectura
// menos en cada carga de la home.
const MOSTRAR_PUBLICACIONES = false;

let posts: InstagramPost[] = [];

if (MOSTRAR_PUBLICACIONES) {
  try {
    posts = await getInstagramPosts(10);
  } catch (error) {
    console.warn('No se pudieron obtener las publicaciones de Instagram:', error);
  }
}
---

<BaseLayout>
  {loginRequired && (
    <div class="mx-auto max-w-6xl px-6 pt-6">
      <div class="rounded-2xl border border-marca-amarillo bg-fondo-alt px-4 py-3 text-sm text-texto backdrop-blur-xl">
        Inicia sesión para publicar un evento.
      </div>
    </div>
  )}

  {eventDeleted && <StatusToast paramKey="deleted" message="Evento eliminado correctamente." />}

  <!--
    Portada corta a proposito: lo que convence de quedarse son los eventos
    reales, no el titular. Por eso el hero no llena la pantalla y el primer
    carril empieza casi en la linea de flotacion.
  -->
  <section class="mx-auto max-w-3xl px-6 pb-10 pt-14 text-center">
    <p class="text-sm font-medium text-acento-texto">Cartelera comunitaria</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-texto sm:text-5xl">
      Encuentra tu próximo evento
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-suave">
      Nodo conecta a tu comunidad con talleres, encuentros y actividades locales.
      Descubre lo que está pasando cerca de ti.
    </p>

    <form method="get" action="/" class="mx-auto mt-8 max-w-xl">
      {modalidad && <input type="hidden" name="modalidad" value={modalidad} />}
      {ciudad && <input type="hidden" name="ciudad" value={ciudad} />}
      {timeframe === 'past' && <input type="hidden" name="tiempo" value="pasados" />}
      <div class="relative">
        <Search
          class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-tenue"
          stroke-width={1.75}
        />
        <input
          type="text"
          name="q"
          value={query ?? ''}
          placeholder="Buscar por nombre, tema o tag..."
          class="w-full rounded-full bg-superficie py-3 pl-11 pr-4 text-sm text-texto ring-1 ring-inset ring-linea placeholder:text-tenue focus:outline-none focus:ring-2 focus:ring-acento"
        />
      </div>
    </form>

    {vistaResultados && (
      <div class="mt-6">
        <EventFilter
          selectedModality={modalidad}
          selectedCity={ciudad}
          selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
          selectedSearch={query}
        />
      </div>
    )}
  </section>

  {vistaResultados ? (
    <section class="mx-auto max-w-6xl px-6 pb-24 pt-4">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-semibold text-texto">
            {timeframe === 'past' ? 'Eventos pasados' : 'Resultados'}
          </h2>
          <span class="text-sm text-suave">{events.length} eventos</span>
        </div>
        <SecondaryFilters
          cities={cities}
          selectedModality={modalidad}
          selectedCity={ciudad}
          selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
          selectedSearch={query}
        />
      </div>

      {events.length === 0 ? (
        timeframe === 'past' ? (
          <EmptyState
            title="No hay eventos pasados"
            description="Todavía no se ha realizado ningún evento con estos filtros."
          />
        ) : (
          <EmptyState
            title="No hay eventos para esta búsqueda"
            description="Prueba con otro filtro o vuelve a explorar todos los eventos."
          />
        )
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      )}
    </section>
  ) : proximos.length === 0 ? (
    <section class="mx-auto max-w-6xl px-6 pb-24 pt-4">
      <EmptyState />
    </section>
  ) : (
    <>
      <!--
        Un carril por modalidad en vez de un filtro. Con poco inventario dos
        secciones llenan la pagina y no exigen que nadie haga clic para ver la
        mitad del catalogo; el filtro sigue existiendo en la vista de
        resultados, para quien busca algo concreto.
      -->
      {presenciales.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 pt-6">
          <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">
                <MapPin class="size-3.5" stroke-width={2} />
                Presenciales
              </p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Eventos cerca de ti</h2>
            </div>

            <div class="flex flex-wrap gap-2 sm:justify-end">
              {cities.map((city) => (
                <a
                  href={buildFilterHref({ city })}
                  data-gen={genColor(city)}
                  class="rounded-full border border-linea bg-superficie px-3 py-1 text-xs font-medium text-suave transition hover:border-[var(--g)] hover:text-texto"
                >
                  {city}
                </a>
              ))}
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {presenciales.slice(0, LIMITE_CARRIL).map((event) => (
              <EventCard event={event} />
            ))}
          </div>

          {presenciales.length > LIMITE_CARRIL && (
            <div class="mt-6 text-center">
              <a
                href={buildFilterHref({ modality: 'presencial' })}
                class="inline-flex items-center rounded-full border border-linea px-5 py-2 text-sm font-medium text-suave transition hover:border-acento hover:text-acento-texto"
              >
                Ver todos los presenciales
              </a>
            </div>
          )}
        </section>
      )}

      {virtuales.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 pt-16">
          <div class="mb-6">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">
              <Video class="size-3.5" stroke-width={2} />
              En línea
            </p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Próximos eventos virtuales</h2>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {virtuales.slice(0, LIMITE_CARRIL).map((event) => (
              <EventCard event={event} />
            ))}
          </div>

          {virtuales.length > LIMITE_CARRIL && (
            <div class="mt-6 text-center">
              <a
                href={buildFilterHref({ modality: 'virtual' })}
                class="inline-flex items-center rounded-full border border-linea px-5 py-2 text-sm font-medium text-suave transition hover:border-acento hover:text-acento-texto"
              >
                Ver todos los virtuales
              </a>
            </div>
          )}
        </section>
      )}

      <div class="pt-20">
        <Franja
          titulo="¿Tu comunidad organiza algo?"
          cta="Publicar evento"
          href="/eventos/nuevo"
          color="azul"
        />
      </div>

      <!--
        Las categorias salen de las etiquetas reales de los eventos publicados,
        no de una lista fija: una categoria vacia es una promesa que la pagina
        no cumple. El color lo da genColor sobre el propio texto, asi que la
        etiqueta "tecnologia" es del mismo color aqui y en su tarjeta.

        El hover no rellena el chip con --g ni invierte a texto blanco: sobre el
        amarillo eso da 1.2:1, y en tema oscuro los seis colores son pasteles
        claros, asi que fallaria en todos. Se mantiene el par --g-texto sobre
        --g-suave, que si esta calculado para cumplir contraste en ambos temas,
        y el hover se nota por elevacion.
      -->
      {categorias.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 py-16">
          <h2 class="text-2xl font-bold tracking-tight text-texto">Explora por categoría</h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {categorias.map((categoria) => (
              <a
                href={buildFilterHref({ search: categoria })}
                data-gen={genColor(categoria)}
                class="rounded-full border-2 border-[var(--g)] bg-[var(--g-suave)] px-4 py-2 text-sm font-medium text-[var(--g-texto)] shadow-sm transition active:scale-[0.97] hover:-translate-y-0.5 hover:shadow-md"
              >
                {categoria}
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="border-y border-linea bg-fondo-alt">
        <div class="mx-auto max-w-6xl px-6 py-16">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">Qué es Nodo</p>
          <h2 class="mt-3 max-w-2xl text-2xl font-bold tracking-tight text-texto sm:text-3xl">
            La cartelera del ecosistema, en un solo sitio
          </h2>
          <p class="mt-4 max-w-prose text-suave">
            Talleres, encuentros y convocatorias que organizan las comunidades de la red. Publicados por
            quienes los hacen, abiertos a quien quiera llegar.
          </p>

          <ol class="mt-10 grid gap-8 md:grid-cols-3">
            {pasos.map((paso, indice) => (
              <li data-gen={paso.color} class="border-t-4 border-[var(--g)] pt-4">
                <span class="text-sm font-bold text-[var(--g-texto)]">
                  {String(indice + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-texto">{paso.titulo}</h3>
                <p class="mt-2 text-sm text-suave">{paso.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </>
  )}

  <!--
    Solo aparece si hay publicaciones sincronizadas: una seccion vacia con un
    "proximamente" es peor que no tener seccion.
  -->
  {posts.length > 0 && (
    <>
      <Franja titulo="Lo que se cuenta en la red" color="magenta" />

      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">Publicaciones</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Desde Instagram</h2>
          </div>
          <a
            href="https://www.instagram.com/redglobalcol/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-suave transition hover:text-acento-texto"
          >
            <SocialIcon name="instagram" class="size-4" />
            @redglobalcol
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
          {posts.map((post) => (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-square overflow-hidden rounded-2xl border border-linea bg-fondo-alt"
            >
              <img
                src={post.imageUrl}
                alt={post.caption.slice(0, 120) || 'Publicación de Instagram'}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              {post.caption && (
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#111113]/85 to-transparent p-3 pt-10 text-xs leading-snug text-white opacity-0 transition group-hover:opacity-100">
                  <span class="line-clamp-3 block">{post.caption}</span>
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
