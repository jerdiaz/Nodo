---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import EventCard from '../components/events/EventCard.astro';
import EventFilter from '../components/events/EventFilter.astro';
import SecondaryFilters from '../components/events/SecondaryFilters.astro';
import StatusToast from '../components/common/StatusToast.astro';
import Franja from '../components/common/Franja.astro';
import {
  ArrowUpRight,
  BookOpen,
  Briefcase,
  Dumbbell,
  Film,
  Gamepad2,
  GraduationCap,
  Heart,
  Laptop,
  MapPin,
  Send,
  Music,
  Palette,
  PartyPopper,
  Pencil,
  Scissors,
  Sparkles,
  Telescope,
  Ticket,
  Users,
  UtensilsCrossed,
  Video,
} from '@lucide/astro';
import { filterEvents, getEvents, getFilterCities } from '../lib/firebase/events';
import { buildFilterHref } from '../lib/eventFilterHref';
import { genColor } from '../lib/genColor';
import { getInstagramPosts } from '../lib/firebase/instagram';
import type { InstagramPost } from '../lib/firebase/instagram';
import SocialIcon from '../components/ui/SocialIcon.astro';
import type { NodoEvent } from '../types/event';

const modalidad = Astro.url.searchParams.get('modalidad') ?? undefined;
const ciudad = Astro.url.searchParams.get('ciudad') ?? undefined;
const query = Astro.url.searchParams.get('q') ?? undefined;
const timeframe: 'upcoming' | 'past' = Astro.url.searchParams.get('tiempo') === 'pasados' ? 'past' : 'upcoming';

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

const timeframeEvents = filterEvents(allEvents, { timeframe });
const cities = getFilterCities(timeframeEvents);

const events = filterEvents(allEvents, { modality: modalidad, city: ciudad, timeframe, search: query });

// La home tiene dos caras. Sin filtros es una portada: carriles por modalidad,
// categorias y explicacion, para que quien llega de cero vea contenido real sin
// tocar nada. En cuanto hay un filtro, una busqueda o se piden los pasados, pasa
// a ser una pagina de resultados: un solo listado, que es lo que se espera
// cuando uno ha preguntado algo concreto.
const vistaResultados = Boolean(modalidad || query) || timeframe === 'past';

const proximos = filterEvents(allEvents, { timeframe: 'upcoming' });

// Los hibridos van con los presenciales: tienen sitio y ciudad, y quien busca
// algo cerca los quiere ver. En el carril en linea solo entra lo puramente
// virtual, para que ningun evento salga dos veces en la misma pagina.
const presencialesTodos = proximos.filter((event) => event.modality !== 'virtual');
const presenciales = ciudad ? filterEvents(presencialesTodos, { city: ciudad }) : presencialesTodos;
const virtuales = proximos.filter((event) => event.modality === 'virtual');

// Cuatro por fila y una sola fila, como los carriles de Meetup. Lo que sobra
// vive detras de "Ver todos los eventos", que lleva al listado completo.
const LIMITE_CARRIL = 4;

// En telefono las tarjetas van en una sola columna, asi que la cuarta solo
// alarga el scroll antes de llegar al resto de la pagina.
const LIMITE_MOVIL = 3;

// Las etiquetas se guardan tal como las teclea quien publica, asi que "fiesta"
// y "Fiesta" conviven y salian como dos categorias distintas. Se agrupan sin
// distinguir mayusculas ni tildes -misma regla que ya usa la ciudad- y se
// muestra la primera forma que aparecio, que el CSS capitaliza.
// Un icono por tema, buscando por trozo de palabra y no por igualdad: las
// etiquetas las escribe cada quien, asi que "tecnologia", "tech" y
// "programacion" tienen que caer en el mismo sitio. Lo que no reconoce se
// queda con el icono generico, que es mejor que forzar uno que no pega.
const ICONOS_CATEGORIA = [
  { claves: ['comida', 'gastro', 'cocina', 'food'], Icono: UtensilsCrossed },
  { claves: ['fiesta', 'rumba', 'party', 'celebra'], Icono: PartyPopper },
  { claves: ['tecno', 'tech', 'program', 'software', 'dev', 'ia', 'datos'], Icono: Laptop },
  { claves: ['arte', 'ceramica', 'pintura', 'diseno'], Icono: Palette },
  { claves: ['music', 'concierto', 'banda'], Icono: Music },
  { claves: ['deporte', 'fitness', 'running', 'yoga'], Icono: Dumbbell },
  { claves: ['network', 'meet', 'encuentro', 'comunidad'], Icono: Users },
  { claves: ['emprend', 'negocio', 'startup', 'feria'], Icono: Briefcase },
  { claves: ['manualidad', 'taller', 'craft'], Icono: Scissors },
  { claves: ['educa', 'curso', 'clase', 'charla'], Icono: GraduationCap },
  { claves: ['salud', 'bienestar', 'mental'], Icono: Heart },
  { claves: ['libro', 'lectura', 'club de'], Icono: BookOpen },
  { claves: ['cine', 'pelicula', 'audiovisual'], Icono: Film },
  { claves: ['juego', 'game', 'trivia'], Icono: Gamepad2 },
];

function iconoCategoria(etiqueta: string) {
  const clave = etiqueta.normalize('NFD').replace(/[^\x00-\x7F]/g, '').toLowerCase();
  return ICONOS_CATEGORIA.find((entrada) => entrada.claves.some((c) => clave.includes(c)))?.Icono ?? Sparkles;
}

const categorias = [
  ...proximos
    .flatMap((event) => event.tags)
    .reduce((mapa, etiqueta) => {
      const clave = etiqueta.normalize('NFD').replace(/[^\x00-\x7F]/g, '').toLowerCase().trim();
      if (clave && !mapa.has(clave)) mapa.set(clave, etiqueta.trim());
      return mapa;
    }, new Map<string, string>())
    .values(),
]
  .sort((a, b) => a.localeCompare(b, 'es'))
  .slice(0, 12)
  .map((nombre) => ({ nombre, color: genColor(nombre), Icono: iconoCategoria(nombre) }));

// Collage del banner: cuatro recortes con la etiqueta ya rotulada dentro de la
// imagen. La lista es fija y no sale de las etiquetas de los eventos, porque el
// rotulo va pintado en el archivo y no puede seguir a un dato que cambia.
//
// Cada pieza se coloca dentro de su columna lateral, no respecto a la ventana:
// la columna es la que se ancla al texto. Dentro, las de arriba se pegan al
// borde exterior y las de abajo al interior, para que la pareja quede
// escalonada en vez de apilada.
//
// Las dimensiones son las reales de cada archivo, no un cuadrado comodin: van
// en el HTML para que el navegador reserve el hueco con la proporcion correcta
// y el texto no salte cuando cargan.
const collage = [
  { src: '/banner/comida.webp', ancho: 700, alto: 533, lado: 'izquierda', sitio: 'left-0 top-0 w-[240px] -rotate-3' },
  { src: '/banner/arte.webp', ancho: 700, alto: 694, lado: 'izquierda', sitio: 'right-0 bottom-2 w-[250px] rotate-4' },
  { src: '/banner/fiesta.webp', ancho: 700, alto: 592, lado: 'derecha', sitio: 'right-0 top-0 w-[240px] rotate-3' },
  { src: '/banner/tecnologia.webp', ancho: 700, alto: 581, lado: 'derecha', sitio: 'left-0 bottom-2 w-[250px] -rotate-4' },
];

// Iconos sueltos alrededor del titular. El titular ocupa tres lineas de
// distinto ancho y deja unos 100-150px de aire a cada lado dentro de la propia
// columna: ahi caben sin tocar el texto, y el hueco deja de leerse vacio.
//
// Son los mismos iconos y los mismos colores del anillo de GEN que usan las
// tarjetas de categoria, para que la portada hable un solo idioma. La lista es
// fija: no representan datos, son decoracion, y por eso van con aria-hidden.
const iconosBanner = [
  { Icono: Palette, color: 'magenta', sitio: 'left-[18px] top-[2px] -rotate-6' },
  { Icono: Users, color: 'celeste', sitio: 'right-[6px] top-[30px] rotate-6' },
  { Icono: GraduationCap, color: 'naranja', sitio: 'left-[22px] top-[84px] rotate-3' },
  { Icono: Music, color: 'azul', sitio: 'right-[18px] top-[92px] -rotate-3' },
] as const;

// Ilustracion de fondo de la tarjeta de cierre, una sola imagen como la de
// Meetup. Venia con el damero de transparencia pintado y con las esquinas ya
// redondeadas: se recorto el rectangulo interior -detectando donde el patron
// deja de alternar- y el radio se lo pone el CSS, que asi no depende de que la
// imagen traiga el suyo.
const FONDO_UNETE = '/banner/unete.webp';

const pasos = [
  {
    color: 'rojo' as const,
    Icono: Telescope,
    titulo: 'Descubre lo que pasa cerca',
    texto: 'Talleres, encuentros y convocatorias de las comunidades de la red, en un solo sitio.',
    enlace: 'Explorar eventos',
    href: '/',
  },
  {
    color: 'azul' as const,
    Icono: Ticket,
    titulo: 'Confirma tu asistencia',
    texto: 'Guarda el evento en tu calendario y suscríbete para no perderte lo que viene.',
    enlace: 'Ver el calendario',
    href: '/calendario',
  },
  {
    color: 'magenta' as const,
    Icono: Send,
    titulo: 'Publica lo tuyo',
    texto: '¿Organizas algo? Publícalo y llega a quien todavía no te conoce.',
    enlace: 'Publicar evento',
    href: '/eventos/nuevo',
  },
];

const GEN_DESTACADAS = ['rojo', 'azul', 'magenta'] as const;

// Quien mas publica va primero. Se agrupa sobre los eventos que ya estan en
// memoria, asi que esta seccion no cuesta ninguna lectura extra de Firestore.
//
// La clave es la comunidad cuando el evento se publico en su nombre, y la
// persona cuando no: asi una comunidad no aparece partida en dos filas segun
// quien de sus eventos se mire.
const comunidades = [...proximos.reduce((mapa, evento) => {
  const autor = evento.community ?? evento.organizer;
  const clave = evento.community?.id ?? evento.organizer.uid;
  const enlace = evento.community ? `/comunidades/${evento.community.slug}` : '/comunidades';
  const actual = mapa.get(clave);

  if (actual) {
    actual.total += 1;
  } else {
    mapa.set(clave, { autor, enlace, total: 1, proximo: evento });
  }

  return mapa;
}, new Map<string, { autor: { name: string; avatarUrl?: string }; enlace: string; total: number; proximo: NodoEvent }>()).values()]
  .sort((a, b) => b.total - a.total)
  .slice(0, 3)
  .map((entrada, indice) => ({ ...entrada, color: GEN_DESTACADAS[indice]! }));

// El zigzag sobre una rejilla de 12: arriba a la izquierda, arriba a la derecha
// un poco mas abajo, y el tercero centrado debajo. Es lo que hace que se lean
// como pasos en orden y no como tres opciones sueltas.
const posicionesPaso = [
  'lg:col-span-5 lg:col-start-1',
  'lg:col-span-5 lg:col-start-8 lg:mt-10',
  'lg:col-span-5 lg:col-start-4 lg:mt-14',
];

const eventDeleted = Astro.url.searchParams.get('deleted') === 'true';

// Publicaciones de Instagram, cacheadas en Firestore por /api/instagram/sync.
// Se lee de ahi y no de Instagram: consultar en cada visita gastaria cuota y
// ataria el tiempo de respuesta de la home a un servicio ajeno.
//
// Apagado a proposito hasta que existan las credenciales de la Graph API.
// Es un interruptor explicito y no "se oculta si no hay datos": asi la seccion
// no aparece sola el dia que alguien sincronice, y encenderla es esta linea.
// Con el interruptor apagado tampoco se consulta Firestore, que es una lectura
// menos en cada carga de la home.
const MOSTRAR_PUBLICACIONES = false;

let posts: InstagramPost[] = [];

if (MOSTRAR_PUBLICACIONES) {
  try {
    posts = await getInstagramPosts(10);
  } catch (error) {
    console.warn('No se pudieron obtener las publicaciones de Instagram:', error);
  }
}
---

<BaseLayout>
  {eventDeleted && <StatusToast paramKey="deleted" message="Evento eliminado correctamente." />}

  {/*
    Banner al modo de Meetup: una columna de 680px centrada con titular,
    parrafo y una sola llamada a la accion. Sus medidas exactas — 40/48 en el
    titular, 16/24 en el parrafo, 46px de alto en el boton.

    Sin buscador: ya vive en la cabecera, y repetirlo aqui obligaba a decidir
    cual de los dos manda. Meetup tampoco lo duplica.

    El collage lateral ocupa el sitio del suyo: dos recortes por lado, colgados
    de la columna de texto.
  */}
  <section class="relative overflow-hidden px-6 pb-14 pt-24">
    {/*
      Las columnas laterales cuelgan de la columna de texto, no de los filos de
      la ventana: es lo que hace Meetup, cuyas piezas se quedan a 12px del texto
      tanto a 1440 como a 1800. Anclarlas al filo las dejaba pegadas a las
      esquinas y con un hueco creciente en el medio segun se ensancha la
      pantalla.

      El umbral es 1380 y no un breakpoint redondo porque es la cuenta exacta:
      680 de texto mas dos columnas de 310 con 20px de aire cada una. Por
      debajo no caben sin invadir el titular.
    */}
    <div
      class="pointer-events-none absolute inset-x-0 top-10 mx-auto hidden h-[450px] w-[680px] min-[1380px]:block"
      aria-hidden="true"
    >
      {['izquierda', 'derecha'].map((lado) => (
        <div
          class:list={[
            'absolute top-0 h-full w-[310px]',
            lado === 'izquierda' ? '-left-[330px]' : '-right-[330px]',
          ]}
        >
          {collage
            .filter((pieza) => pieza.lado === lado)
            .map((pieza) => (
              <img
                src={pieza.src}
                alt=""
                width={pieza.ancho}
                height={pieza.alto}
                loading="eager"
                class:list={['absolute', pieza.sitio]}
              />
            ))}
        </div>
      ))}
    </div>

    <div class="relative mx-auto max-w-[680px] text-center">
      {/*
        Aparecen desde md porque por debajo la columna se estrecha, el titular
        reparte las lineas de otra forma y los iconos se le meterian encima.
      */}
      {iconosBanner.map(({ Icono, color, sitio }) => (
        <div
          data-gen={color}
          aria-hidden="true"
          class:list={[
            'pointer-events-none absolute hidden size-14 place-items-center rounded-2xl bg-superficie shadow-[var(--c-sombra)] md:grid',
            sitio,
          ]}
        >
          <Icono class="size-6 text-[var(--g)]" stroke-width={1.75} />
        </div>
      ))}

      {/*
        Tres lineas y cuatro de parrafo no son un capricho: es lo que ocupa el
        titular de Meetup, y sin ese cuerpo el banner se queda en poco mas de la
        mitad de su alto. El texto sale del vocabulario que ya usa Nodo en la
        seccion Que es Nodo, pero es una propuesta: el copy de marca lo decide
        la casa, y cambiarlo aqui no toca ninguna medida.
      */}
      <h1 class="text-[40px] font-bold leading-[48px] text-texto">
        Talleres, encuentros<br />
        y convocatorias de la red,<br />
        en <span class="text-acento-texto">una sola cartelera</span>.
      </h1>
      <p class="mx-auto mt-5 text-base leading-6 tracking-[0.02em] text-suave">
        Nodo reúne lo que organizan las comunidades del ecosistema: talleres, encuentros
        y actividades locales, publicados por quienes los hacen y abiertos a quien quiera
        llegar. Descubre lo que está pasando cerca de ti, guárdalo en tu calendario y
        confirma tu asistencia.
      </p>

      <a
        href="/eventos/nuevo"
        class="mt-8 inline-flex h-[46px] items-center rounded-full bg-acento px-6 text-base font-semibold tracking-[0.02em] text-acento-contraste transition active:scale-[0.97] hover:opacity-90"
      >
        Publicar evento
      </a>

      {/*
        En movil las columnas laterales no caben, y dejarlas ocultas del todo
        significaba que la ilustracion no se veia nunca en telefono. Meetup
        resuelve lo mismo bajando una pieza del collage debajo del boton; aqui
        van dos, que es lo que llena el ancho sin obligar a hacer scroll de mas.
      */}
      <div class="mt-12 flex items-start justify-center gap-6 min-[1380px]:hidden">
        {collage.slice(0, 2).map((pieza, indice) => (
          <img
            src={pieza.src}
            alt=""
            aria-hidden="true"
            width={pieza.ancho}
            height={pieza.alto}
            loading="lazy"
            class:list={[
              'max-w-[300px]',
              // En telefono va una sola y grande, como la suya: dos repartidas
              // en 375px salen a 150px y no se distingue lo que hay dentro.
              // Desde sm caben las dos.
              indice === 0 ? 'w-[80%] -rotate-3 sm:w-[45%]' : 'hidden sm:mt-10 sm:block sm:w-[45%] sm:rotate-3',
            ]}
          />
        ))}
      </div>

      {vistaResultados && (
        <div class="mt-8">
          <EventFilter
            selectedModality={modalidad}
            selectedCity={ciudad}
            selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
            selectedSearch={query}
          />
        </div>
      )}
    </div>
  </section>

  {vistaResultados ? (
    <section class="mx-auto max-w-[1200px] px-6 pb-24 pt-4">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex items-center gap-3">
          <h2 class="text-lg font-semibold text-texto">
            {timeframe === 'past' ? 'Eventos pasados' : 'Resultados'}
          </h2>
          <span class="text-sm text-suave">{events.length} eventos</span>
        </div>
        <SecondaryFilters
          cities={cities}
          selectedModality={modalidad}
          selectedCity={ciudad}
          selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
          selectedSearch={query}
        />
      </div>

      {events.length === 0 ? (
        timeframe === 'past' ? (
          <EmptyState
            title="No hay eventos pasados"
            description="Todavía no se ha realizado ningún evento con estos filtros."
          />
        ) : (
          <EmptyState
            title="No hay eventos para esta búsqueda"
            description="Prueba con otro filtro o vuelve a explorar todos los eventos."
          />
        )
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      )}
    </section>
  ) : proximos.length === 0 ? (
    <section class="mx-auto max-w-[1200px] px-6 pb-24 pt-4">
      <EmptyState />
    </section>
  ) : (
    <>
      <!--
        Un carril por modalidad en vez de un filtro. Con poco inventario dos
        secciones llenan la pagina y no exigen que nadie haga clic para ver la
        mitad del catalogo; el filtro sigue existiendo en la vista de
        resultados, para quien busca algo concreto.
      -->
      {presenciales.length > 0 && (
        <section class="mx-auto max-w-[1200px] px-6 pt-6">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">
                <MapPin class="size-3.5" stroke-width={2} />
                Presenciales
              </p>

              {/*
                La ciudad va dentro del titular y no en una fila de chips
                aparte: asi la seccion dice de que esta hablando en vez de
                obligar a mirar cual de los filtros esta activo. El lapiz abre
                la lista, como en Meetup.
              */}
              <div class="mt-2 flex items-center gap-2">
                <h2 class="text-2xl font-bold tracking-tight text-texto">
                  Eventos cerca de{' '}
                  <span class="text-acento-texto">{ciudad ?? 'ti'}</span>
                </h2>

                {cities.length > 0 && (
                  <details class="group relative">
                    {/*
                      list-none quita el triangulito que el navegador pone por
                      su cuenta en el summary.
                    */}
                    <summary
                      class="flex size-8 cursor-pointer list-none items-center justify-center rounded-full text-suave transition hover:bg-fondo-alt hover:text-texto"
                      aria-label="Cambiar de ciudad"
                    >
                      <Pencil class="size-4" stroke-width={2} />
                    </summary>

                    <div class="absolute left-0 top-full z-20 mt-2 w-56 overflow-hidden rounded-2xl border border-linea bg-superficie p-2 shadow-[var(--c-sombra)]">
                      <a
                        href={buildFilterHref({})}
                        class:list={[
                          'block rounded-xl px-3 py-2 text-sm transition hover:bg-fondo-alt',
                          ciudad ? 'text-suave' : 'font-semibold text-acento-texto',
                        ]}
                      >
                        Todas las ciudades
                      </a>
                      {cities.map((city) => (
                        <a
                          href={buildFilterHref({ city })}
                          class:list={[
                            'block rounded-xl px-3 py-2 text-sm transition hover:bg-fondo-alt',
                            ciudad === city ? 'font-semibold text-acento-texto' : 'text-suave',
                          ]}
                        >
                          {city}
                        </a>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </div>

            {presenciales.length > LIMITE_CARRIL && (
              <a
                href={buildFilterHref({ modality: 'presencial', city: ciudad })}
                class="text-sm font-semibold tracking-[0.02em] text-acento-texto transition hover:opacity-80"
              >
                Ver todos los eventos
              </a>
            )}
          </div>

          {/*
            En telefono se muestran tres y no cuatro: apiladas en una columna,
            la cuarta solo alarga el scroll antes de llegar al resto de la
            pagina. El boton de debajo lleva al listado completo.
          */}
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {presenciales.slice(0, LIMITE_CARRIL).map((event, indice) => (
              <div class:list={[indice >= LIMITE_MOVIL ? 'hidden sm:block' : '']}>
                <EventCard event={event} />
              </div>
            ))}
          </div>

          {presenciales.length > LIMITE_MOVIL && (
            <div class="mt-8 sm:hidden">
              <a
                href={buildFilterHref({ modality: 'presencial', city: ciudad })}
                class="flex h-11 w-full items-center justify-center rounded-full border border-linea bg-superficie text-sm font-semibold tracking-[0.02em] text-texto transition active:scale-[0.98] hover:border-acento"
              >
                Ver más eventos
              </a>
            </div>
          )}
        </section>
      )}

      {virtuales.length > 0 && (
        <section class="mx-auto max-w-[1200px] px-6 pt-16">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">
                <Video class="size-3.5" stroke-width={2} />
                En línea
              </p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Próximos eventos virtuales</h2>
            </div>

            {virtuales.length > LIMITE_CARRIL && (
              <a
                href={buildFilterHref({ modality: 'virtual' })}
                class="text-sm font-semibold tracking-[0.02em] text-acento-texto transition hover:opacity-80"
              >
                Ver todos los eventos
              </a>
            )}
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {virtuales.slice(0, LIMITE_CARRIL).map((event, indice) => (
              <div class:list={[indice >= LIMITE_MOVIL ? 'hidden sm:block' : '']}>
                <EventCard event={event} />
              </div>
            ))}
          </div>

          {virtuales.length > LIMITE_MOVIL && (
            <div class="mt-8 sm:hidden">
              <a
                href={buildFilterHref({ modality: 'virtual' })}
                class="flex h-11 w-full items-center justify-center rounded-full border border-linea bg-superficie text-sm font-semibold tracking-[0.02em] text-texto transition active:scale-[0.98] hover:border-acento"
              >
                Ver más eventos
              </a>
            </div>
          )}
        </section>
      )}

      {/*
        Sustituye a la franja azul que iba aqui. Las dos decian lo mismo -"tu
        comunidad organiza algo, publicalo"- y ponerlas seguidas era repetir la
        llamada dos veces en el mismo scroll.

        Medidas del bloque equivalente de Meetup: tarjeta de 1200x408 con radio
        48, titulo 40/48, parrafo 18/28 en una columna de 500 y boton de 40px.

        La decoracion es una sola ilustracion de fondo, como la suya (1200x465),
        y el texto va encima centrado. Mientras no exista el archivo, la tarjeta
        se sostiene sola con las manchas de color de GEN: se ve terminada, no
        rota, y sustituirla es cambiar FONDO_UNETE por la ruta de la imagen.
      */}
      <section class="mx-auto max-w-[1200px] px-6 pt-20">
        <div class="relative flex min-h-[408px] items-center justify-center overflow-hidden rounded-[48px] bg-superficie px-6 shadow-[var(--c-sombra)]">
          {FONDO_UNETE ? (
            <img
              src={FONDO_UNETE}
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 size-full object-cover"
            />
          ) : (
            <div class="pointer-events-none absolute inset-0" aria-hidden="true">
              <div class="absolute -left-16 -top-10 size-64 rounded-[46%_54%_57%_43%/49%_44%_56%_51%] bg-[var(--gen-rojo-suave)]"></div>
              <div class="absolute -right-12 -top-16 size-72 rounded-[38%_62%_51%_49%/55%_39%_61%_45%] bg-[var(--gen-azul-suave)]"></div>
              <div class="absolute -bottom-16 left-24 size-56 rounded-[52%_48%_44%_56%/47%_53%_47%_53%] bg-[var(--gen-amarillo-suave)]"></div>
              <div class="absolute -bottom-12 right-28 size-52 rounded-[43%_57%_49%_51%/52%_46%_54%_48%] bg-[var(--gen-magenta-suave)]"></div>
            </div>
          )}

          <div class="relative py-16 text-center">
            <h2 class="text-[40px] font-bold leading-[48px] text-texto">Súmate a la cartelera</h2>
            <p class="mx-auto mt-4 max-w-[500px] text-lg leading-7 text-suave">
              Las comunidades de la red usan Nodo para contar lo que organizan y llegar a quien
              todavía no las conoce. Publicar es gratis.
            </p>
            <a
              href="/eventos/nuevo"
              class="mt-8 inline-flex h-10 items-center rounded-full bg-acento px-5 text-sm font-semibold tracking-[0.02em] text-acento-contraste transition active:scale-[0.97] hover:opacity-90"
            >
              Publicar evento
            </a>
          </div>
        </div>
      </section>

      <!--
        Las categorias salen de las etiquetas reales de los eventos publicados,
        no de una lista fija: una categoria vacia es una promesa que la pagina
        no cumple. El color lo da genColor sobre el propio texto, asi que la
        etiqueta "tecnologia" es del mismo color aqui y en su tarjeta.

        El hover no rellena el chip con --g ni invierte a texto blanco: sobre el
        amarillo eso da 1.2:1, y en tema oscuro los seis colores son pasteles
        claros, asi que fallaria en todos. Se mantiene el par --g-texto sobre
        --g-suave, que si esta calculado para cumplir contraste en ambos temas,
        y el hover se nota por elevacion.
      -->
      {categorias.length > 0 && (
        <section class="mx-auto max-w-6xl px-6 py-16">
          <h2 class="text-[32px] font-bold leading-tight text-texto">Explora las categorías</h2>

          {/*
            Fila que se desplaza en horizontal, como la suya, en vez de chips
            que hacen saltos de linea. Las tarjetas se alternan arriba y abajo
            para que la fila no se lea como una tabla.

            -mx-6 px-6 hace que el desplazamiento llegue hasta el filo de la
            pantalla en vez de cortarse en el margen del contenedor, que es lo
            que delata que hay mas contenido a la derecha.

            El hueco inferior es holgado a proposito: overflow-x en auto pone el
            eje vertical tambien en auto, asi que los 24px que baja la tarjeta
            escalonada mas los 6 que sobresale su barra de color dibujaban una
            barra de desplazamiento vertical al pasar por la seccion.
          */}
          <div class="mt-8 grid grid-cols-2 gap-4 pb-4 sm:-mx-6 sm:flex sm:snap-x sm:gap-5 sm:overflow-x-auto sm:px-6 sm:pb-10 sm:pt-3">
            {categorias.map((categoria, indice) => (
              <a
                href={buildFilterHref({ search: categoria.nombre })}
                data-gen={categoria.color}
                class:list={[
                  'group relative flex h-[150px] w-full shrink-0 snap-start flex-col justify-between rounded-3xl bg-superficie p-5 shadow-[var(--c-sombra)] transition hover:-translate-y-1 sm:w-[230px]',
                  indice % 2 === 0 ? '' : 'lg:translate-y-6 lg:hover:translate-y-5',
                ]}
              >
                <h3 class="pr-10 text-base font-bold capitalize leading-snug text-texto">
                  {categoria.nombre}
                </h3>

                <div class="flex items-end justify-between">
                  <ArrowUpRight class="size-5 text-tenue transition group-hover:text-[var(--g-texto)]" stroke-width={2} />

                  {/*
                    Meetup pone aqui una ilustracion por categoria. Sin ese
                    juego de ilustraciones, el icono hace el mismo trabajo: dice
                    de que va la tarjeta de un vistazo y evita que se lea vacia.
                  */}
                  <categoria.Icono
                    class="size-10 text-[var(--g)] transition duration-300 group-hover:scale-110"
                    stroke-width={1.5}
                  />
                </div>

                {/* La barra sobresale por debajo, como en las suyas. */}
                <span
                  class="absolute inset-x-4 -bottom-1.5 h-3 rounded-b-2xl bg-[var(--g)]"
                  aria-hidden="true"
                ></span>
              </a>
            ))}
          </div>
        </section>
      )}

      {/*
        Los tres pasos pasan de una fila de columnas iguales a un zigzag de
        tarjetas, como el "Como funciona Meetup": encabezado centrado a 32px,
        tarjetas blancas de radio 32 con 24/28 de padding y titulo a 16px, y un
        trazo curvo que las encadena.

        El zigzag es lo que hace que se lean como pasos y no como tres opciones
        sueltas: la fila de tres columnas no dice en que orden van, y esto si.
      */}
      <section>
        <div class="mx-auto max-w-[1200px] px-6 py-20">
          <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">
            Qué es Nodo
          </p>
          <h2 class="mx-auto mt-3 max-w-2xl text-center text-[32px] font-bold leading-tight text-texto">
            La cartelera del ecosistema, en un solo sitio
          </h2>
          <p class="mx-auto mt-4 max-w-prose text-center text-suave">
            Talleres, encuentros y convocatorias que organizan las comunidades de la red. Publicados por
            quienes los hacen, abiertos a quien quiera llegar.
          </p>

          <div class="relative mt-14">
            {/*
              El trazo va en un solo SVG estirado sobre la rejilla, como el
              suyo. preserveAspectRatio="none" deja que se deforme con el
              contenedor: es decoracion, y asi los extremos siguen cayendo
              donde estan las tarjetas en cualquier ancho. Solo desde lg, que
              es donde el zigzag existe.
            */}
            <svg
              class="pointer-events-none absolute inset-0 hidden size-full text-linea lg:block"
              viewBox="0 0 1000 520"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M400 90 C 470 40, 520 150, 580 110"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path d="M572 100 l14 10 -16 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path
                d="M880 210 C 930 330, 760 340, 700 380"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path d="M714 368 l-16 12 4 -18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            <ol class="relative grid gap-6 lg:grid-cols-12">
              {pasos.map((paso, indice) => (
                <li
                  data-gen={paso.color}
                  class:list={[
                    'rounded-[32px] bg-superficie px-7 py-6 shadow-[var(--c-sombra)]',
                    posicionesPaso[indice],
                  ]}
                >
                  <div class="flex items-start gap-4">
                    <paso.Icono class="size-8 shrink-0 text-[var(--g)]" stroke-width={1.75} />

                    <div>
                      <h3 class="text-base font-bold leading-snug text-texto">{paso.titulo}</h3>
                      <p class="mt-1 text-sm leading-6 text-suave">{paso.texto}</p>
                      <a
                        href={paso.href}
                        class="mt-2 inline-block text-sm font-semibold text-[var(--g-texto)] transition hover:opacity-80"
                      >
                        {paso.enlace}
                      </a>
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      {/*
        Titular a la izquierda y parrafo a la derecha, y debajo tres piezas con
        imagen y texto, como "En Meetup surgen amistades". Ellos ponen ahi
        articulos de su blog; Nodo no tiene blog, asi que van las comunidades
        que mas publican, que es contenido real y ademas dice algo cierto sobre
        la red en vez de rellenar el hueco.

        El bloque de color va desplazado detras de la foto, como el suyo: es lo
        que le da el aire de recorte pegado en vez de imagen dentro de una caja.
      */}
      {comunidades.length > 0 && (
        <section class="mx-auto max-w-[1200px] px-6 py-20">
          <div class="grid gap-6 lg:grid-cols-2 lg:gap-16">
            <h2 class="text-[32px] font-bold leading-tight text-texto">
              En Nodo se encuentran<br />
              las comunidades
            </h2>
            <p class="max-w-prose text-suave lg:pt-2">
              Detrás de cada evento hay alguien que lo organiza. Estas son las comunidades que más
              están publicando ahora mismo en la cartelera: mira lo que preparan y súmate a lo que
              te interese.
            </p>
          </div>

          <div class="mt-14 grid gap-10 md:grid-cols-3">
            {comunidades.map((comunidad, indice) => (
              <article
                data-gen={comunidad.color}
                class:list={[indice === 1 ? 'md:mt-12' : '']}
              >
                <a href={comunidad.enlace} class="group block">
                  <div class="relative">
                    {/* El bloque de color asoma por abajo y por la izquierda. */}
                    <div class="absolute -bottom-3 -left-3 h-full w-full rounded-3xl bg-[var(--g)]" aria-hidden="true"></div>

                    <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden rounded-3xl bg-[var(--g-suave)]">
                      {comunidad.autor.avatarUrl ? (
                        <img
                          src={comunidad.autor.avatarUrl}
                          alt=""
                          loading="lazy"
                          class="size-24 rounded-full object-cover ring-4 ring-superficie transition duration-300 group-hover:scale-105"
                        />
                      ) : (
                        <span class="flex size-24 items-center justify-center rounded-full bg-superficie text-3xl font-bold text-[var(--g-texto)] ring-4 ring-superficie">
                          {comunidad.autor.name.charAt(0).toUpperCase()}
                        </span>
                      )}
                    </div>
                  </div>

                  <h3 class="mt-8 text-lg font-bold leading-snug text-texto">
                    {comunidad.autor.name}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-suave">
                    {comunidad.total === 1
                      ? 'Tiene un evento próximo en la cartelera'
                      : `Tiene ${comunidad.total} eventos próximos en la cartelera`}, y el siguiente es{' '}
                    <span class="text-texto">{comunidad.proximo.title}</span>.
                  </p>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  <!--
    Solo aparece si hay publicaciones sincronizadas: una seccion vacia con un
    "proximamente" es peor que no tener seccion.
  -->
  {posts.length > 0 && (
    <>
      <Franja titulo="Lo que se cuenta en la red" color="magenta" />

      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">Publicaciones</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Desde Instagram</h2>
          </div>
          <a
            href="https://www.instagram.com/redglobalcol/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-suave transition hover:text-acento-texto"
          >
            <SocialIcon name="instagram" class="size-4" />
            @redglobalcol
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
          {posts.map((post) => (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-square overflow-hidden rounded-2xl border border-linea bg-fondo-alt"
            >
              <img
                src={post.imageUrl}
                alt={post.caption.slice(0, 120) || 'Publicación de Instagram'}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              {post.caption && (
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#111113]/85 to-transparent p-3 pt-10 text-xs leading-snug text-white opacity-0 transition group-hover:opacity-100">
                  <span class="line-clamp-3 block">{post.caption}</span>
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
