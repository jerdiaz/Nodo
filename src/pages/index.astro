---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/events/EmptyState.astro';
import EventCard from '../components/events/EventCard.astro';
import EventFilter from '../components/events/EventFilter.astro';
import SecondaryFilters from '../components/events/SecondaryFilters.astro';
import StatusToast from '../components/common/StatusToast.astro';
import Franja from '../components/common/Franja.astro';
import { Search } from '@lucide/astro';
import { filterEvents, getEvents } from '../lib/firebase/events';
import { getInstagramPosts } from '../lib/firebase/instagram';
import type { InstagramPost } from '../lib/firebase/instagram';
import SocialIcon from '../components/ui/SocialIcon.astro';
import type { NodoEvent } from '../types/event';

const modalidad = Astro.url.searchParams.get('modalidad') ?? undefined;
const ciudad = Astro.url.searchParams.get('ciudad') ?? undefined;
const query = Astro.url.searchParams.get('q') ?? undefined;
const timeframe: 'upcoming' | 'past' = Astro.url.searchParams.get('tiempo') === 'pasados' ? 'past' : 'upcoming';

let allEvents: NodoEvent[] = [];

try {
  allEvents = await getEvents();
} catch (error) {
  console.warn('No se pudo obtener el catálogo de eventos desde Firebase:', error);
}

const timeframeEvents = filterEvents(allEvents, { timeframe });
const cities = [
  ...new Set(timeframeEvents.filter((event) => event.city).map((event) => event.city as string)),
].sort((a, b) => a.localeCompare(b, 'es'));

const events = filterEvents(allEvents, { modality: modalidad, city: ciudad, timeframe, search: query });
const hasActiveFilters = Boolean(modalidad || ciudad || query);

// Cifras de la seccion de presentacion. Salen de la lectura de eventos que ya
// se hizo arriba: ninguna es inventada ni requiere una consulta extra.
const upcomingAll = filterEvents(allEvents, { timeframe: 'upcoming' });
const totalCiudades = new Set(upcomingAll.filter((e) => e.city).map((e) => e.city)).size;
const totalComunidades = new Set(allEvents.map((e) => e.organizer.uid)).size;

const cifras = [
  { valor: upcomingAll.length, etiqueta: upcomingAll.length === 1 ? 'evento próximo' : 'eventos próximos', color: 'rojo' as const },
  { valor: totalCiudades, etiqueta: totalCiudades === 1 ? 'ciudad' : 'ciudades', color: 'azul' as const },
  { valor: totalComunidades, etiqueta: totalComunidades === 1 ? 'comunidad' : 'comunidades', color: 'magenta' as const },
];
const loginRequired = Astro.url.searchParams.get('login') === 'required';
const eventDeleted = Astro.url.searchParams.get('deleted') === 'true';

// Publicaciones de Instagram, cacheadas en Firestore por /api/instagram/sync.
// Se lee de ahi y no de Instagram: consultar en cada visita gastaria cuota y
// ataria el tiempo de respuesta de la home a un servicio ajeno.
let posts: InstagramPost[] = [];

try {
  posts = await getInstagramPosts(10);
} catch (error) {
  console.warn('No se pudieron obtener las publicaciones de Instagram:', error);
}
---

<BaseLayout>
  {loginRequired && (
    <div class="mx-auto max-w-6xl px-6 pt-6">
      <div class="rounded-2xl border border-marca-amarillo bg-fondo-alt px-4 py-3 text-sm text-texto backdrop-blur-xl">
        Inicia sesión para publicar un evento.
      </div>
    </div>
  )}

  {eventDeleted && <StatusToast paramKey="deleted" message="Evento eliminado correctamente." />}

  <section class="mx-auto max-w-3xl px-6 pb-12 pt-20 text-center">
    <p class="text-sm font-medium text-acento-texto">Cartelera comunitaria</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-texto sm:text-5xl">
      Encuentra tu próximo evento
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-suave">
      Nodo conecta a tu comunidad con talleres, encuentros y actividades locales.
      Descubre lo que está pasando cerca de ti.
    </p>

    <form method="get" action="/" class="mx-auto mt-8 max-w-xl">
      {modalidad && <input type="hidden" name="modalidad" value={modalidad} />}
      {ciudad && <input type="hidden" name="ciudad" value={ciudad} />}
      {timeframe === 'past' && <input type="hidden" name="tiempo" value="pasados" />}
      <div class="relative">
        <Search
          class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-tenue"
          stroke-width={1.75}
        />
        <input
          type="text"
          name="q"
          value={query ?? ''}
          placeholder="Buscar por nombre, tema o tag..."
          class="w-full rounded-full bg-superficie py-3 pl-11 pr-4 text-sm text-texto ring-1 ring-inset ring-linea placeholder:text-tenue focus:outline-none focus:ring-2 focus:ring-acento"
        />
      </div>
    </form>

    <div class="mt-6">
      <EventFilter
        selectedModality={modalidad}
        selectedCity={ciudad}
        selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
        selectedSearch={query}
      />
    </div>
  </section>

  <!--
    Presentacion antes del listado. Las cifras son reales: cualquier afirmacion
    sobre la organizacion tendria que escribirla alguien de la casa, no yo.
  -->
  <section class="border-y border-linea bg-fondo-alt">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-[1.1fr_1fr] md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">Qué es Nodo</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-texto sm:text-3xl">
          La cartelera del ecosistema, en un solo sitio
        </h2>
        <p class="mt-4 max-w-prose text-suave">
          Talleres, encuentros y convocatorias que organizan las comunidades de la red. Publicados por
          quienes los hacen, abiertos a quien quiera llegar.
        </p>
      </div>

      <dl class="grid grid-cols-3 gap-4">
        {cifras.map((cifra) => (
          <div data-gen={cifra.color} class="border-t-4 border-[var(--g)] pt-4">
            <dt class="sr-only">{cifra.etiqueta}</dt>
            <dd class="text-3xl font-bold tracking-tight text-texto sm:text-4xl">
              {String(cifra.valor).padStart(2, '0')}
            </dd>
            <p class="mt-1 text-xs uppercase tracking-wide text-suave">{cifra.etiqueta}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Franja
    titulo="¿Tu comunidad organiza algo?"
    cta="Publicar evento"
    href="/eventos/nuevo"
    color="azul"
  />

  <section class="mx-auto max-w-6xl px-6 pb-24 pt-16">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="flex items-center gap-3">
        <h2 class="text-lg font-semibold text-texto">
          {timeframe === 'past' ? 'Eventos pasados' : 'Próximos eventos'}
        </h2>
        <span class="text-sm text-suave">{events.length} eventos</span>
      </div>
      <SecondaryFilters
        cities={cities}
        selectedModality={modalidad}
        selectedCity={ciudad}
        selectedTimeframe={timeframe === 'past' ? 'past' : undefined}
        selectedSearch={query}
      />
    </div>

    {
      events.length === 0 ? (
        timeframe === 'past' ? (
          <EmptyState
            title="No hay eventos pasados"
            description="Todavía no se ha realizado ningún evento con estos filtros."
          />
        ) : hasActiveFilters ? (
          <EmptyState
            title="No hay eventos para esta búsqueda"
            description="Prueba con otro filtro o vuelve a explorar todos los eventos."
          />
        ) : (
          <EmptyState />
        )
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      )
    }
  </section>
  <!--
    Solo aparece si hay publicaciones sincronizadas: una seccion vacia con un
    "proximamente" es peor que no tener seccion.
  -->
  {posts.length > 0 && (
    <>
      <Franja titulo="Lo que se cuenta en la red" color="magenta" />

      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-texto">Publicaciones</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-texto">Desde Instagram</h2>
          </div>
          <a
            href="https://www.instagram.com/redglobalcol/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-suave transition hover:text-acento-texto"
          >
            <SocialIcon name="instagram" class="size-4" />
            @redglobalcol
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
          {posts.map((post) => (
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-square overflow-hidden rounded-2xl border border-linea bg-fondo-alt"
            >
              <img
                src={post.imageUrl}
                alt={post.caption.slice(0, 120) || 'Publicación de Instagram'}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              {post.caption && (
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#111113]/85 to-transparent p-3 pt-10 text-xs leading-snug text-white opacity-0 transition group-hover:opacity-100">
                  <span class="line-clamp-3 block">{post.caption}</span>
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
