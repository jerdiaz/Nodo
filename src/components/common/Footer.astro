---
import { ArrowRight } from '@lucide/astro';
import SocialIcon from '../ui/SocialIcon.astro';

const year = new Date().getFullYear();

const socialLinks = [
  { key: 'instagram', href: 'https://www.instagram.com/redglobalcol/', label: 'Instagram de Red Global' },
  { key: 'linkedin', href: 'https://www.linkedin.com/company/genhq/', label: 'LinkedIn de GEN' },
  { key: 'x', href: 'https://x.com/unleashingideas', label: 'X de GEN' },
] as const;

const columns = [
  {
    title: 'Explorar',
    links: [
      { href: '/', label: 'Eventos' },
      { href: '/comunidades', label: 'Comunidades' },
      { href: '/calendario', label: 'Calendario' },
    ],
  },
  {
    title: 'Organizar',
    links: [
      { href: '/eventos/nuevo', label: 'Publicar evento' },
      // Redirige a /?login=required, que muestra el aviso de iniciar sesion.
      // Es el mismo comportamiento que tiene "Tu cuenta" en Meetup para quien
      // no ha entrado, asi que no hace falta esconderlo.
      { href: '/mis-eventos', label: 'Mis eventos' },
    ],
  },
  {
    title: 'Nodo',
    links: [
      { href: '/acerca', label: 'Acerca de' },
      { href: '/contacto', label: 'Contacto' },
      { href: '/privacidad', label: 'Privacidad' },
    ],
  },
];
---

{/*
  El pie es oscuro en los dos temas, no sigue a los tokens: el logotipo de
  Sentra Labs solo existe en su variante para fondo oscuro (el texto "SENTRA
  LABS" es blanco) y sobre el fondo claro del sitio desapareceria. Es la misma
  solucion que usa funconceptos, que tambien es un sitio claro con pie oscuro.

  Como el fondo es fijo, los colores de aqui son literales y no tokens: los
  --gen-* claros son los del tema claro, pensados para texto oscuro sobre
  blanco, y sobre este negro no llegarian a contraste. Se usan las variantes
  del tema oscuro directamente.
*/}
<footer class="mt-auto bg-[#111113] text-[#c9c9d0]">
  <div class="cinta-gen" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-6 py-14">
    {/*
      Fila superior a la manera de Meetup: la marca con su lema a la izquierda
      y una sola llamada a la accion a la derecha, en el mismo cuerpo grande.
      El pie deja de ser solo un mapa de enlaces y se lleva una conversion.
    */}
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <a href="/" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-2xl font-bold tracking-tight text-white">
        <span class="flex items-center gap-2">
          <img src="/logo-icon.png" alt="" class="size-7" />
          Nodo<span class="text-[#ff6b6b]">.</span>
        </span>
        <span class="text-[#8b8b93]">
          La cartelera de <span class="text-[#f06bb8]">las comunidades</span>
        </span>
      </a>

      <a
        href="/eventos/nuevo"
        class="group inline-flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight text-white"
      >
        ¿Tu comunidad organiza algo?
        <span class="inline-flex items-center gap-1.5 text-[#8b8b93] transition group-hover:text-white">
          Publícalo
          <ArrowRight class="size-5 transition group-hover:translate-x-1" stroke-width={2.25} />
        </span>
      </a>
    </div>

    <div class="mt-10 border-t border-white/10"></div>

    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {columns.map((column) => (
        <div>
          <h3 class="text-base font-bold text-white">{column.title}</h3>
          <ul class="mt-5 space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-[#8b8b93] transition hover:text-white">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-base font-bold text-white">Síguenos</h3>
        <div class="mt-5 flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="flex size-11 items-center justify-center rounded-full bg-white/[0.06] text-[#c9c9d0] transition active:scale-[0.95] hover:bg-white/15 hover:text-white"
            >
              <SocialIcon name={social.key} class="size-5" />
            </a>
          ))}
        </div>

        <p class="mt-6 max-w-xs text-sm text-[#8b8b93]">
          La cartelera comunitaria para descubrir y organizar eventos locales.
        </p>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-[#8b8b93] sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p>© {year} Nodo</p>
        <a href="/privacidad" class="transition hover:text-white">Privacidad</a>
        <a href="/contacto" class="transition hover:text-white">Contacto</a>
      </div>

      <a
        href="https://sentralabs.co"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Sitio desarrollado por Sentra Labs, abre sentralabs.co"
        class="inline-flex items-center gap-2 text-[#8b8b93] transition hover:text-white"
      >
        Desarrollado por
        <img src="/logo/sentralabs.png" alt="Sentra Labs" width="1458" height="513" class="h-5 w-auto" />
      </a>
    </div>
  </div>
</footer>
