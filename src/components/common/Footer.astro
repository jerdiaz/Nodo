---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Producto',
    links: [
      { href: '/', label: 'Explorar eventos' },
      { href: '/eventos/nuevo', label: 'Publicar evento' },
      { href: '/comunidades', label: 'Comunidades' },
    ],
  },
  {
    title: 'Nodo',
    links: [
      { href: '/acerca', label: 'Acerca de' },
      { href: '/contacto', label: 'Contacto' },
      { href: '/privacidad', label: 'Privacidad' },
    ],
  },
];
---

{/*
  El pie es oscuro en los dos temas, no sigue a los tokens: el logotipo de
  Sentra Labs solo existe en su variante para fondo oscuro (el texto "SENTRA
  LABS" es blanco) y sobre el fondo claro del sitio desapareceria. Es la misma
  solucion que usa funconceptos, que tambien es un sitio claro con pie oscuro.
*/}
<footer class="mt-auto bg-[#111113] text-[#c9c9d0]">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col justify-between gap-10 md:flex-row">
      <div>
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
          <img src="/logo-icon.png" alt="" class="size-6" />
          Nodo<span class="text-[#ff4d4d]">.</span>
        </a>
        <p class="mt-2 max-w-xs text-sm text-[#8b8b93]">
          La cartelera comunitaria para descubrir y organizar eventos locales.
        </p>
      </div>

      <div class="flex gap-16">
        {columns.map((column) => (
          <div>
            <h3 class="text-sm font-medium text-white">{column.title}</h3>
            <ul class="mt-3 space-y-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-[#8b8b93] transition hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-[#8b8b93] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Nodo. Todos los derechos reservados.</p>

      <a
        href="https://sentralabs.co"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Sitio desarrollado por Sentra Labs, abre sentralabs.co"
        class="inline-flex items-center gap-2 text-[#8b8b93] transition hover:text-white"
      >
        Desarrollado por
        <img src="/logo/sentralabs.png" alt="Sentra Labs" width="1458" height="513" class="h-5 w-auto" />
      </a>
    </div>
  </div>
</footer>
