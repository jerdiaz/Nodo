---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Producto',
    links: [
      { href: '/', label: 'Explorar eventos' },
      { href: '/eventos/nuevo', label: 'Publicar evento' },
      { href: '/comunidades', label: 'Comunidades' },
    ],
  },
  {
    title: 'Nodo',
    links: [
      { href: '/acerca', label: 'Acerca de' },
      { href: '/contacto', label: 'Contacto' },
      { href: '/privacidad', label: 'Privacidad' },
    ],
  },
];
---

<footer class="border-t border-neutral-900">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col justify-between gap-10 md:flex-row">
      <div>
        <a href="/" class="text-lg font-bold tracking-tight text-neutral-100">
          Nodo<span class="text-emerald-400">.</span>
        </a>
        <p class="mt-2 max-w-xs text-sm text-neutral-500">
          La cartelera comunitaria para descubrir y organizar eventos locales.
        </p>
      </div>

      <div class="flex gap-16">
        {columns.map((column) => (
          <div>
            <h3 class="text-sm font-medium text-neutral-200">{column.title}</h3>
            <ul class="mt-3 space-y-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-neutral-500 transition-colors hover:text-neutral-100">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 border-t border-neutral-900 pt-6 text-sm text-neutral-600">
      © {year} Nodo. Todos los derechos reservados.
    </div>
  </div>
</footer>
