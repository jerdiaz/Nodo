---
interface Props {
  message: string;
  paramKey: 'created' | 'updated' | 'deleted';
}

const { message, paramKey } = Astro.props;
---

<div
  class="status-toast fixed right-4 top-20 z-50 flex items-start gap-3 rounded-2xl border border-acento bg-acento-suave px-4 py-3 text-sm text-acento-texto shadow-[var(--c-sombra)] backdrop-blur-xl"
  role="status"
  data-param-key={paramKey}
>
  <p class="pr-2">{message}</p>
  <button
    type="button"
    data-toast-close
    aria-label="Cerrar notificación"
    class="text-acento-texto transition active:scale-[0.9] hover:text-acento-texto"
  >
    ×
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.status-toast').forEach((toast) => {
    const paramKey = toast.dataset.paramKey;

    if (paramKey) {
      const url = new URL(window.location.href);
      if (url.searchParams.has(paramKey)) {
        url.searchParams.delete(paramKey);
        window.history.replaceState(null, '', url.pathname + url.search);
      }
    }

    toast.querySelector('[data-toast-close]')?.addEventListener('click', () => {
      toast.remove();
    });
  });
</script>
