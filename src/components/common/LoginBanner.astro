---
import { X } from '@lucide/astro';
---

{/*
  Empieza oculto con el atributo hidden (no con una clase) para que el script
  decida si lo muestra antes de que haya pintado nada: revelarlo con JS tras
  pintarlo visible causaria un parpadeo, y quedarse oculto no lo causa.

  Barra al pie, como la de Meetup en movil, y no la tarjeta flotante que habia
  arriba a la derecha: aquella aparecia nada mas cargar y tapaba contenido antes
  de que nadie hubiera visto de que va el sitio. Esta espera a que se baje.

  Los dos proveedores no caben en una barra, asi que el boton abre el modal de
  sesion, que ya los tiene. Es un boton y no un enlace porque no navega.
*/}
<div
  id="nodo-banner-acceso"
  role="dialog"
  aria-labelledby="nodo-banner-acceso-titulo"
  hidden
  class="fixed inset-x-0 bottom-0 z-40 border-t border-linea bg-superficie px-5 py-4 shadow-[0_-8px_28px_-12px_rgb(17_17_19_/_0.18)]"
>
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-3 sm:flex-row sm:justify-between">
    <p id="nodo-banner-acceso-titulo" class="text-center text-base font-semibold text-texto sm:text-left">
      Únete a Nodo y encuentra tu comunidad
    </p>

    <div class="flex w-full items-center gap-2 sm:w-auto">
      <button
        id="nodo-banner-entrar"
        type="button"
        class="h-11 flex-1 rounded-full bg-acento px-6 text-sm font-semibold tracking-[0.02em] text-acento-contraste transition active:scale-[0.98] hover:opacity-90 sm:flex-none"
      >
        Iniciar sesión
      </button>

      <button
        id="nodo-banner-cerrar"
        type="button"
        aria-label="Cerrar"
        class="flex size-11 shrink-0 items-center justify-center rounded-full text-suave transition hover:bg-fondo-alt hover:text-texto"
      >
        <X class="size-5" stroke-width={2} />
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('nodo-banner-acceso');

  if (banner) {
    // Solo por la sesion del navegador: quien lo cierra no quiere verlo otra
    // vez mientras sigue navegando, pero no es un rechazo permanente que
    // deba perseguirlo en cada visita futura.
    const CERRADO = 'nodo-anuncio-acceso-cerrado';
    let cerrado = sessionStorage.getItem(CERRADO) === '1';

    // Aparece al llegar a la mitad de la pagina, no al cargar: antes de eso
    // nadie ha visto todavia que ofrece el sitio, y una barra pidiendo cuenta
    // de entrada solo estorba.
    const revisar = (): void => {
      if (cerrado) return;
      const recorrido = window.scrollY + window.innerHeight;
      banner.hidden = recorrido < document.documentElement.scrollHeight * 0.5;
    };

    document.getElementById('nodo-banner-cerrar')?.addEventListener('click', () => {
      cerrado = true;
      banner.hidden = true;
      sessionStorage.setItem(CERRADO, '1');
    });

    // El modal ya trae Google y Microsoft; la barra solo lo abre.
    document.getElementById('nodo-banner-entrar')?.addEventListener('click', () => {
      const modal = document.getElementById('nodo-modal-sesion') as HTMLDialogElement | null;
      modal?.showModal();
    });

    window.addEventListener('scroll', revisar, { passive: true });
    window.addEventListener('resize', revisar);
    revisar();
  }
</script>
