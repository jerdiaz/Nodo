---
import { X } from '@lucide/astro';
---

{/*
  Empieza oculto con el atributo hidden (no con una clase) para que el script
  decida si lo muestra antes de que haya pintado nada: revelarlo con JS tras
  pintarlo visible causaria un parpadeo, y quedarse oculto no lo causa.

  Tarjeta al pie, como la de Meetup en movil: separada de los filos, esquinas
  redondeadas y el boton ovalado ocupando todo su ancho. No es la tarjeta
  flotante que habia arriba a la derecha, que aparecia nada mas cargar y tapaba
  contenido antes de que nadie hubiera visto de que va el sitio: esta espera a
  que se baje una pantalla.

  Los dos proveedores no caben en una barra, asi que el boton abre el modal de
  sesion, que ya los tiene. Es un boton y no un enlace porque no navega.
*/}
<div
  id="nodo-banner-acceso"
  role="dialog"
  aria-labelledby="nodo-banner-acceso-titulo"
  hidden
  class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-[520px] rounded-[28px] border border-linea bg-superficie p-5 shadow-[0_-4px_32px_-8px_rgb(17_17_19_/_0.22)]"
>
  <button
    id="nodo-banner-cerrar"
    type="button"
    aria-label="Cerrar"
    class="absolute right-3 top-3 flex size-8 items-center justify-center rounded-full text-tenue transition hover:bg-fondo-alt hover:text-texto"
  >
    <X class="size-4" stroke-width={2} />
  </button>

  <p
    id="nodo-banner-acceso-titulo"
    class="px-6 text-center text-lg font-bold leading-snug text-texto"
  >
    Únete a Nodo y encuentra tu comunidad
  </p>

  {/* El boton ocupa el ancho de la tarjeta y va completamente ovalado, como el
      suyo: es la unica accion que hay aqui, asi que no compite con nada. */}
  <button
    id="nodo-banner-entrar"
    type="button"
    class="mt-4 h-14 w-full rounded-full bg-acento text-base font-semibold tracking-[0.02em] text-acento-contraste transition active:scale-[0.98] hover:opacity-90"
  >
    Iniciar sesión
  </button>
</div>

<script>
  const banner = document.getElementById('nodo-banner-acceso');

  if (banner) {
    // Solo por la sesion del navegador: quien lo cierra no quiere verlo otra
    // vez mientras sigue navegando, pero no es un rechazo permanente que
    // deba perseguirlo en cada visita futura.
    const CERRADO = 'nodo-anuncio-acceso-cerrado';
    let cerrado = sessionStorage.getItem(CERRADO) === '1';

    // Aparece tras bajar una pantalla completa, no al cargar: antes de eso
    // nadie ha visto todavia que ofrece el sitio, y una barra pidiendo cuenta
    // de entrada solo estorba.
    //
    // El umbral es una pantalla y no un porcentaje de la pagina: la home mide
    // mas de 8000px en movil, asi que pedir la mitad obligaba a recorrer 3400px
    // antes de que apareciera, y en la practica no aparecia nunca.
    const revisar = (): void => {
      if (cerrado) return;
      banner.hidden = window.scrollY < window.innerHeight;
    };

    document.getElementById('nodo-banner-cerrar')?.addEventListener('click', () => {
      cerrado = true;
      banner.hidden = true;
      sessionStorage.setItem(CERRADO, '1');
    });

    // El modal ya trae Google y Microsoft; la barra solo lo abre.
    document.getElementById('nodo-banner-entrar')?.addEventListener('click', () => {
      const modal = document.getElementById('nodo-modal-sesion') as HTMLDialogElement | null;
      modal?.showModal();
    });

    window.addEventListener('scroll', revisar, { passive: true });
    window.addEventListener('resize', revisar);
    revisar();
  }
</script>
