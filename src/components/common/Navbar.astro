---
import { Plus } from '@lucide/astro';
import { getCurrentUser } from '../../lib/auth';

const links = [
  { href: '/', label: 'Explorar' },
  { href: '/calendario', label: 'Calendario' },
  { href: '/comunidades', label: 'Comunidades' },
];

const user = await getCurrentUser(Astro.cookies);
---

<header class="sticky top-0 z-50 border-b border-neutral-900 bg-neutral-950/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-1.5 text-lg font-bold tracking-tight text-neutral-100">
      Nodo<span class="text-emerald-400">.</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm text-neutral-400 md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-neutral-100">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/eventos/nuevo"
        class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-950 transition-colors hover:bg-emerald-400"
      >
        <Plus class="size-4" stroke-width={2.5} />
        Publicar evento
      </a>

      {user ? (
        <div class="flex items-center gap-2.5">
          {user.avatarUrl ? (
            <img src={user.avatarUrl} alt={user.name} class="size-8 rounded-full object-cover" />
          ) : (
            <div class="flex size-8 items-center justify-center rounded-full bg-neutral-800 text-xs font-medium text-neutral-300">
              {user.name.charAt(0).toUpperCase()}
            </div>
          )}
          <button
            id="nodo-logout-button"
            type="button"
            class="text-sm text-neutral-400 transition-colors hover:text-neutral-100"
          >
            Cerrar sesión
          </button>
        </div>
      ) : (
        <div class="flex items-center gap-2">
          <button
            id="nodo-login-google"
            type="button"
            class="inline-flex items-center rounded-full border border-neutral-800 px-3.5 py-2 text-sm font-medium text-neutral-200 transition-colors hover:border-neutral-600"
          >
            Google
          </button>
          <button
            id="nodo-login-microsoft"
            type="button"
            class="inline-flex items-center rounded-full border border-neutral-800 px-3.5 py-2 text-sm font-medium text-neutral-200 transition-colors hover:border-neutral-600"
          >
            Microsoft
          </button>
        </div>
      )}
    </div>
  </nav>
</header>

<script>
  import { loginWithGoogle, loginWithMicrosoft, logout } from '../../lib/firebase/client';

  const googleButton = document.getElementById('nodo-login-google') as HTMLButtonElement | null;
  const microsoftButton = document.getElementById('nodo-login-microsoft') as HTMLButtonElement | null;
  const logoutButton = document.getElementById('nodo-logout-button') as HTMLButtonElement | null;

  async function handleLogin(button: HTMLButtonElement, login: () => Promise<void>): Promise<void> {
    button.disabled = true;

    try {
      await login();
    } catch (error) {
      console.error('No se pudo iniciar sesión:', error);
      button.disabled = false;
    }
  }

  googleButton?.addEventListener('click', () => handleLogin(googleButton, loginWithGoogle));
  microsoftButton?.addEventListener('click', () => handleLogin(microsoftButton, loginWithMicrosoft));

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;
    await logout();
  });
</script>
