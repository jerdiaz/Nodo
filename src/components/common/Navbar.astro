---
import { ChevronDown, LogOut, Search, Settings, User } from '@lucide/astro';
import { getDisplayUser } from '../../lib/auth';
import ProviderIcon from '../ui/ProviderIcon.astro';

const user = await getDisplayUser(Astro.cookies);

const links = [
  { href: '/calendario', label: 'Calendario' },
  { href: '/comunidades', label: 'Comunidades' },
  ...(user ? [{ href: '/mis-eventos', label: 'Mis eventos' }] : []),
];

// La cabecera va en todas las paginas, asi que la busqueda se rellena con lo
// que haya en la URL y no con estado propio: quien filtra por ciudad sigue
// viendo su ciudad escrita al navegar a la ficha de un evento y volver.
const searchQuery = Astro.url.searchParams.get('q') ?? '';
const searchCity = Astro.url.searchParams.get('ciudad') ?? '';
---

{/*
  Medidas tomadas de la cabecera de Meetup: 80px de alto, contenido a 1200px,
  logotipo de 34px y esquinas inferiores a 24px. El contenido no va en una
  caja centrada: el logotipo se ancla al filo izquierdo y la sesion al derecho.

  Se va con la pagina, como la suya, que es static y no queda pegada arriba.
  Sigue siendo relative y con z-50 aunque no se ancle: los menus de sesion y de
  cuenta son absolute dentro de ella, y sin un ancestro posicionado que levante
  la capa se colarian por debajo del contenido al abrirlos. Por lo mismo no
  lleva overflow-hidden, que los recortaria.

  Quien dibuja el redondeo es el borde inferior, que sigue la curva. El fondo
  tambien se recorta, pero contra el blanco de la pagina eso no se ve.
*/}
<header class="relative z-50 rounded-b-3xl bg-fondo transition-colors duration-200 focus-within:bg-superficie focus-within:shadow-[var(--c-sombra)]">
  <nav class="flex h-20 w-full items-center gap-6 px-6 lg:px-10">
    <a href="/" class="flex shrink-0 items-center gap-2.5 text-2xl font-bold tracking-tight text-texto">
      <img src="/logo-icon.png" alt="" class="size-8" />
      <span>Nodo<span class="text-acento-texto">.</span></span>
    </a>

    {/*
      Dos campos y un boton dentro de una sola pastilla, como Meetup. Es un GET
      a la home, que es donde vive el listado: sin JavaScript, y las URLs que
      genera son las mismas ?q= y ?ciudad= que ya usaban los filtros.
    */}
    <form
      method="get"
      action="/"
      role="search"
      class="group hidden h-11 w-full min-w-0 max-w-[500px] items-center gap-1 rounded-full bg-superficie p-1 shadow-[var(--c-sombra)] transition lg:flex focus-within:bg-fondo-alt focus-within:shadow-none"
    >
      <input
        type="text"
        name="q"
        value={searchQuery}
        placeholder="Buscar eventos..."
        aria-label="Buscar eventos"
        class="h-9 min-w-0 flex-1 rounded-full bg-transparent px-4 text-sm tracking-[0.02em] text-texto outline-none transition placeholder:text-tenue focus:bg-superficie focus:shadow-[var(--c-sombra)]"
      />
      <span
        class="h-5 w-px shrink-0 bg-linea transition group-focus-within:bg-transparent"
        aria-hidden="true"
      ></span>

      <input
        type="text"
        name="ciudad"
        value={searchCity}
        placeholder="Ciudad"
        aria-label="Filtrar por ciudad"
        class="h-9 min-w-0 flex-[0.85] rounded-full bg-transparent px-4 text-sm tracking-[0.02em] text-texto outline-none transition placeholder:text-tenue focus:bg-superficie focus:shadow-[var(--c-sombra)]"
      />
      <button
        type="submit"
        aria-label="Buscar"
        class="flex size-9 shrink-0 items-center justify-center rounded-full bg-acento text-acento-contraste transition active:scale-[0.95] hover:opacity-90"
      >
        <Search class="size-4" stroke-width={2.5} />
      </button>
    </form>

    <ul class="ml-auto hidden shrink-0 items-center gap-7 text-sm font-medium tracking-[0.02em] text-suave lg:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition hover:text-texto">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex shrink-0 items-center gap-3 lg:ml-0">
      {user ? (
        <div class="relative" data-menu>
          <button
            id="nodo-user-trigger"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={`Cuenta de ${user.name}`}
            class="block rounded-full ring-2 ring-transparent transition active:scale-[0.97] hover:ring-linea aria-expanded:ring-acento"
          >
            {user.avatarUrl ? (
              <img src={user.avatarUrl} alt="" class="size-8 rounded-full object-cover" />
            ) : (
              <span class="flex size-8 items-center justify-center rounded-full bg-fondo-alt text-xs font-medium text-texto">
                {user.name.charAt(0).toUpperCase()}
              </span>
            )}
          </button>

          <div
            id="nodo-user-panel"
            role="menu"
            aria-labelledby="nodo-user-trigger"
            class="absolute right-0 top-full z-50 mt-2 hidden w-64 overflow-hidden rounded-2xl border border-linea bg-superficie shadow-[var(--c-sombra)] backdrop-blur-xl"
          >
            <div class="flex items-center gap-3 px-4 py-3.5">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt="" class="size-10 shrink-0 rounded-full object-cover" />
              ) : (
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-fondo-alt text-sm font-medium text-texto">
                  {user.name.charAt(0).toUpperCase()}
                </span>
              )}
              {/* min-w-0 es lo que permite que truncate funcione dentro de un
                  flex: sin el, el nombre largo estira la caja en vez de cortarse. */}
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-texto">{user.name}</p>
                {user.email && <p class="truncate text-xs text-suave">{user.email}</p>}
              </div>
            </div>

            <div class="h-px bg-linea"></div>

            <a
              href="/perfil"
              role="menuitem"
              class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-texto transition hover:bg-fondo-alt"
            >
              <User class="size-4 shrink-0" stroke-width={1.75} />
              Ver perfil
            </a>

            <a
              href="/configuracion"
              role="menuitem"
              class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-texto transition hover:bg-fondo-alt"
            >
              <Settings class="size-4 shrink-0" stroke-width={1.75} />
              Configuración
            </a>

            <div class="h-px bg-linea"></div>

            <button
              id="nodo-logout-button"
              type="button"
              role="menuitem"
              class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm font-medium text-texto transition hover:bg-fondo-alt disabled:cursor-not-allowed disabled:opacity-60"
            >
              <LogOut class="size-4 shrink-0" stroke-width={1.75} />
              Cerrar sesión
            </button>
          </div>
        </div>
      ) : (
        <div class="relative" data-menu>
          <button
            id="nodo-login-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="inline-flex h-9 items-center gap-1.5 rounded-full border border-linea bg-superficie px-3.5 text-sm font-semibold tracking-[0.02em] text-texto transition active:scale-[0.97] hover:border-acento"
          >
            Iniciar sesión
            <ChevronDown id="nodo-login-chevron" class="size-3.5 transition-transform" stroke-width={2} />
          </button>

          <div
            id="nodo-login-panel"
            class="absolute right-0 top-full z-50 mt-2 hidden w-60 overflow-hidden rounded-2xl border border-linea bg-superficie shadow-[var(--c-sombra)] backdrop-blur-xl"
          >
            <button
              id="nodo-login-google"
              type="button"
              class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-texto transition active:scale-[0.98] hover:bg-fondo-alt"
            >
              <ProviderIcon name="google" class="size-4 shrink-0" />
              Continuar con Google
            </button>

            <div class="h-px bg-linea"></div>

            <button
              id="nodo-login-microsoft"
              type="button"
              class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-texto transition active:scale-[0.98] hover:bg-fondo-alt"
            >
              <ProviderIcon name="microsoft" class="size-4 shrink-0" />
              Continuar con Microsoft
            </button>
          </div>
        </div>
      )}
    </div>
  </nav>
</header>

<script>
  import { loginWithGoogle, loginWithMicrosoft, logout } from '../../lib/firebase/client';

  // Solo uno de los dos menus existe en cada render (segun haya sesion o no),
  // pero la mecanica -abrir, cerrar al pulsar fuera, cerrar con Escape- es la
  // misma, asi que se declara una vez y se aplica a los que esten presentes.
  interface Menu {
    root: Element;
    trigger: HTMLButtonElement;
    setOpen: (open: boolean) => void;
    isOpen: () => boolean;
  }

  function createMenu(triggerId: string, panelId: string, chevronId?: string): Menu | null {
    const trigger = document.getElementById(triggerId) as HTMLButtonElement | null;
    const panel = document.getElementById(panelId);
    const root = trigger?.closest('[data-menu]');

    if (!trigger || !panel || !root) {
      return null;
    }

    const chevron = chevronId ? document.getElementById(chevronId) : null;

    const setOpen = (open: boolean): void => {
      panel.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => setOpen(!isOpen()));

    return { root, trigger, setOpen, isOpen };
  }

  const menus = [
    createMenu('nodo-login-trigger', 'nodo-login-panel', 'nodo-login-chevron'),
    createMenu('nodo-user-trigger', 'nodo-user-panel'),
  ].filter((menu): menu is Menu => menu !== null);

  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (!menu.root.contains(event.target as Node)) {
        menu.setOpen(false);
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return;
    }
    for (const menu of menus) {
      // Devolver el foco al disparador: si el menu se cierra y el foco se
      // queda en un elemento oculto, la navegacion por teclado se pierde.
      if (menu.isOpen()) {
        menu.setOpen(false);
        menu.trigger.focus();
      }
    }
  });

  const googleButton = document.getElementById('nodo-login-google') as HTMLButtonElement | null;
  const microsoftButton = document.getElementById('nodo-login-microsoft') as HTMLButtonElement | null;
  const logoutButton = document.getElementById('nodo-logout-button') as HTMLButtonElement | null;

  function setLoginMenuOpen(open: boolean): void {
    menus.find((menu) => menu.trigger.id === 'nodo-login-trigger')?.setOpen(open);
  }

  async function handleLogin(button: HTMLButtonElement, login: () => Promise<void>): Promise<void> {
    button.disabled = true;

    try {
      await login();
    } catch (error) {
      console.error('No se pudo iniciar sesión:', error);
      button.disabled = false;
    }
  }

  googleButton?.addEventListener('click', () => {
    setLoginMenuOpen(false);
    handleLogin(googleButton, loginWithGoogle);
  });

  microsoftButton?.addEventListener('click', () => {
    setLoginMenuOpen(false);
    handleLogin(microsoftButton, loginWithMicrosoft);
  });

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;
    await logout();
  });
</script>
