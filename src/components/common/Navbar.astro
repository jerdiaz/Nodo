---
import { ChevronDown, LogOut, Plus, Settings, User } from '@lucide/astro';
import { getCurrentUser } from '../../lib/auth';

const user = await getCurrentUser(Astro.cookies);

const links = [
  { href: '/', label: 'Explorar' },
  { href: '/calendario', label: 'Calendario' },
  { href: '/comunidades', label: 'Comunidades' },
  ...(user ? [{ href: '/mis-eventos', label: 'Mis eventos' }] : []),
];
---

<header class="sticky top-0 z-50 border-b border-white/[0.08] bg-neutral-950/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-neutral-100">
      <img src="/logo-icon.png" alt="" class="size-7" />
      Nodo<span class="text-emerald-400">.</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm text-neutral-400 md:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition hover:text-neutral-100">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/eventos/nuevo"
        class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-950 transition active:scale-[0.97] hover:bg-emerald-400"
      >
        <Plus class="size-4" stroke-width={2.5} />
        Publicar evento
      </a>

      {user ? (
        <div class="relative" data-menu>
          <button
            id="nodo-user-trigger"
            type="button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={`Cuenta de ${user.name}`}
            class="block rounded-full ring-2 ring-transparent transition active:scale-[0.97] hover:ring-white/20 aria-expanded:ring-emerald-400/60"
          >
            {user.avatarUrl ? (
              <img src={user.avatarUrl} alt="" class="size-8 rounded-full object-cover" />
            ) : (
              <span class="flex size-8 items-center justify-center rounded-full bg-neutral-800 text-xs font-medium text-neutral-300">
                {user.name.charAt(0).toUpperCase()}
              </span>
            )}
          </button>

          <div
            id="nodo-user-panel"
            role="menu"
            aria-labelledby="nodo-user-trigger"
            class="absolute right-0 top-full z-50 mt-2 hidden w-64 overflow-hidden rounded-2xl border border-white/[0.08] bg-neutral-900/90 shadow-[0_1px_1px_rgba(0,0,0,0.3),0_16px_32px_-8px_rgba(0,0,0,0.55)] backdrop-blur-xl"
          >
            <div class="flex items-center gap-3 px-4 py-3.5">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt="" class="size-10 shrink-0 rounded-full object-cover" />
              ) : (
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-neutral-800 text-sm font-medium text-neutral-300">
                  {user.name.charAt(0).toUpperCase()}
                </span>
              )}
              {/* min-w-0 es lo que permite que truncate funcione dentro de un
                  flex: sin el, el nombre largo estira la caja en vez de cortarse. */}
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-neutral-100">{user.name}</p>
                {user.email && <p class="truncate text-xs text-neutral-500">{user.email}</p>}
              </div>
            </div>

            <div class="h-px bg-white/[0.08]"></div>

            <a
              href="/perfil"
              role="menuitem"
              class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-neutral-200 transition hover:bg-white/5"
            >
              <User class="size-4 shrink-0" stroke-width={1.75} />
              Ver perfil
            </a>

            <a
              href="/configuracion"
              role="menuitem"
              class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-neutral-200 transition hover:bg-white/5"
            >
              <Settings class="size-4 shrink-0" stroke-width={1.75} />
              Configuración
            </a>

            <div class="h-px bg-white/[0.08]"></div>

            <button
              id="nodo-logout-button"
              type="button"
              role="menuitem"
              class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm font-medium text-neutral-200 transition hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <LogOut class="size-4 shrink-0" stroke-width={1.75} />
              Cerrar sesión
            </button>
          </div>
        </div>
      ) : (
        <div class="relative" data-menu>
          <button
            id="nodo-login-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.08] bg-neutral-900/60 px-3.5 py-2 text-sm font-medium text-neutral-200 transition active:scale-[0.97] hover:border-white/20"
          >
            Iniciar sesión
            <ChevronDown id="nodo-login-chevron" class="size-3.5 transition-transform" stroke-width={2} />
          </button>

          <div
            id="nodo-login-panel"
            class="absolute right-0 top-full z-50 mt-2 hidden w-60 overflow-hidden rounded-2xl border border-white/[0.08] bg-neutral-900/90 shadow-[0_1px_1px_rgba(0,0,0,0.3),0_16px_32px_-8px_rgba(0,0,0,0.55)] backdrop-blur-xl"
          >
            <button
              id="nodo-login-google"
              type="button"
              class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-neutral-200 transition active:scale-[0.98] hover:bg-white/5"
            >
              <svg class="size-4 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
                <path
                  fill="#FFC107"
                  d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12 c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24 c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"
                ></path>
                <path
                  fill="#FF3D00"
                  d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039 l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"
                ></path>
                <path
                  fill="#4CAF50"
                  d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36 c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"
                ></path>
                <path
                  fill="#1976D2"
                  d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571 c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"
                ></path>
              </svg>
              Continuar con Google
            </button>

            <div class="h-px bg-white/[0.08]"></div>

            <button
              id="nodo-login-microsoft"
              type="button"
              class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-neutral-200 transition active:scale-[0.98] hover:bg-white/5"
            >
              <svg class="size-4 shrink-0" viewBox="0 0 23 23" aria-hidden="true">
                <path fill="#f25022" d="M1 1h10v10H1z"></path>
                <path fill="#7fba00" d="M12 1h10v10H12z"></path>
                <path fill="#00a4ef" d="M1 12h10v10H1z"></path>
                <path fill="#ffb900" d="M12 12h10v10H12z"></path>
              </svg>
              Continuar con Microsoft
            </button>
          </div>
        </div>
      )}
    </div>
  </nav>
</header>

<script>
  import { loginWithGoogle, loginWithMicrosoft, logout } from '../../lib/firebase/client';

  // Solo uno de los dos menus existe en cada render (segun haya sesion o no),
  // pero la mecanica -abrir, cerrar al pulsar fuera, cerrar con Escape- es la
  // misma, asi que se declara una vez y se aplica a los que esten presentes.
  interface Menu {
    root: Element;
    trigger: HTMLButtonElement;
    setOpen: (open: boolean) => void;
    isOpen: () => boolean;
  }

  function createMenu(triggerId: string, panelId: string, chevronId?: string): Menu | null {
    const trigger = document.getElementById(triggerId) as HTMLButtonElement | null;
    const panel = document.getElementById(panelId);
    const root = trigger?.closest('[data-menu]');

    if (!trigger || !panel || !root) {
      return null;
    }

    const chevron = chevronId ? document.getElementById(chevronId) : null;

    const setOpen = (open: boolean): void => {
      panel.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => setOpen(!isOpen()));

    return { root, trigger, setOpen, isOpen };
  }

  const menus = [
    createMenu('nodo-login-trigger', 'nodo-login-panel', 'nodo-login-chevron'),
    createMenu('nodo-user-trigger', 'nodo-user-panel'),
  ].filter((menu): menu is Menu => menu !== null);

  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (!menu.root.contains(event.target as Node)) {
        menu.setOpen(false);
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return;
    }
    for (const menu of menus) {
      // Devolver el foco al disparador: si el menu se cierra y el foco se
      // queda en un elemento oculto, la navegacion por teclado se pierde.
      if (menu.isOpen()) {
        menu.setOpen(false);
        menu.trigger.focus();
      }
    }
  });

  const googleButton = document.getElementById('nodo-login-google') as HTMLButtonElement | null;
  const microsoftButton = document.getElementById('nodo-login-microsoft') as HTMLButtonElement | null;
  const logoutButton = document.getElementById('nodo-logout-button') as HTMLButtonElement | null;

  function setLoginMenuOpen(open: boolean): void {
    menus.find((menu) => menu.trigger.id === 'nodo-login-trigger')?.setOpen(open);
  }

  async function handleLogin(button: HTMLButtonElement, login: () => Promise<void>): Promise<void> {
    button.disabled = true;

    try {
      await login();
    } catch (error) {
      console.error('No se pudo iniciar sesión:', error);
      button.disabled = false;
    }
  }

  googleButton?.addEventListener('click', () => {
    setLoginMenuOpen(false);
    handleLogin(googleButton, loginWithGoogle);
  });

  microsoftButton?.addEventListener('click', () => {
    setLoginMenuOpen(false);
    handleLogin(microsoftButton, loginWithMicrosoft);
  });

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;
    await logout();
  });
</script>
