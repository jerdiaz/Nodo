---
import { cn } from '../../lib/utils';
import { buildFilterHref } from '../../lib/eventFilterHref';

interface Props {
  cities: string[];
  selectedModality?: string;
  selectedCity?: string;
  selectedTimeframe?: 'past';
  selectedSearch?: string;
}

const { cities, selectedModality, selectedCity, selectedTimeframe, selectedSearch } = Astro.props;

const showCityFilter = !selectedModality || selectedModality === 'presencial';
---

<div class="flex flex-col items-start gap-3 sm:items-end">
  {showCityFilter && cities.length > 0 && (
    <div class="flex flex-wrap justify-end gap-2">
      <a
        href={buildFilterHref({ modality: selectedModality, timeframe: selectedTimeframe, search: selectedSearch, list: true })}
        class={cn(
          'rounded-full px-3 py-1 text-xs font-medium transition active:scale-[0.97]',
          !selectedCity
            ? 'bg-acento text-acento-contraste'
            : 'bg-superficie text-suave hover:text-texto',
        )}
      >
        Todas las ciudades
      </a>
      {cities.map((city) => (
        <a
          href={buildFilterHref({
            modality: selectedModality,
            city,
            timeframe: selectedTimeframe,
            search: selectedSearch,
            list: true,
          })}
          class={cn(
            'rounded-full px-3 py-1 text-xs font-medium transition active:scale-[0.97]',
            selectedCity === city
              ? 'bg-acento text-acento-contraste'
              : 'bg-superficie text-suave hover:text-texto',
          )}
        >
          {city}
        </a>
      ))}
    </div>
  )}

  <a
    href={
      selectedTimeframe === 'past'
        ? buildFilterHref({ modality: selectedModality, city: selectedCity, search: selectedSearch, list: true })
        : buildFilterHref({ modality: selectedModality, city: selectedCity, timeframe: 'past', search: selectedSearch, list: true })
    }
    class="text-xs text-tenue underline-offset-2 transition hover:text-suave hover:underline"
  >
    {selectedTimeframe === 'past' ? 'Ver próximos eventos' : 'Ver eventos pasados'}
  </a>
</div>
