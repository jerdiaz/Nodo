---
import { Upload } from '@lucide/astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import type { NodoEvent } from '../../types/event';

interface Props {
  event?: NodoEvent;
}

const { event } = Astro.props;
const isEdit = Boolean(event);

function toDatetimeLocalValue(date: Date, timezone: string): string {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: timezone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(date);

  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '00';

  return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}`;
}

const startValue = event ? toDatetimeLocalValue(event.startDate, event.timezone) : '';
const endValue = event ? toDatetimeLocalValue(event.endDate, event.timezone) : '';
const tagsValue = event ? event.tags.join(', ') : '';
const submitUrl = isEdit ? `/api/events/${event!.id}` : '/api/events';
const submitMethod = isEdit ? 'PUT' : 'POST';
const submitLabel = isEdit ? 'Guardar cambios' : 'Publicar evento';
const cancelHref = isEdit ? `/eventos/${event!.slug}` : '/';

const inputClass =
  'mt-1.5 w-full rounded-lg border border-neutral-800 bg-neutral-900 px-3.5 py-2.5 text-sm text-neutral-100 placeholder:text-neutral-600 focus:border-emerald-500/60 focus:outline-none focus:ring-1 focus:ring-emerald-500/60';
---

<Card class="mt-8 p-8">
  <form
    id="event-form"
    novalidate
    data-method={submitMethod}
    data-action={submitUrl}
    data-existing-banner={event?.bannerUrl ?? ''}
    class="space-y-6"
  >
    <input type="hidden" id="timezone" name="timezone" />

    <div>
      <label for="bannerFile" class="block text-sm font-medium text-neutral-300">
        Banner <span class="text-neutral-600">(opcional)</span>
      </label>
      <label
        for="bannerFile"
        id="banner-dropzone"
        class="mt-1.5 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-white/20 bg-neutral-950/40 px-6 py-10 text-center transition-colors hover:border-emerald-500/50"
      >
        <Upload class="size-5 text-neutral-500" stroke-width={1.75} />
        <span class="text-sm text-neutral-300">Sube la imagen de portada (16:9 recomendado)</span>
        <span class="text-xs text-neutral-600">Arrastra y suelta, o haz clic para elegir. JPG, PNG o WEBP, máx. 5 MB.</span>
        <input id="bannerFile" name="bannerFile" type="file" accept="image/*" class="sr-only" />
      </label>
      <img
        id="banner-preview"
        class={`mt-3 aspect-[16/9] w-full rounded-lg object-cover ${event?.bannerUrl ? '' : 'hidden'}`}
        src={event?.bannerUrl}
        alt="Vista previa del banner"
      />
    </div>

    <div>
      <label for="title" class="block text-sm font-medium text-neutral-300">Título</label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="140"
        class={inputClass}
        placeholder="Taller de cerámica comunitaria"
        value={event?.title ?? ''}
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-neutral-300">Modalidad</label>
      <div class="mt-1.5 grid grid-cols-3 gap-1 rounded-xl border border-neutral-800 bg-neutral-950/40 p-1">
        <button type="button" data-modality-option="presencial" class="modality-tab rounded-lg px-3 py-2 text-sm font-medium transition-colors">
          Presencial
        </button>
        <button type="button" data-modality-option="virtual" class="modality-tab rounded-lg px-3 py-2 text-sm font-medium transition-colors">
          Virtual
        </button>
        <button type="button" data-modality-option="hibrido" class="modality-tab rounded-lg px-3 py-2 text-sm font-medium transition-colors">
          Híbrido
        </button>
      </div>
      <input type="hidden" id="modality" name="modality" value={event?.modality ?? 'presencial'} />
    </div>

    <div data-field-group="location" class="space-y-4">
      <div>
        <label for="city" class="block text-sm font-medium text-neutral-300">Ciudad</label>
        <input id="city" name="city" type="text" class={inputClass} placeholder="Bogotá" value={event?.city ?? ''} />
      </div>
      <div>
        <label for="venue" class="block text-sm font-medium text-neutral-300">Lugar</label>
        <input
          id="venue"
          name="venue"
          type="text"
          class={inputClass}
          placeholder="Casa Taller Chapinero"
          value={event?.venue ?? ''}
        />
      </div>
      <div>
        <label for="address" class="block text-sm font-medium text-neutral-300">Dirección</label>
        <input
          id="address"
          name="address"
          type="text"
          class={inputClass}
          placeholder="Cra 13 #45-12"
          value={event?.address ?? ''}
        />
      </div>
    </div>

    <div data-field-group="online" class="hidden">
      <label for="meetingUrl" class="block text-sm font-medium text-neutral-300">Enlace de reunión</label>
      <input
        id="meetingUrl"
        name="meetingUrl"
        type="url"
        class={inputClass}
        placeholder="https://meet.google.com/..."
        value={event?.meetingUrl ?? ''}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="startDate" class="block text-sm font-medium text-neutral-300">Inicio</label>
        <input
          id="startDate"
          name="startDate"
          type="datetime-local"
          required
          class={inputClass}
          value={startValue}
        />
      </div>
      <div>
        <label for="endDate" class="block text-sm font-medium text-neutral-300">Fin</label>
        <input id="endDate" name="endDate" type="datetime-local" required class={inputClass} value={endValue} />
      </div>
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-neutral-300">Descripción</label>
      <textarea
        id="description"
        name="description"
        required
        rows="5"
        class={inputClass}
        placeholder="Cuéntale a la comunidad de qué se trata tu evento..."
      >{event?.description ?? ''}</textarea>
    </div>

    <div>
      <label for="tag-input-field" class="block text-sm font-medium text-neutral-300">
        Categoría / Etiquetas
      </label>
      <div
        id="tags-editor"
        class="mt-1.5 flex flex-wrap items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 focus-within:border-emerald-500/60 focus-within:ring-1 focus-within:ring-emerald-500/60"
      >
        <div id="tag-chips" class="flex flex-wrap gap-2"></div>
        <input
          id="tag-input-field"
          type="text"
          placeholder="Agregar etiqueta y presiona Enter..."
          class="min-w-32 flex-1 bg-transparent py-1 text-sm text-neutral-100 placeholder:text-neutral-600 focus:outline-none"
        />
      </div>
      <input type="hidden" id="tags" name="tags" value={tagsValue} />
    </div>

    <p id="form-error" class="hidden text-sm text-red-400"></p>

    <div class="flex items-center justify-end gap-3 pt-2">
      <Button variant="secondary" href={cancelHref}>Cancelar</Button>
      <Button variant="primary" type="submit" id="submit-button">{submitLabel}</Button>
    </div>
  </form>
</Card>

<script>
  import { uploadEventBanner } from '../../lib/firebase/client';

  const MAX_BANNER_SIZE = 5 * 1024 * 1024;

  const form = document.getElementById('event-form') as HTMLFormElement;
  const modalityInput = document.getElementById('modality') as HTMLInputElement;
  const modalityTabs = document.querySelectorAll<HTMLButtonElement>('.modality-tab');
  const locationGroup = document.querySelector('[data-field-group="location"]') as HTMLElement;
  const onlineGroup = document.querySelector('[data-field-group="online"]') as HTMLElement;
  const cityInput = document.getElementById('city') as HTMLInputElement;
  const meetingUrlInput = document.getElementById('meetingUrl') as HTMLInputElement;
  const bannerDropzone = document.getElementById('banner-dropzone') as HTMLLabelElement;
  const bannerInput = document.getElementById('bannerFile') as HTMLInputElement;
  const bannerPreview = document.getElementById('banner-preview') as HTMLImageElement;
  const timezoneInput = document.getElementById('timezone') as HTMLInputElement;
  const tagsHiddenInput = document.getElementById('tags') as HTMLInputElement;
  const tagChipsContainer = document.getElementById('tag-chips') as HTMLElement;
  const tagInputField = document.getElementById('tag-input-field') as HTMLInputElement;
  const errorBox = document.getElementById('form-error') as HTMLParagraphElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;

  const originalButtonText = submitButton.textContent ?? 'Publicar evento';

  timezoneInput.value = Intl.DateTimeFormat().resolvedOptions().timeZone;

  // --- Modalidad: tabs segmentadas ---
  function setActiveModalityTab(value: string): void {
    modalityTabs.forEach((tab) => {
      const isActive = tab.dataset.modalityOption === value;
      tab.classList.toggle('border', isActive);
      tab.classList.toggle('border-emerald-500/50', isActive);
      tab.classList.toggle('bg-emerald-500/10', isActive);
      tab.classList.toggle('text-emerald-400', isActive);
      tab.classList.toggle('text-neutral-400', !isActive);
      tab.classList.toggle('hover:text-neutral-200', !isActive);
    });
  }

  function updateConditionalFields(): void {
    const modality = modalityInput.value;
    const showLocation = modality === 'presencial' || modality === 'hibrido';
    const showOnline = modality === 'virtual' || modality === 'hibrido';

    locationGroup.classList.toggle('hidden', !showLocation);
    onlineGroup.classList.toggle('hidden', !showOnline);

    cityInput.required = showLocation;
    meetingUrlInput.required = showOnline;
  }

  modalityTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const value = tab.dataset.modalityOption;
      if (!value) {
        return;
      }
      modalityInput.value = value;
      setActiveModalityTab(value);
      updateConditionalFields();
    });
  });

  setActiveModalityTab(modalityInput.value);
  updateConditionalFields();

  // --- Banner: dropzone con vista previa y soporte drag & drop ---
  function handleBannerFile(file: File | undefined): void {
    if (!file) {
      const existingBanner = form.dataset.existingBanner;
      if (existingBanner) {
        bannerPreview.src = existingBanner;
        bannerPreview.classList.remove('hidden');
      } else {
        bannerPreview.classList.add('hidden');
        bannerPreview.removeAttribute('src');
      }
      return;
    }

    bannerPreview.src = URL.createObjectURL(file);
    bannerPreview.classList.remove('hidden');
  }

  bannerInput.addEventListener('change', () => handleBannerFile(bannerInput.files?.[0]));

  bannerDropzone.addEventListener('dragover', (event) => {
    event.preventDefault();
    bannerDropzone.classList.add('border-emerald-500/50');
  });

  bannerDropzone.addEventListener('dragleave', () => {
    bannerDropzone.classList.remove('border-emerald-500/50');
  });

  bannerDropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    bannerDropzone.classList.remove('border-emerald-500/50');

    const file = event.dataTransfer?.files?.[0];
    if (file) {
      bannerInput.files = event.dataTransfer.files;
      handleBannerFile(file);
    }
  });

  // --- Etiquetas: chips removibles ---
  let tags: string[] = tagsHiddenInput.value
    ? tagsHiddenInput.value
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
    : [];

  function renderTags(): void {
    tagChipsContainer.innerHTML = '';

    tags.forEach((tag, index) => {
      const chip = document.createElement('span');
      chip.className =
        'inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-400';

      const label = document.createElement('span');
      label.textContent = tag;

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.textContent = '×';
      removeButton.setAttribute('aria-label', `Quitar etiqueta ${tag}`);
      removeButton.className = 'leading-none text-emerald-400/70 hover:text-emerald-200';
      removeButton.addEventListener('click', () => {
        tags.splice(index, 1);
        renderTags();
      });

      chip.append(label, removeButton);
      tagChipsContainer.appendChild(chip);
    });

    tagsHiddenInput.value = tags.join(', ');
  }

  function addTagFromInput(): void {
    const value = tagInputField.value.trim();
    if (value && !tags.includes(value)) {
      tags.push(value);
      renderTags();
    }
    tagInputField.value = '';
  }

  tagInputField.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ',') {
      event.preventDefault();
      addTagFromInput();
    } else if (event.key === 'Backspace' && tagInputField.value === '' && tags.length > 0) {
      tags.pop();
      renderTags();
    }
  });

  tagInputField.addEventListener('blur', () => {
    if (tagInputField.value.trim()) {
      addTagFromInput();
    }
  });

  renderTags();

  // Los inputs `datetime-local` no llevan zona horaria: `new Date(valor)`
  // los interpreta con la hora local de quien ejecuta el código. Se
  // resuelven aquí, en el navegador (con la hora local real de quien
  // publica), a un ISO string absoluto en UTC — así el servidor, sin
  // importar en qué huso horario corra, interpreta el instante correcto.
  function toIsoStringOrEmpty(value: FormDataEntryValue | null): string {
    if (typeof value !== 'string' || !value) {
      return '';
    }
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '' : date.toISOString();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');

    if (tagInputField.value.trim()) {
      addTagFromInput();
    }

    const bannerFile = bannerInput.files?.[0];

    if (bannerFile && bannerFile.size > MAX_BANNER_SIZE) {
      errorBox.textContent = 'La imagen no puede superar 5 MB.';
      errorBox.classList.remove('hidden');
      return;
    }

    submitButton.disabled = true;

    try {
      // Sin archivo nuevo, bannerUrl queda `undefined` y el banner actual
      // (si lo hay) se conserva sin cambios en la actualización.
      let bannerUrl: string | undefined;

      if (bannerFile) {
        submitButton.textContent = 'Subiendo imagen…';
        bannerUrl = await uploadEventBanner(bannerFile);
      }

      submitButton.textContent = form.dataset.method === 'PUT' ? 'Guardando…' : 'Publicando…';

      const formData = new FormData(form);
      const tagsRaw = String(formData.get('tags') ?? '');

      const payload = {
        title: formData.get('title'),
        description: formData.get('description'),
        modality: formData.get('modality'),
        city: formData.get('city') || undefined,
        venue: formData.get('venue') || undefined,
        address: formData.get('address') || undefined,
        meetingUrl: formData.get('meetingUrl') || undefined,
        bannerUrl,
        startDate: toIsoStringOrEmpty(formData.get('startDate')),
        endDate: toIsoStringOrEmpty(formData.get('endDate')),
        timezone: formData.get('timezone') || undefined,
        tags: tagsRaw
          .split(',')
          .map((tag) => tag.trim())
          .filter(Boolean),
      };

      const response = await fetch(form.dataset.action ?? '/api/events', {
        method: form.dataset.method ?? 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo guardar el evento.');
      }

      const statusParam = form.dataset.method === 'PUT' ? 'updated' : 'created';
      window.location.href = `/eventos/${result.slug}?${statusParam}=true`;
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar el evento.';
      errorBox.classList.remove('hidden');
      submitButton.disabled = false;
      submitButton.textContent = originalButtonText;
    }
  });
</script>
