---
import Card from '../ui/Card.astro';
import ImageCropper from '../ui/ImageCropper.astro';
import Button from '../ui/Button.astro';
import type { NodoEvent } from '../../types/event';
import type { NodoCommunity } from '../../types/community';
import DateTimePicker from './DateTimePicker.astro';

interface Props {
  event?: NodoEvent;
  // La comunidad que administra quien esta rellenando el formulario, si tiene
  // alguna. Sin ella no hay nada que elegir y el selector no se dibuja.
  community?: NodoCommunity | null;
}

const { event, community } = Astro.props;
const isEdit = Boolean(event);

// Al crear se propone la comunidad, que es para lo que se creo; al editar
// manda lo que el evento ya tenga, para no cambiarle el autor a quien solo
// venia a corregir una hora.
const publishAsValue = isEdit ? (event?.community ? 'comunidad' : 'persona') : 'comunidad';

function toDatetimeLocalValue(date: Date, timezone: string): string {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: timezone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(date);

  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '00';

  return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}`;
}

const startValue = event ? toDatetimeLocalValue(event.startDate, event.timezone) : '';
const endValue = event ? toDatetimeLocalValue(event.endDate, event.timezone) : '';
const tagsValue = event ? event.tags.join(', ') : '';
const submitUrl = isEdit ? `/api/events/${event!.id}` : '/api/events';
const submitMethod = isEdit ? 'PUT' : 'POST';
const submitLabel = isEdit ? 'Guardar cambios' : 'Publicar evento';
const cancelHref = isEdit ? `/eventos/${event!.slug}` : '/';

const inputClass =
  'mt-1.5 w-full rounded-xl bg-superficie px-3.5 py-2.5 text-sm text-texto placeholder:text-tenue ring-1 ring-inset ring-linea focus-visible:outline-none focus:ring-2 focus:ring-acento';
---

<Card class="mt-8 p-8">
  <form
    id="event-form"
    novalidate
    data-method={submitMethod}
    data-action={submitUrl}
    data-timezone={event?.timezone ?? ''}
    class="space-y-6"
  >
    <input type="hidden" id="timezone" name="timezone" />

    <ImageCropper
      id="bannerUrl"
      name="bannerUrl"
      kind="banner"
      label="Banner (opcional)"
      value={event?.bannerUrl ?? ''}
      hint="Arrastra la imagen de portada o haz clic para elegirla. Se recorta a 16:9."
    />
    <input type="hidden" id="bannerSmallUrl" name="bannerSmallUrl" value={event?.bannerSmallUrl ?? ''} />

    <div>
      <label for="title" class="block text-sm font-medium text-texto">Título</label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="140"
        class={inputClass}
        placeholder="Taller de cerámica comunitaria"
        value={event?.title ?? ''}
      />
    </div>

    {community && (
      <div>
        <label class="block text-sm font-medium text-texto">Publicar como</label>
        <div
          class="mt-1.5 grid grid-cols-2 gap-1 rounded-2xl border border-linea bg-fondo-alt p-1"
          role="radiogroup"
          aria-label="Publicar como"
        >
          <button type="button" role="radio" aria-checked={publishAsValue === 'persona'} data-publish-option="persona" class="publish-tab rounded-xl px-3 py-2 text-sm font-medium transition active:scale-[0.97]">
            A mi nombre
          </button>
          <button type="button" role="radio" aria-checked={publishAsValue === 'comunidad'} data-publish-option="comunidad" class="publish-tab truncate rounded-xl px-3 py-2 text-sm font-medium transition active:scale-[0.97]">
            {community.name}
          </button>
        </div>
        <input type="hidden" id="publishAs" name="publishAs" value={publishAsValue} />
        <p class="mt-1.5 text-xs text-tenue">
          En la cartelera se ve el nombre que elijas aquí. Quien lo creó siempre aparece en la ficha del evento.
        </p>
      </div>
    )}

      <div>
        <label class="block text-sm font-medium text-texto">Modalidad</label>
        <div
          class="mt-1.5 grid grid-cols-3 gap-1 rounded-2xl border border-linea bg-fondo-alt p-1"
          role="radiogroup"
          aria-label="Modalidad"
        >
          <button type="button" role="radio" aria-checked={(event?.modality ?? 'presencial') === 'presencial'} data-modality-option="presencial" class="modality-tab rounded-xl px-3 py-2 text-sm font-medium transition active:scale-[0.97]">
            Presencial
          </button>
          <button type="button" role="radio" aria-checked={(event?.modality ?? 'presencial') === 'virtual'} data-modality-option="virtual" class="modality-tab rounded-xl px-3 py-2 text-sm font-medium transition active:scale-[0.97]">
            Virtual
          </button>
          <button type="button" role="radio" aria-checked={(event?.modality ?? 'presencial') === 'hibrido'} data-modality-option="hibrido" class="modality-tab rounded-xl px-3 py-2 text-sm font-medium transition active:scale-[0.97]">
            Híbrido
          </button>
        </div>
      <input type="hidden" id="modality" name="modality" value={event?.modality ?? 'presencial'} />
    </div>

    <div data-field-group="location" class="space-y-4">
      <div>
        <label for="city" class="block text-sm font-medium text-texto">Ciudad</label>
        <input id="city" name="city" type="text" class={inputClass} placeholder="Bogotá" value={event?.city ?? ''} />
      </div>
      <div>
        <label for="venue" class="block text-sm font-medium text-texto">Lugar</label>
        <input
          id="venue"
          name="venue"
          type="text"
          class={inputClass}
          placeholder="Casa Taller Chapinero"
          value={event?.venue ?? ''}
        />
      </div>
      <div>
        <label for="address" class="block text-sm font-medium text-texto">Dirección</label>
        <input
          id="address"
          name="address"
          type="text"
          class={inputClass}
          placeholder="Cra 13 #45-12"
          value={event?.address ?? ''}
        />
      </div>
    </div>

    <div data-field-group="online" class="hidden">
      <label for="meetingUrl" class="block text-sm font-medium text-texto">Enlace de reunión</label>
      <input
        id="meetingUrl"
        name="meetingUrl"
        type="url"
        class={inputClass}
        placeholder="https://meet.google.com/..."
        value={event?.meetingUrl ?? ''}
      />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <DateTimePicker id="startDate" name="startDate" label="Inicio" value={startValue} class={inputClass} />
      <DateTimePicker id="endDate" name="endDate" label="Fin" value={endValue} class={inputClass} />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-texto">Descripción</label>
      <textarea
        id="description"
        name="description"
        required
        rows="5"
        class={inputClass}
        placeholder="Cuéntale a la comunidad de qué se trata tu evento..."
      >{event?.description ?? ''}</textarea>
    </div>

    <div>
      <label for="tag-input-field" class="block text-sm font-medium text-texto">
        Categoría / Etiquetas
      </label>
      <div
        id="tags-editor"
        class="mt-1.5 flex flex-wrap items-center gap-2 rounded-xl bg-superficie px-3 py-2 ring-1 ring-inset ring-linea focus-within:ring-2 focus-within:ring-acento"
      >
        <div id="tag-chips" class="flex flex-wrap gap-2"></div>
        <input
          id="tag-input-field"
          type="text"
          placeholder="Agregar etiqueta y presiona Enter..."
          class="min-w-32 flex-1 bg-transparent py-1 text-sm text-texto placeholder:text-tenue focus-visible:outline-none"
        />
      </div>
      <input type="hidden" id="tags" name="tags" value={tagsValue} />
    </div>

    <p id="form-error" class="hidden text-sm text-acento-texto"></p>

    <div class="flex items-center justify-end gap-3 pt-2">
      <Button variant="secondary" href={cancelHref}>Cancelar</Button>
      <Button variant="primary" type="submit" id="submit-button">{submitLabel}</Button>
    </div>
  </form>
</Card>

<script>

  const form = document.getElementById('event-form') as HTMLFormElement;
  const modalityInput = document.getElementById('modality') as HTMLInputElement;
  const modalityTabs = document.querySelectorAll<HTMLButtonElement>('.modality-tab');
  // Solo existe si esta persona administra una comunidad.
  const publishTabs = document.querySelectorAll<HTMLButtonElement>('.publish-tab');
  const publishInput = document.getElementById('publishAs') as HTMLInputElement | null;
  const locationGroup = document.querySelector('[data-field-group="location"]') as HTMLElement;
  const onlineGroup = document.querySelector('[data-field-group="online"]') as HTMLElement;
  const cityInput = document.getElementById('city') as HTMLInputElement;
  const meetingUrlInput = document.getElementById('meetingUrl') as HTMLInputElement;
  const bannerUrlInput = document.getElementById('bannerUrl') as HTMLInputElement;
  const bannerSmallUrlInput = document.getElementById('bannerSmallUrl') as HTMLInputElement;
  const timezoneInput = document.getElementById('timezone') as HTMLInputElement;
  const tagsHiddenInput = document.getElementById('tags') as HTMLInputElement;
  const tagChipsContainer = document.getElementById('tag-chips') as HTMLElement;
  const tagInputField = document.getElementById('tag-input-field') as HTMLInputElement;
  const errorBox = document.getElementById('form-error') as HTMLParagraphElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;

  const originalButtonText = submitButton.textContent ?? 'Publicar evento';

  // El evento guarda su propia zona horaria. Al crear, manda la del navegador;
  // al editar, la del evento tal como se guardo: pisarla con la del navegador
  // desplazaria el instante cuando alguien edita desde otro huso.
  timezoneInput.value = form.dataset.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone;
  const eventTimezone = timezoneInput.value;

  // --- Fechas: minutos en punto por defecto, sin fechas pasadas, fin nunca antes que inicio ---
  const startDateInput = document.getElementById('startDate') as HTMLInputElement;
  const endDateInput = document.getElementById('endDate') as HTMLInputElement;

  function pad(value: number): string {
    return String(value).padStart(2, '0');
  }

  // Los inputs datetime-local no llevan zona horaria, asi que se arma el
  // string con la hora local del navegador y no con metodos UTC.
  function toLocalInputValue(date: Date): string {
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  }

  // Suma una hora a un valor "YYYY-MM-DDTHH:mm" sin pasar por fechas locales:
  // el string es la hora de pared del evento (su huso), no la del navegador.
  function wallPlusOneHour(value: string): string {
    const [datePart, timePart] = value.split('T');
    const [y, m, d] = datePart.split('-').map(Number);
    const [h, min] = timePart.split(':').map(Number);
    const shifted = new Date(Date.UTC(y, m - 1, d, h + 1, min));
    return `${shifted.getUTCFullYear()}-${pad(shifted.getUTCMonth() + 1)}-${pad(shifted.getUTCDate())}T${pad(shifted.getUTCHours())}:${pad(shifted.getUTCMinutes())}`;
  }

  // Un evento nuevo empieza vacio (ver startValue/endValue arriba); si ya
  // trae valor es porque se esta editando uno existente, y ese no se toca.
  if (!startDateInput.value) {
    const inicioSugerido = new Date();
    inicioSugerido.setHours(inicioSugerido.getHours() + 1, 0, 0, 0);
    startDateInput.value = toLocalInputValue(inicioSugerido);
    startDateInput.min = startDateInput.value;

    const finSugerido = new Date(inicioSugerido);
    finSugerido.setHours(finSugerido.getHours() + 1);
    endDateInput.value = toLocalInputValue(finSugerido);

    // Asignar .value por codigo no dispara change, y el selector de fecha se
    // entera de los cambios justamente por ahi: sin este aviso, los campos
    // tendrian valor pero seguirian mostrando "Elegir fecha".
    startDateInput.dispatchEvent(new Event('change', { bubbles: true }));
    endDateInput.dispatchEvent(new Event('change', { bubbles: true }));
  }

  // El fin nunca puede quedar antes que el inicio: el minimo del campo se
  // ata al valor de inicio y, si el fin ya elegido queda antes, se corrige
  // solo a una hora despues en vez de dejarlo en un estado invalido.
  function actualizarLimiteFin(): void {
    if (!startDateInput.value) {
      return;
    }

    endDateInput.min = startDateInput.value;

    if (endDateInput.value && endDateInput.value < startDateInput.value) {
      endDateInput.value = wallPlusOneHour(startDateInput.value);
      endDateInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  startDateInput.addEventListener('change', actualizarLimiteFin);
  actualizarLimiteFin();

  // --- Modalidad: tabs segmentadas ---
  function setActiveModalityTab(value: string): void {
    modalityTabs.forEach((tab) => {
      const isActive = tab.dataset.modalityOption === value;
      tab.setAttribute('aria-checked', String(isActive));
      tab.classList.toggle('bg-acento', isActive);
      tab.classList.toggle('text-acento-contraste', isActive);
      tab.classList.toggle('shadow-sm', isActive);
      tab.classList.toggle('text-suave', !isActive);
      tab.classList.toggle('hover:text-texto', !isActive);
    });
  }

  function setActivePublishTab(value: string): void {
    publishTabs.forEach((tab) => {
      const isActive = tab.dataset.publishOption === value;
      tab.setAttribute('aria-checked', String(isActive));
      tab.classList.toggle('bg-acento', isActive);
      tab.classList.toggle('text-acento-contraste', isActive);
      tab.classList.toggle('shadow-sm', isActive);
      tab.classList.toggle('text-suave', !isActive);
      tab.classList.toggle('hover:text-texto', !isActive);
    });
  }

  publishTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const value = tab.dataset.publishOption ?? 'persona';
      if (publishInput) publishInput.value = value;
      setActivePublishTab(value);
    });
  });

  if (publishInput) setActivePublishTab(publishInput.value);

  function updateConditionalFields(): void {
    const modality = modalityInput.value;
    const showLocation = modality === 'presencial' || modality === 'hibrido';
    const showOnline = modality === 'virtual' || modality === 'hibrido';

    locationGroup.classList.toggle('hidden', !showLocation);
    onlineGroup.classList.toggle('hidden', !showOnline);

    cityInput.required = showLocation;
    meetingUrlInput.required = showOnline;
  }

  modalityTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const value = tab.dataset.modalityOption;
      if (!value) {
        return;
      }
      modalityInput.value = value;
      setActiveModalityTab(value);
      updateConditionalFields();
    });
  });

  setActiveModalityTab(modalityInput.value);
  updateConditionalFields();

  // --- Etiquetas: chips removibles ---
  let tags: string[] = tagsHiddenInput.value
    ? tagsHiddenInput.value
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean)
    : [];

  function renderTags(): void {
    tagChipsContainer.innerHTML = '';

    tags.forEach((tag, index) => {
      const chip = document.createElement('span');
      chip.className =
        'inline-flex items-center gap-1.5 rounded-full border border-acento bg-acento-suave px-2.5 py-1 text-xs font-medium text-acento-texto';

      const label = document.createElement('span');
      label.textContent = tag;

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.textContent = '×';
      removeButton.setAttribute('aria-label', `Quitar etiqueta ${tag}`);
      removeButton.className = 'leading-none text-acento-texto hover:text-acento-texto';
      removeButton.addEventListener('click', () => {
        tags.splice(index, 1);
        renderTags();
      });

      chip.append(label, removeButton);
      tagChipsContainer.appendChild(chip);
    });

    tagsHiddenInput.value = tags.join(', ');
  }

  function addTagFromInput(): void {
    const value = tagInputField.value.trim();
    if (value && !tags.includes(value)) {
      tags.push(value);
      renderTags();
    }
    tagInputField.value = '';
  }

  tagInputField.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ',') {
      event.preventDefault();
      addTagFromInput();
    } else if (event.key === 'Backspace' && tagInputField.value === '' && tags.length > 0) {
      tags.pop();
      renderTags();
    }
  });

  tagInputField.addEventListener('blur', () => {
    if (tagInputField.value.trim()) {
      addTagFromInput();
    }
  });

  renderTags();

  // El recorte va al servidor, que lo modera antes de guardarlo.
  async function subirImagen(
    dataUrl: string,
    kind: 'avatar' | 'banner',
  ): Promise<{ url: string; urlSmall?: string }> {
    const recorte = await (await fetch(dataUrl)).blob();

    // Cuerpo binario, no FormData: multipart dispara la comprobacion de origen
    // de Astro y responde 403 detras del proxy de produccion.
    const response = await fetch(`/api/imagenes?kind=${kind}`, {
      method: 'POST',
      headers: { 'Content-Type': recorte.type || 'image/jpeg' },
      body: recorte,
    });
    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(result.error ?? 'No se pudo subir la imagen.');
    }

    return { url: result.url as string, urlSmall: result.urlSmall as string | undefined };
  }

  // --- Conversión de la hora de pared al instante, en el huso del evento ---
  // El valor de un input datetime-local no tiene zona: es la hora de pared del
  // huso en que se muestra. Al crear ese huso es el del navegador; al editar,
  // el del evento (los valores llegan ya pasados a su hora). Interpretarlos con
  // `new Date(valor)` usaria el huso del navegador y desplazaria el instante si
  // son distintos — el bug que ya se pago una vez en este repo.
  function createZonedFormatter(timeZone: string): Intl.DateTimeFormat {
    return new Intl.DateTimeFormat('en-US', {
      timeZone,
      hourCycle: 'h23',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
  }

  // Dado un instante, cuanto hay que sumar/restar a su representacion UTC para
  // obtener la hora de pared en la zona. Se calcula releyendo el instante como
  // si fuera UTC en la zona, y viendo cuanto difiere.
  function zoneOffsetAt(formatter: Intl.DateTimeFormat, instant: number): number {
    const parts = Object.fromEntries(
      formatter.formatToParts(new Date(instant)).map((part) => [part.type, part.value]),
    );
    const wallAsUtc = Date.UTC(
      Number(parts.year),
      Number(parts.month) - 1,
      Number(parts.day),
      Number(parts.hour),
      Number(parts.minute),
      Number(parts.second),
    );
    return wallAsUtc - instant;
  }

  function wallToInstant(wall: string, timeZone: string): Date {
    const [datePart, timePart] = wall.split('T');
    const [y, m, d] = datePart.split('-').map(Number);
    const [h, min] = timePart.split(':').map(Number);
    const wallAsUtc = Date.UTC(y, m - 1, d, h, min, 0, 0);

    const formatter = createZonedFormatter(timeZone);

    // Dos pasadas: la primera con la estimacion basta salvo en el borde de un
    // cambio de hora, y la segunda lo afina.
    let offset = zoneOffsetAt(formatter, wallAsUtc);
    offset = zoneOffsetAt(formatter, wallAsUtc - offset);
    return new Date(wallAsUtc - offset);
  }

  function toIsoStringOrEmpty(value: FormDataEntryValue | null, timeZone: string): string {
    if (typeof value !== 'string' || !value) {
      return '';
    }
    const date = wallToInstant(value, timeZone);
    return Number.isNaN(date.getTime()) ? '' : date.toISOString();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');

    if (tagInputField.value.trim()) {
      addTagFromInput();
    }

    submitButton.disabled = true;

    try {
      // Sin recorte nuevo, bannerUrl queda `undefined` y el banner actual
      // (si lo hay) se conserva sin cambios en la actualización. Un recorte
      // recien hecho llega como data URL; el que ya estaba guardado, como la
      // URL de Storage, que no hay que volver a subir.
      let bannerUrl: string | undefined;
      let bannerSmallUrl: string | undefined;

      if (bannerUrlInput.value.startsWith('data:')) {
        submitButton.textContent = 'Revisando imagen…';
        const subida = await subirImagen(bannerUrlInput.value, 'banner');
        bannerUrl = subida.url;
        bannerSmallUrl = subida.urlSmall;
      }

      submitButton.textContent = form.dataset.method === 'PUT' ? 'Guardando…' : 'Publicando…';

      const formData = new FormData(form);
      const tagsRaw = String(formData.get('tags') ?? '');

      const payload = {
        title: formData.get('title'),
        description: formData.get('description'),
        modality: formData.get('modality'),
        city: formData.get('city') || undefined,
        venue: formData.get('venue') || undefined,
        address: formData.get('address') || undefined,
        meetingUrl: formData.get('meetingUrl') || undefined,
        bannerUrl,
        bannerSmallUrl: bannerSmallUrl ?? (bannerSmallUrlInput.value || undefined),
        startDate: toIsoStringOrEmpty(formData.get('startDate'), eventTimezone),
        endDate: toIsoStringOrEmpty(formData.get('endDate'), eventTimezone),
        timezone: eventTimezone || undefined,
        publishAs: formData.get('publishAs') || undefined,
        tags: tagsRaw
          .split(',')
          .map((tag) => tag.trim())
          .filter(Boolean),
      };

      const response = await fetch(form.dataset.action ?? '/api/events', {
        method: form.dataset.method ?? 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'No se pudo guardar el evento.');
      }

      const statusParam = form.dataset.method === 'PUT' ? 'updated' : 'created';
      window.location.href = `/eventos/${result.slug}?${statusParam}=true`;
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar el evento.';
      errorBox.classList.remove('hidden');
      submitButton.disabled = false;
      submitButton.textContent = originalButtonText;
    }
  });
</script>
