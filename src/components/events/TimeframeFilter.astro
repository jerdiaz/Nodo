---
import { cn } from '../../lib/utils';
import { buildFilterHref } from '../../lib/eventFilterHref';

interface Props {
  selectedModality?: string;
  selectedCity?: string;
  selectedCountry?: string;
  selectedTimeframe?: 'past' | 'all';
  selectedSearch?: string;
}

const { selectedModality, selectedCity, selectedCountry, selectedTimeframe, selectedSearch } = Astro.props;

// Sin valor es "Proximos": es lo que se espera al entrar, y es el mismo
// criterio que ya usa modalidad (sin valor = Todos) de dejar el caso mas
// comun fuera de la URL. "Pasados" no queda escondido detras de un enlace de
// texto -antes solo se llegaba a el si ya estabas dentro del listado- sino
// como una pestaña mas, al mismo nivel que Proximos y Todos.
const opciones: { label: string; value?: 'past' | 'all' }[] = [
  { label: 'Próximos', value: undefined },
  { label: 'Todos', value: 'all' },
  { label: 'Pasados', value: 'past' },
];
---

<div class="inline-flex flex-wrap justify-center gap-1 rounded-full border border-linea bg-superficie p-1 backdrop-blur-xl">
  {opciones.map((opcion) => {
    const isActive = selectedTimeframe === opcion.value || (!selectedTimeframe && !opcion.value);

    return (
      <a
        href={buildFilterHref({
          modality: selectedModality,
          city: selectedCity,
          country: selectedCountry,
          timeframe: opcion.value,
          search: selectedSearch,
          list: true,
        })}
        class={cn(
          'rounded-full px-4 py-1.5 text-sm font-medium transition active:scale-[0.97]',
          isActive ? 'bg-acento text-acento-contraste shadow-sm' : 'text-suave hover:text-texto',
        )}
      >
        {opcion.label}
      </a>
    );
  })}
</div>
