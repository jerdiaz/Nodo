---
import { MapPin, Video } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import VerifiedBadge from '../ui/VerifiedBadge.astro';
import { formatEventDay, formatEventMonthShort, formatEventPrice, getEventLocationLabel } from '../../lib/format';
import { genColorForEvent } from '../../lib/genColor';
import type { EventModality, NodoEvent } from '../../types/event';

interface Props {
  event: NodoEvent;
}

const { event } = Astro.props;

const modalityLabel: Record<EventModality, string> = {
  presencial: 'Presencial',
  virtual: 'Virtual',
  hibrido: 'Híbrido',
};

const ModalityIcon = event.modality === 'virtual' ? Video : MapPin;

// En el listado manda la comunidad y no la persona: el evento se publica en su
// nombre. Quien lo creo se ve al entrar en la ficha.
const autor = event.community ?? event.organizer;
const locationLabel = getEventLocationLabel(event);
const firstTag = event.tags[0];
// El filo de color dice de que va el evento: sale de su primera etiqueta, no
// de su posicion, asi que no cambia al filtrar ni al reordenar.
const color = genColorForEvent(event);
---

{/*
  h-full para que la tarjeta ocupe toda su celda: las de una fila miden lo que
  la mas alta, y sin esto cada una se quedaba con el alto de su propio texto y
  la fila salia dentada.
*/}
<article
  data-gen={color}
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-linea bg-superficie shadow-[var(--c-sombra)] transition duration-200 active:scale-[0.98] hover:border-[var(--g)]"
>
  <div class="h-1 w-full bg-[var(--g)]" aria-hidden="true"></div>
  <a href={`/eventos/${event.slug}`} class="flex flex-1 flex-col">
    <div class="relative aspect-[16/9] w-full overflow-hidden">
      {event.bannerUrl ? (
        <img src={event.bannerSmallUrl ?? event.bannerUrl} alt="" class="h-full w-full object-cover" loading="lazy" />
      ) : (
        <div class="h-full w-full bg-gradient-to-br from-fondo-alt via-fondo-alt to-linea-suave" />
      )}

      {/*
        Solo los de pago llevan chapa. Una que dijera "Gratis" iria en casi
        todas las tarjetas de la cartelera, y lo que se repite en todas deja
        de leerse: el precio importa justo cuando lo hay.
      */}
      {event.price && (
        <span class="absolute right-3 top-3 rounded-full bg-superficie px-2.5 py-1 text-xs font-semibold text-texto shadow-[var(--c-sombra)]">
          {formatEventPrice(event)}
        </span>
      )}

      <div class="absolute left-3 top-3 flex flex-col items-center rounded-xl bg-[#111113]/75 px-2.5 py-1.5 leading-none backdrop-blur-xl">
        <span class="text-[10px] font-semibold uppercase tracking-wide text-white/80">
          {formatEventMonthShort(event.startDate, event.timezone)}
        </span>
        <span class="text-sm font-bold text-white">{formatEventDay(event.startDate, event.timezone)}</span>
      </div>
    </div>

    <div class="flex flex-1 flex-col p-5">
      {/*
        Dos lineas como maximo y como minimo: el recorte evita que un titulo
        largo estire la fila entera, y el alto reservado hace que una tarjeta
        de titulo corto siga midiendo lo mismo que las demas, tambien cuando
        estan en filas distintas.

        min-h-14 son las dos lineas de text-lg (28px cada una).
      */}
      <h3 class="line-clamp-2 min-h-14 text-lg font-semibold text-texto">
        {event.title}
      </h3>

      <div class="mt-3 flex items-center gap-1.5 text-sm text-suave">
        <ModalityIcon class="size-4 shrink-0" stroke-width={1.75} />
        <span class="line-clamp-1">{modalityLabel[event.modality]}{locationLabel && ` · ${locationLabel}`}</span>
      </div>

      {/* mt-auto empuja el pie al fondo cuando sobra sitio; el margen de
          dentro es el que garantiza el aire cuando no sobra. */}
      <div class="mt-auto">
      <div class="mt-4 flex items-center justify-between gap-3 border-t border-linea pt-3">
        <div class="flex min-w-0 items-center gap-2">
          {autor.avatarUrl ? (
            <img src={autor.avatarUrl} alt="" class="size-6 shrink-0 rounded-full object-cover" />
          ) : (
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-fondo-alt text-[10px] font-medium text-suave">
              {autor.name.charAt(0).toUpperCase()}
            </div>
          )}
          <span class="truncate text-xs text-suave">{autor.name}</span>

          {/*
            La palomita es siempre de quien publico el evento, tambien cuando
            en la tarjeta manda el nombre de la comunidad: lo que esta
            verificado es la cuenta, no el colectivo.
          */}
          {event.organizer.verification && (
            <VerifiedBadge type={event.organizer.verification} class="size-3.5 shrink-0" />
          )}
        </div>

        {firstTag && (
          <Badge variant="auto" seed={firstTag} class="shrink-0">
            {firstTag}
          </Badge>
        )}
      </div>
      </div>
    </div>
  </a>
</article>
