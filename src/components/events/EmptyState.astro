---
import { CalendarSearch } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
  // El CTA por defecto anima a publicar el primer evento, que es lo que toca
  // cuando el catalogo esta vacio. Quien no encuentra resultados con filtros
  // necesita lo contrario: limpiarlos. El enlace puede omitirse (href='').
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title = 'Aún no hay eventos publicados',
  description = 'Cuando la comunidad empiece a publicar, sus eventos aparecerán aquí.',
  ctaHref = '/eventos/nuevo',
  ctaLabel = 'Publicar el primer evento',
} = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-4 rounded-3xl border border-dashed border-linea px-6 py-24 text-center">
  <div class="flex size-12 items-center justify-center rounded-full bg-superficie text-suave">
    <CalendarSearch class="size-6" stroke-width={1.75} />
  </div>
  <div class="space-y-1">
    <p class="text-base font-medium text-texto">{title}</p>
    <p class="text-sm text-suave">{description}</p>
  </div>
  {ctaHref && (
    <a
      href={ctaHref}
      class="mt-2 inline-flex items-center rounded-full bg-acento px-4 py-2 text-sm font-medium text-acento-contraste transition active:scale-[0.97] hover:opacity-90"
    >
      {ctaLabel}
    </a>
  )}
</div>
