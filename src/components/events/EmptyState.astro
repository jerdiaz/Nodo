---
import { CalendarSearch } from 'lucide-astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aún no hay eventos publicados',
  description = 'Cuando la comunidad empiece a publicar, sus eventos aparecerán aquí.',
} = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-4 rounded-2xl border border-dashed border-neutral-800 px-6 py-24 text-center">
  <div class="flex size-12 items-center justify-center rounded-full bg-neutral-900 text-neutral-500">
    <CalendarSearch class="size-6" strokeWidth={1.75} />
  </div>
  <div class="space-y-1">
    <p class="text-base font-medium text-neutral-200">{title}</p>
    <p class="text-sm text-neutral-500">{description}</p>
  </div>
  <a
    href="/eventos/nuevo"
    class="mt-2 inline-flex items-center rounded-full bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-950 transition-colors hover:bg-emerald-400"
  >
    Publicar el primer evento
  </a>
</div>
