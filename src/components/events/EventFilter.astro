---
import { cn } from '../../lib/utils';

interface Props {
  cities: string[];
  selectedModality?: string;
  selectedCity?: string;
}

const { cities, selectedModality, selectedCity } = Astro.props;

const modalities: { label: string; value?: string }[] = [
  { label: 'Todos', value: undefined },
  { label: 'Presenciales', value: 'presencial' },
  { label: 'Virtuales', value: 'virtual' },
];

function buildHref(modality?: string, city?: string): string {
  const params = new URLSearchParams();
  if (modality) params.set('modalidad', modality);
  if (city) params.set('ciudad', city);
  const query = params.toString();
  return query ? `/?${query}` : '/';
}

const showCityFilter = !selectedModality || selectedModality === 'presencial';
---

<div class="flex flex-col items-start gap-3 sm:items-end">
  <div class="flex flex-wrap gap-2">
    {modalities.map((modality) => {
      const isActive = selectedModality === modality.value || (!selectedModality && !modality.value);
      const nextCity = modality.value === 'virtual' ? undefined : selectedCity;

      return (
        <a
          href={buildHref(modality.value, nextCity)}
          class={cn(
            'rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
            isActive ? 'bg-neutral-100 text-neutral-950' : 'bg-neutral-900 text-neutral-400 hover:text-neutral-100',
          )}
        >
          {modality.label}
        </a>
      );
    })}
  </div>

  {showCityFilter && cities.length > 0 && (
    <div class="flex flex-wrap justify-end gap-2">
      <a
        href={buildHref(selectedModality, undefined)}
        class={cn(
          'rounded-full px-3 py-1 text-xs font-medium transition-colors',
          !selectedCity ? 'bg-neutral-800 text-neutral-100' : 'text-neutral-500 hover:text-neutral-200',
        )}
      >
        Todas las ciudades
      </a>
      {cities.map((city) => (
        <a
          href={buildHref(selectedModality, city)}
          class={cn(
            'rounded-full px-3 py-1 text-xs font-medium transition-colors',
            selectedCity === city ? 'bg-neutral-800 text-neutral-100' : 'text-neutral-500 hover:text-neutral-200',
          )}
        >
          {city}
        </a>
      ))}
    </div>
  )}
</div>
