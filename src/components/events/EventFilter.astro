---
import { cn } from '../../lib/utils';
import { buildFilterHref } from '../../lib/eventFilterHref';

interface Props {
  selectedModality?: string;
  selectedCity?: string;
  selectedTimeframe?: 'past';
  selectedSearch?: string;
}

const { selectedModality, selectedCity, selectedTimeframe, selectedSearch } = Astro.props;

const modalities: { label: string; value?: string }[] = [
  { label: 'Todos', value: undefined },
  { label: 'Presenciales', value: 'presencial' },
  { label: 'Virtuales', value: 'virtual' },
];
---

<div class="flex flex-wrap justify-center gap-2">
  {modalities.map((modality) => {
    const isActive = selectedModality === modality.value || (!selectedModality && !modality.value);
    const nextCity = modality.value === 'virtual' ? undefined : selectedCity;

    return (
      <a
        href={buildFilterHref({
          modality: modality.value,
          city: nextCity,
          timeframe: selectedTimeframe,
          search: selectedSearch,
        })}
        class={cn(
          'rounded-full border px-4 py-1.5 text-sm font-medium transition-colors',
          isActive
            ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400'
            : 'border-neutral-800 bg-neutral-900 text-neutral-400 hover:text-neutral-100',
        )}
      >
        {modality.label}
      </a>
    );
  })}
</div>
