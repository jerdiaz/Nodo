---
import { Download, Link, MessageCircle, Share2 } from '@lucide/astro';
import Button from '../ui/Button.astro';
import { formatEventDateLong } from '../../lib/format';
import type { NodoEvent } from '../../types/event';

interface Props {
  event: NodoEvent;
  url: string;
  icsUrl: string;
}

const { event, url, icsUrl } = Astro.props;

const dateLabel = formatEventDateLong(event.startDate, event.timezone);
const shareText = `${event.title} — ${dateLabel}\n${url}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<div data-share-title={event.title} data-share-text={shareText} data-share-url={url}>
  <div class="grid grid-cols-2 gap-3">
    <Button variant="secondary" href={icsUrl} download={`${event.slug}.ics`}>
      <Download class="size-4" stroke-width={2} />
      Descargar .ics
    </Button>
    <Button variant="secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      <MessageCircle class="size-4" stroke-width={2} />
      WhatsApp
    </Button>
  </div>

  <div class="mt-4 flex items-center justify-center gap-5">
    <button
      id="native-share-button"
      type="button"
      class="hidden items-center gap-1.5 text-xs text-suave transition active:scale-[0.95] hover:text-texto"
    >
      <Share2 class="size-3.5" stroke-width={2} />
      Compartir
    </button>
    <button
      id="copy-link-button"
      type="button"
      class="inline-flex items-center gap-1.5 text-xs text-suave transition active:scale-[0.95] hover:text-texto"
    >
      <Link class="size-3.5" stroke-width={2} />
      <span id="copy-link-label">Copiar enlace</span>
    </button>
  </div>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-share-url]');
  const nativeShareButton = document.getElementById('native-share-button') as HTMLButtonElement | null;
  const copyButton = document.getElementById('copy-link-button') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-link-label') as HTMLSpanElement | null;

  if (container && nativeShareButton && navigator.share) {
    nativeShareButton.classList.remove('hidden');
    nativeShareButton.classList.add('inline-flex');

    nativeShareButton.addEventListener('click', async () => {
      try {
        await navigator.share({
          title: container.dataset.shareTitle,
          text: container.dataset.shareText,
          url: container.dataset.shareUrl,
        });
      } catch {
        // El usuario cerró el diálogo nativo sin compartir; no es un error real.
      }
    });
  }

  copyButton?.addEventListener('click', async () => {
    const url = container?.dataset.shareUrl;
    if (!url || !copyLabel) {
      return;
    }

    const original = copyLabel.textContent;

    try {
      await navigator.clipboard.writeText(url);
      copyLabel.textContent = '¡Copiado!';
    } catch {
      copyLabel.textContent = 'No se pudo copiar';
    }

    setTimeout(() => {
      copyLabel.textContent = original;
    }, 2000);
  });
</script>
