---
import { cn } from '../../lib/utils';

interface Props {
  blur?: boolean;
  class?: string;
}

const { blur = false, class: className } = Astro.props;
---

<div
  class={cn(
    'rounded-3xl border border-linea bg-superficie shadow-[var(--c-sombra)]',
    blur && 'backdrop-blur-xl',
    className,
  )}
>
  <slot />
</div>
