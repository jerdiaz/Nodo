---
import { cn } from '../../lib/utils';

interface Props {
  blur?: boolean;
  class?: string;
}

const { blur = false, class: className } = Astro.props;
---

<div
  class={cn(
    'rounded-3xl border border-white/[0.08] bg-neutral-900/60 shadow-[0_1px_1px_rgba(0,0,0,0.3),0_12px_28px_-8px_rgba(0,0,0,0.5)]',
    blur && 'backdrop-blur-xl',
    className,
  )}
>
  <slot />
</div>
