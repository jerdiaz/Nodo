---
import { VERIFICATION_LABEL, type VerificationType } from '../../types/profile';

interface Props {
  type: VerificationType;
  class?: string;
}

const { type, class: className } = Astro.props;
const label = VERIFICATION_LABEL[type];
---

{/* El titulo va en <title> del propio svg y no en un atributo title, para que
    lo anuncien los lectores de pantalla ademas de verse al pasar el raton. */}
<svg
  viewBox="0 0 24 24"
  role="img"
  aria-label={label}
  class:list={['inline-block shrink-0 align-middle text-sky-500', className]}
>
  <title>{label}</title>
  <path
    fill="currentColor"
    d="M12 1.5a3.2 3.2 0 0 1 2.36 1.04l.9.98 1.31-.2a3.2 3.2 0 0 1 3.6 2.6l.23 1.3 1.16.63a3.2 3.2 0 0 1 1.24 4.33l-.63 1.16.63 1.16a3.2 3.2 0 0 1-1.24 4.33l-1.16.63-.23 1.3a3.2 3.2 0 0 1-3.6 2.6l-1.31-.2-.9.98a3.2 3.2 0 0 1-4.72 0l-.9-.98-1.31.2a3.2 3.2 0 0 1-3.6-2.6l-.23-1.3-1.16-.63a3.2 3.2 0 0 1-1.24-4.33L1.82 12l-.63-1.16a3.2 3.2 0 0 1 1.24-4.33l1.16-.63.23-1.3a3.2 3.2 0 0 1 3.6-2.6l1.31.2.9-.98A3.2 3.2 0 0 1 12 1.5Z"
  />
  <path
    fill="none"
    stroke="#fff"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    d="m8 12.2 2.7 2.7L16.4 9.3"
  />
</svg>
