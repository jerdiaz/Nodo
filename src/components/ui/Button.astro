---
import { cn } from '../../lib/utils';

interface Props {
  variant?: 'primary' | 'secondary' | 'danger';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
  download?: string | boolean;
  'aria-label'?: string;
  [key: `data-${string}`]: string | undefined;
}

const { variant = 'primary', href, type = 'button', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-acento text-acento-contraste hover:opacity-90',
  secondary:
    'border border-linea bg-superficie text-texto hover:border-acento hover:bg-superficie',
  danger: 'text-acento-texto hover:text-acento',
};

const base =
  'inline-flex items-center justify-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-medium transition active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-60 disabled:active:scale-100';
const classes = cn(base, variants[variant], className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
