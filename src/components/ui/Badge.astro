---
import { cn } from '../../lib/utils';

interface Props {
  variant?: 'emerald' | 'neutral';
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;

const variants = {
  emerald: 'border border-acento bg-acento-suave text-acento-texto',
  neutral: 'border border-linea bg-fondo-alt text-texto',
};
---

<span class={cn('inline-flex items-center rounded-full px-3 py-1 text-xs font-medium', variants[variant], className)}>
  <slot />
</span>
