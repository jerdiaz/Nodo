rules_version = '2';

// Las imagenes ya no se suben desde el navegador: pasan por POST /api/imagenes,
// que las modera con Vision, las recorta y las guarda con el Admin SDK. El
// Admin SDK no pasa por estas reglas, asi que ningun cliente necesita permiso
// de escritura y se deniega por completo.
//
// La lectura publica tampoco depende de esto: las URLs llevan el token de
// descarga que genera la subida (firebaseStorageDownloadTokens), que es el
// mismo mecanismo de getDownloadURL(). Las reglas de lectura se dejan abiertas
// solo para las rutas historicas, subidas antes de este cambio.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /event-banners/{uid}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Cierre explicito. Storage ya deniega por defecto lo que no coincide con
    // ninguna regla; esto lo deja escrito para que se lea de un vistazo.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
