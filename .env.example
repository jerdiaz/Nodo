# Firebase client SDK (expuestas al navegador — deben llevar el prefijo PUBLIC_)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Google Identity Services (One Tap). Client ID OAuth "Web application" que
# Firebase crea automaticamente al habilitar el proveedor Google en
# Authentication > Sign-in method. Se ve en Google Cloud Console > APIs y
# servicios > Credenciales, como "Web client (auto created by Google Service)".
PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Admin SDK (solo servidor — nunca exponer al cliente)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Conserva las comillas y los "\n" literales tal como los entrega la consola de Firebase.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloud Vision para moderar imagenes (opcional).
# Si se dejan vacias, la moderacion usa la cuenta de servicio de Firebase de
# arriba y la API debe estar habilitada en ese mismo proyecto. Rellenarlas
# permite apuntar a otro proyecto que ya la tenga activa: el consumo se
# factura a ESE proyecto, no al de Nodo.
VISION_PROJECT_ID=
VISION_CLIENT_EMAIL=
VISION_PRIVATE_KEY=

# Instagram: publicaciones de @redglobalcol en la home (opcional).
# Token de larga duracion de la Instagram Graph API (dura 60 dias, hay que
# renovarlo), id de la cuenta, y el secreto que autoriza a disparar
# POST /api/instagram/sync. Sin las tres, la seccion simplemente no aparece.
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
SYNC_SECRET=
